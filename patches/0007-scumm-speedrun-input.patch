 }
 
+
+#pragma mark - E013: the state digest
+
+// E013 (patch 0007; experiments/E013-robust/plan.md, A.3): a 64-bit hash of the engine's state, its own definition of
+// it. What its save writes (ScummEngine::saveLoadWithSerializer, through speedrunSaveStream() in saveload.cpp, with no
+// header, thumbnail or play time), then what a save leaves out and the next frames read: the RNG state (xorshift32),
+// the input registers (the mouse, the buttons, this frame's key and click code, the raw schedule's mouse, the
+// bridge's automatic skips), and the sound state the scripts read (the CD timer and the CD's play state, the speech
+// timer, the sounds running and queued, the audio pump's phase). Counters of elapsed time that no script reads
+// (frames, ticks, quarter-frames, samples pumped) are left out, so equal states at different frames have equal
+// digests. Two equal digests are taken as two equal futures (A0); gate B4 tests that. Reads only: the save stream's
+// serializer only reads the engine when saving.
+
+namespace {
+
+// The digest's sink: a write stream that keeps nothing but an FNV-1a 64 of every byte written, and its count.
+class DigestStream : public Common::SeekableWriteStream {
+public:
+	uint64 h = 14695981039346656037ULL;
+	uint32 n = 0;
+	uint32 write(const void *dataPtr, uint32 dataSize) override {
+		fnv64(h, (const byte *)dataPtr, dataSize);
+		n += dataSize;
+		return dataSize;
+	}
+	int64 pos() const override { return n; }
+	int64 size() const override { return n; }
+	bool seek(int64, int) override { return false; }
+};
+
+void fnvInt(uint64 &h, int64 v) {
+	byte b[8];
+	WRITE_LE_UINT64(b, (uint64)v);
+	fnv64(h, b, 8);
+}
+
+} // End of anonymous namespace
+
+uint64 SpeedrunBridge::stateDigest(uint32 &bytes) {
+	ScummEngine &e = *_vm;
+	DigestStream ds;
+	e.speedrunSaveStream(&ds);
+	uint64 h = ds.h;
+	bytes = ds.n;
+	fnvInt(h, (int64)(uint64)e._rnd.getSeed());
+	const int regs[] = {e._mouse.x, e._mouse.y, e._virtualMouse.x, e._virtualMouse.y, (int)e._leftBtnPressed,
+	                    (int)e._rightBtnPressed, (int)e._mouseAndKeyboardStat, (int)e._keyPressed.keycode,
+	                    (int)e._keyPressed.ascii, (int)e._keyPressed.flags, (int)_rawMouseX, (int)_rawMouseY,
+	                    (int)_skipText, (int)_skipCutscenes, (int)_skipSpare.size()};
+	for (int v : regs)
+		fnvInt(h, v);
+	for (uint i = 0; i < _skipSpare.size(); i++)
+		fnvInt(h, _skipSpare[i]);
+	const Sound *snd = e._sound;
+	if (snd) {
+		if (snd->_soundCD) {
+			const SoundCD *cd = snd->_soundCD;
+			fnvInt(h, (int64)(uint64)cd->_cdMusicTimer);
+			fnvInt(h, (int64)(uint64)cd->_cdMusicTimerMod);
+			fnvInt(h, (int64)cd->_currentCDSound);
+			const AudioCDManager::Status st = g_system->getAudioCDManager()->getStatus();
+			const int cds[] = {(int)st.playing, st.track, st.start, st.duration, st.numLoops, st.volume, st.balance};
+			for (int v : cds)
+				fnvInt(h, v);
+		}
+		fnvInt(h, (int64)(uint64)snd->_speechTimerMod);
+		for (int s = 1; s < e._numSounds; s++) {
+			const int status = snd->isSoundRunning(s);
+			if (status) {
+				fnvInt(h, s);
+				fnvInt(h, status);
+			}
+		}
+		for (int i = 0; i < snd->_soundQueuePos && i < (int)ARRAYSIZE(snd->_soundQueue); i++) {
+			fnvInt(h, snd->_soundQueue[i].sound);
+			fnvInt(h, snd->_soundQueue[i].offset);
+		}
+		for (int i = 0; i < snd->_midiQueuePos && i < (int)ARRAYSIZE(snd->_midiQueue); i++)
+			fnvInt(h, snd->_midiQueue[i]);
+	}
+	fnvInt(h, (int64)_audioPending);
+	uint64 owed;
+	memcpy(&owed, &_audioOwed, sizeof(owed));
+	fnvInt(h, (int64)owed);
+	return h;
+}
+
+Common::String SpeedrunBridge::digestJson() {
+	uint32 bytes = 0;
+	const uint64 d = stateDigest(bytes);
+	JsonObject o;
+	o.add("frame", _frames).add("digest", Common::String::format("%016llx", (unsigned long long)d)).add("bytes", (uint)bytes);
+	return o.str();
+}
+
 } // End of namespace Scumm
