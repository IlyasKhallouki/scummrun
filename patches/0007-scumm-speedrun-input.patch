+
+#pragma mark - E013: the input log
+
+// E013 (patch 0007; experiments/E013-robust/plan.md, A.2). For each frame in which the schedule injected a key or a
+// click (SPEEDRUN_INPUT=1), its path through checkExecVerbs() and the handler:
+//   - dropped: "gate" (_userPut <= 0, checkExecVerbs()'s first test), "cleared" (the frame's key or click code was 0
+//     when checkExecVerbs() ran: processInput() used the key itself, e.g. Esc or '.', or a script cleared it), "zone"
+//     (a click on no virtual screen), "handler" (VAR_VERB_SCRIPT is 0: runInputScript() starts nothing);
+//   - handled: the area, value and mode runInputScript() gives the handler, the verb slot whose key matched or that
+//     is under the click; then the handler's run inside that call (until its slot dies or breaks: the rest of the
+//     frame's script work is the other slots'): what it wrote (variables and bits, owners, states, classes, scripts
+//     started, sentences queued, walks, prints; the verb slots, the camera, the cursor and the gate, by a snapshot
+//     before and after) and what it read (variables and bits after v5's indirection, owners, states, classes,
+//     actors, the object at a point, random draws, script queries), and its opcodes. "ignored" when it changed
+//     nothing outside its own locals (onInputScriptEnd()), else "taken".
+// Records wait in the bridge until the InputLog command takes them (a fork's child inherits the ones not taken).
+
+namespace {
+const uint kMaxRecs = 4096;   // records kept between two InputLog commands
+const uint kMaxTouches = 4096; // reads, and writes, per record
+const uint kMaxOps = 4096;    // opcodes per record
+} // End of anonymous namespace
+
+void SpeedrunBridge::addTouch(Common::Array<Touch> &to, uint8 kind, int a, int b, int old, int now) {
+	if (to.size() >= kMaxTouches) {
+		_rec.touchesDropped++;
+		return;
+	}
+	Touch t;
+	t.kind = kind;
+	t.a = a;
+	t.b = b;
+	t.old = old;
+	t.now = now;
+	to.push_back(t);
+}
+
+void SpeedrunBridge::closeRecord(uint8 verdict, const char *why) {
+	_rec.verdict = verdict;
+	_rec.why = why;
+	if (_inputRecs.size() < kMaxRecs)
+		_inputRecs.push_back(_rec);
+	else
+		_inputRecsDropped++;
+	_rec = InputRec();
+	_recOpen = false;
+}
+
+void SpeedrunBridge::snapRun(RunSnap &s) const {
+	const ScummEngine &e = *_vm;
+	s.verbs.resize(8 * e._numVerbs);
+	for (int i = 0; i < e._numVerbs; i++) {
+		const VerbSlot &v = e._verbs[i];
+		int32 *p = &s.verbs[8 * i];
+		p[0] = v.verbid, p[1] = v.curmode, p[2] = v.saveid, p[3] = v.key;
+		p[4] = v.curRect.left, p[5] = v.curRect.top, p[6] = v.curRect.right, p[7] = v.curRect.bottom;
+	}
+	s.camX = e.camera._cur.x, s.camY = e.camera._cur.y, s.camDestX = e.camera._dest.x, s.camDestY = e.camera._dest.y;
+	s.camFollows = e.camera._follows, s.camMode = e.camera._mode;
+	s.cursor = e._cursor.state;
+	s.userPut = e._userPut;
+}
+
+void SpeedrunBridge::onExecVerbs() {
+	// checkExecVerbs()'s own tests, in its order, read before it acts on them (verbs.cpp:586-692). What each test read
+	// goes in the record's reads: the gate (_userPut), then the zone or the verb slot the input meets.
+	if (!_recOpen)
+		return;
+	ScummEngine &e = *_vm;
+	_rec.stat = e._mouseAndKeyboardStat;
+	addTouch(_rec.reads, kTouchUserPut, 0, 0, e._userPut, e._userPut);
+	if (e._userPut <= 0) {
+		closeRecord(1, "gate");
+		return;
+	}
+	if (e._mouseAndKeyboardStat == 0) {
+		closeRecord(1, "cleared");
+		return;
+	}
+	if (e._mouseAndKeyboardStat < MBS_MAX_KEY) {
+		for (int i = 1; i < e._numVerbs; i++) {
+			if (verbVisible(i) && e._mouseAndKeyboardStat == e._verbs[i].key) {
+				_rec.slot = i;
+				_rec.keyMatch = true;
+				break;
+			}
+		}
+	} else if (e._mouseAndKeyboardStat & MBS_MOUSE_MASK) {
+		VirtScreen *zone = e.findVirtScreen(e._mouse.y);
+		if (!zone) {
+			closeRecord(1, "zone");
+			return;
+		}
+		_rec.zone = zone->number;
+		_rec.slot = e.findVerbAtPos(e._mouse.x, e._mouse.y);
+	}
+	// runInputScript() decides the rest (onInputScriptBegin())
+}
+
+void SpeedrunBridge::onInputScriptBegin(int area, int val, int mode) {
+	if (!_recOpen)
+		return;
+	const ScummEngine &e = *_vm;
+	const int verbScript = e._scummVars[e.VAR_VERB_SCRIPT];
+	_rec.area = area;
+	_rec.value = val;
+	_rec.mode = mode;
+	_rec.handler = verbScript;
+	// runInputScript()'s own read: the script VAR_VERB_SCRIPT names (none: nothing starts)
+	addTouch(_rec.reads, kTouchVar, (int)e.VAR_VERB_SCRIPT, 0, verbScript, verbScript);
+	if (!verbScript) {
+		closeRecord(1, "handler");
+		return;
+	}
+	snapRun(_runSnap);
+	_logRun = true;
+}
+
+void SpeedrunBridge::onInputScriptEnd() {
+	if (!_logRun)
+		return;
+	_logRun = false;
+	const ScummEngine &e = *_vm;
+	RunSnap now;
+	snapRun(now);
+	for (int i = 0; i < e._numVerbs && (uint)(8 * i + 7) < _runSnap.verbs.size(); i++) {
+		const int32 *a = &_runSnap.verbs[8 * i], *b = &now.verbs[8 * i];
+		bool same = true;
+		for (int k = 0; k < 8; k++)
+			same = same && a[k] == b[k];
+		if (!same)
+			addTouch(_rec.writes, kTouchVerb, i, b[0], a[1], b[1]); // slot, its verb id, its mode before and after
+	}
+	const RunSnap &o = _runSnap;
+	if (o.camX != now.camX || o.camY != now.camY || o.camDestX != now.camDestX || o.camDestY != now.camDestY ||
+	    o.camFollows != now.camFollows || o.camMode != now.camMode)
+		addTouch(_rec.writes, kTouchCamera, now.camDestX, now.camDestY, o.camX, now.camX);
+	if (o.cursor != now.cursor)
+		addTouch(_rec.writes, kTouchCursor, 0, 0, o.cursor, now.cursor);
+	if (o.userPut != now.userPut)
+		addTouch(_rec.writes, kTouchUserPut, 0, 0, o.userPut, now.userPut);
+	// The verdict: "taken" when the run left anything changed outside its own locals: a variable, bit or object
+	// table written with another value than it held, a script started that still runs (the handler itself when it
+	// broke rather than ended), a sentence queued, a walk, a print, a verb slot, the camera, the cursor or the gate
+	// changed, or a random draw (the RNG moved). Else "ignored": the run wrote nothing, or only the values things
+	// already held, and every slot it started has died.
+	bool changed = false;
+	for (const Touch &t : _rec.writes) {
+		switch (t.kind) {
+		case kTouchVar:
+		case kTouchBit:
+		case kTouchOwner:
+		case kTouchState:
+		case kTouchClass:
+			changed = changed || t.old != t.now;
+			break;
+		case kTouchStarted:
+			changed = changed || (t.now >= 0 && t.now < NUM_SCRIPT_SLOT && e.vm.slot[t.now].status != ssDead &&
+			                      (int)e.vm.slot[t.now].number == t.a && (int)e.vm.slot[t.now].where == t.b);
+			break;
+		default:
+			changed = true;
+			break;
+		}
+	}
+	for (const Touch &t : _rec.reads)
+		changed = changed || t.kind == kTouchRandom;
+	closeRecord(changed ? 3 : 2, nullptr);
+}
+
+void SpeedrunBridge::onScriptStart(int slot) {
+	if (!_logRun || slot < 0 || slot >= NUM_SCRIPT_SLOT)
+		return;
+	const ScriptSlot &ss = _vm->vm.slot[slot];
+	addTouch(_rec.writes, kTouchStarted, ss.number, ss.where, 0, slot);
+}
+
+void SpeedrunBridge::onSentence(int verb, int objectA, int objectB) {
+	if (_logRun)
+		addTouch(_rec.writes, kTouchSentence, verb, objectA, objectB, objectB);
+}
+
+void SpeedrunBridge::onWalk(int actor, int x, int y) {
+	if (_logRun)
+		addTouch(_rec.writes, kTouchWalk, actor, 0, x, y);
+}
+
+void SpeedrunBridge::onTalk() {
+	if (_logRun)
+		addTouch(_rec.writes, kTouchPrint, (int)_vm->_actorToPrintStrFor, 0, 0, 0);
+}
+
+void SpeedrunBridge::onObjectWrite(int kind, int obj, int a, int oldValue, int newValue) {
+	if (_logRun)
+		addTouch(_rec.writes, (uint8)kind, obj, a, oldValue, newValue);
+}
+
+void SpeedrunBridge::onReadResolved(uint var, int value) {
+	if (!_logRun)
+		return;
+	if (var & 0x8000)
+		addTouch(_rec.reads, kTouchBit, (int)(var & 0x7FFF), 0, value, value);
+	else
+		addTouch(_rec.reads, kTouchVar, (int)var, 0, value, value);
+}
+
+void SpeedrunBridge::onQuery(int kind, int a, int b, int value) {
+	if (_logRun)
+		addTouch(_rec.reads, (uint8)kind, a, b, value, value);
+}
+
+void SpeedrunBridge::onLogOpcode(byte opcode) {
+	if (!_logRun)
+		return;
+	if (_rec.ops.size() >= kMaxOps) {
+		_rec.opsDropped++;
+		return;
+	}
+	const ScummEngine &e = *_vm;
+	LogOp op;
+	op.slot = e._currentScript;
+	op.number = op.where = -1;
+	op.code = -1;
+	if (op.slot != 0xFF && op.slot < NUM_SCRIPT_SLOT) {
+		const ScriptSlot &ss = e.vm.slot[op.slot];
+		op.number = ss.number;
+		op.where = ss.where;
+		// fetchScriptByte() has moved past the opcode (as onOpcode())
+		const int64 start = scriptStart(op.slot);
+		const int64 offs = (int64)(e._scriptPointer - e._scriptOrgPointer) - 1;
+		op.code = start >= 0 ? offs - start : -1;
+	}
+	op.opcode = opcode;
+	_rec.ops.push_back(op);
+}
+
+Common::String SpeedrunBridge::inputLogJson() {
+	// The InputLog reply's JSON (fmi-core InputLog); takes the records, as InputLog does.
+	static const char *const kVerdict[4] = {"open", "dropped", "ignored", "taken"};
+	static const char *const kKinds[] = {"var", "bit", "owner", "state", "class", "actor", "object_at", "random",
+	                                     "script_running", "started", "sentence", "walk", "print", "verb", "camera",
+	                                     "cursor", "userput", "actor_at"};
+	JsonArray recs;
+	for (uint i = 0; i < _inputRecs.size(); i++) {
+		const InputRec &r = _inputRecs[i];
+		JsonArray inputs;
+		for (const SpeedrunInput &in : r.inputs) {
+			if (in.kind == SpeedrunInput::kKey)
+				inputs.add(JsonObject().add("key", in.keyName.c_str()));
+			else
+				inputs.add(JsonObject().addRaw(in.kind == SpeedrunInput::kClick ? "click" : "rclick",
+				                               JsonArray().add((int)in.x).add((int)in.y).str()));
+		}
+		JsonObject o;
+		o.add("frame", r.frame).addRaw("inputs", inputs.str()).add("stat", r.stat).add("verdict", kVerdict[r.verdict])
+		 .add("why", r.why).add("area", r.area).add("value", r.value).add("mode", r.mode).add("slot", r.slot)
+		 .add("zone", r.zone).add("key_match", r.keyMatch).add("handler", r.handler);
+		for (int w = 0; w < 2; w++) {
+			const Common::Array<Touch> &ts = w ? r.reads : r.writes;
+			JsonArray arr;
+			for (const Touch &t : ts)
+				arr.addRaw(JsonArray().addRaw(jsonString(kKinds[t.kind])).add(t.a).add(t.b).add(t.old).add(t.now).str());
+			o.addRaw(w ? "reads" : "writes", arr.str());
+		}
+		JsonArray ops;
+		for (const LogOp &op : r.ops)
+			ops.addRaw(JsonArray().add(op.slot).add(op.number).add(op.where).add((int)op.code).add((int)op.opcode).str());
+		o.addRaw("ops", ops.str()).add("ops_dropped", (uint)r.opsDropped).add("touches_dropped", (uint)r.touchesDropped);
+		recs.add(o);
 	}
+	JsonObject out;
+	out.addRaw("records", recs.str()).add("dropped", (uint)_inputRecsDropped).add("frame", _frames);
+	_inputRecs.clear();
+	_inputRecsDropped = 0;
+	return out.str();
 }
 
 } // End of namespace Scumm
