+	if (_logRun && !(var & 0x4000)) {
+		const ScummEngine &e = *_vm;
+		if (!(var & 0xF000) && (int)var < e._numVariables) {
+			addTouch(_rec.writes, kTouchVar, (int)var, 0, e._scummVars[var], value);
+		} else if (var & 0x8000) {
+			const uint bit = var & 0x7FFF;
+			if ((int)bit < e._numBitVariables)
+				addTouch(_rec.writes, kTouchBit, (int)bit, 0, (e._bitVars[bit >> 3] & (1 << (bit & 7))) ? 1 : 0,
+				         value ? 1 : 0);
+		}
+	}
 	if (!_explainNow || _runStack.empty())
 		return;
 	if (_wireBin)
