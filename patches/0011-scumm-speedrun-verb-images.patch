+		{"SPEEDRUN_VERB_IMAGES", &SpeedrunBridge::_verbImages},
 		// E013 (patch 0007): the input log (observation only)
 		{"SPEEDRUN_INPUT", &SpeedrunBridge::_inputLog},
 	};
