+void SpeedrunBridge::wireObsReq(SpeedrunReader &in) {
+	// fmi-core ObsReq (objects, names, exact), kept for the dump a StepObs or RunObs stop replies with
+	_wireObsObjects.clear();
+	_wireObsLite = false;
+	if (in.u8()) {
+		_wireObsLite = true;
+		const uint32 n = in.count(4);
+		for (uint32 i = 0; i < n && in.ok(); i++)
+			_wireObsObjects.push_back((int)in.u32());
+	}
+	_wireObsNames = in.b();
+	_wireObsExact = in.b();
+}
+
+void SpeedrunBridge::wireAt(SpeedrunBytes &o, int x, int y) {
+	// fmi-core At, as the JSON "at" reply: the virtual screen of y, and on the main one the object and actor there
+	VirtScreen *vs = _vm->findVirtScreen(y);
+	o.i32(x);
+	o.i32(y);
+	o.i32(vs ? (int)vs->number : -1);
+	if (vs && vs->number == kMainVirtScreen) {
+		const int virtX = x + vs->xstart, virtY = y - vs->topline;
+		o.u8(1);
+		o.i32(virtX);
+		o.i32(virtY);
+		o.i32(_vm->findObject(virtX, virtY));
+		o.i32(_vm->getActorFromPos(virtX, virtY));
+	} else {
+		o.u8(0);
+	}
+	o.i32(_vm->findVerbAtPos(x, y));
+}
