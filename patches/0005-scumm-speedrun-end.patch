+// E012 (patch 0005): the "boxes" reply. The current room's walk boxes, 0..getNumBoxes()-1, each as boxes.cpp's
+// getBoxCoordinates() and getBoxFlags() give it (both read the room's box data, a copy of its BOXD block that
+// matrixOps may have changed since). Reads only.
+Common::String SpeedrunBridge::boxesJson() const {
+	ScummEngine &e = *_vm;
+	const int n = (int)e.getNumBoxes();
+	JsonArray boxes;
+	for (int i = 0; i < n; i++) {
+		const BoxCoords c = e.getBoxCoordinates(i);
+		JsonObject b;
+		b.addRaw("ul", JsonArray().add((int)c.ul.x).add((int)c.ul.y).str())
+		 .addRaw("ur", JsonArray().add((int)c.ur.x).add((int)c.ur.y).str())
+		 .addRaw("lr", JsonArray().add((int)c.lr.x).add((int)c.lr.y).str())
+		 .addRaw("ll", JsonArray().add((int)c.ll.x).add((int)c.ll.y).str())
+		 .add("flags", (int)e.getBoxFlags(i));
+		boxes.add(b);
+	}
+	JsonObject o;
+	o.add("room", (int)e._currentRoom).addRaw("boxes", boxes.str());
+	return o.str();
+}
+
 } // End of namespace Scumm
