+// Text and cutscene skips (docs/plan.md Phase 8: SPEEDRUN_SKIP_TEXT,
+// SPEEDRUN_SKIP_CUTSCENES, C4 no_skip, C5 skip records;
+// docs/research/skips-engine.md sections 2-4 and 7).
+//
+// A skip is a key press through the engine's own key path: onFrameBegin()
+// writes _keyPressed after neutraliseInput() has erased any human key, and
+// processInput() reads it later in the same frame (input.cpp, '.' and Esc in
+// processKeyboard()). Keys are pressed only after the segment start, so the
+// logo speed glitch (an Esc at the Lucasfilm logo) can never happen, and only
+// on a frame where the press has an effect.
+
+#include "common/keyboard.h"
+
+#include "scumm/scumm.h"
+#include "scumm/script.h"
+#include "scumm/speedrun/speedrun_bridge.h"
+
+namespace Scumm {
+
+namespace {
+
+// beginOverride() records the PC of the goto that follows it, and
+// abortCutscene() resumes the script there (script.cpp). In v5 that goto is
+// o5_jumpRelative (script_v5.cpp opcode table).
+const byte kOpJumpRelative = 0x18;
+
+// _stepSkips indices, and the kinds of C5 skip records.
+const int kSkipText = 0, kSkipCutscene = 1;
+
+// scummLoop() clamps delta to 15 before it lowers _talkDelay (scumm.cpp).
+const int kMaxDelta = 15;
+
+} // End of anonymous namespace
+
+void SpeedrunBridge::trackOverride() {
+	// The override abortCutscene() would jump to, and whose it is.
+	// beginOverride() does not count as a cutscene for stopScript() and
+	// stopObjectCode(), and nothing that kills a script clears the pointer:
+	// an override at level 0 whose script ends without endOverride() leaves a
+	// stale pointer, and Esc would then rewind whatever script now has that
+	// slot. So remember the owner when the pointer appears, and latch it
+	// stale if that script dies or the slot changes hands.
+	const ScummEngine &e = *_vm;
+	const int level = e.vm.cutSceneStackPointer;
+	const uint32 ptr = level < kMaxCutsceneNum ? e.vm.cutScenePtr[level] : 0;
+	if (!ptr) {
+		_override = OverrideSeen();
+		return;
+	}
+	const int slot = e.vm.cutSceneScript[level];
+	const ScriptSlot *ss = slot < NUM_SCRIPT_SLOT ? &e.vm.slot[slot] : nullptr;
+	const bool roomCode = ss && (ss->where == WIO_LOCAL || ss->where == WIO_ROOM);
+	const int room = roomCode ? (int)e._roomResource : -1;
+	if (level != _override.level || ptr != _override.ptr) {
+		_override = OverrideSeen();
+		_override.level = level;
+		_override.ptr = ptr;
+		_override.slot = slot;
+		_override.stale = !ss || ss->status == ssDead;
+		if (ss) {
+			_override.number = ss->number;
+			_override.where = ss->where;
+			_override.room = room;
+		}
+		return;
+	}
+	if (!ss || ss->status == ssDead || ss->number != _override.number || ss->where != _override.where ||
+	    room != _override.room)
+		_override.stale = true;
+}
+
+bool SpeedrunBridge::cutsceneSkipEffective() const {
+	// Esc has an effect exactly when abortCutscene() finds a live override at
+	// the current cutscene level (script.cpp). Level 0 counts: five route
+	// overrides have no enclosing cutscene() (docs/part1/skips.md section 0).
+	const ScummEngine &e = *_vm;
+	// Disabled Esc would reach the input script as a plain key (input.cpp).
+	if (e.VAR_CUTSCENEEXIT_KEY == 0xFF || e._scummVars[e.VAR_CUTSCENEEXIT_KEY] == 0)
+		return false;
+	// Not while input is on: Esc would also hand key 27 to the input script
+	// (verbs.cpp checkExecVerbs()). Every override on the route runs with
+	// input off (docs/part1/skips.md section 2), so this refuses none of
+	// them. But the skip path can turn input back on later in the same
+	// frame (room-051-circus-te/local-207.txt [0894] startScript(32), which
+	// does UserputOn; [0D59] UserputOn; global 19's UserputSoftOn at
+	// endCutscene()), and then key 27 does reach the input script. A
+	// player's Esc does the same, and it is harmless: input script 4 hands
+	// it to script 20, which only sets Var[105] = 0 (global/script-004.txt
+	// [02B5], global/script-020.txt [001E]); dialogue script 14 has no
+	// handler for it. Either way the Esc is the frame's input, so the plan
+	// player waits for the next frame (inputUsedUp(), esc_frame).
+	if (e._userPut > 0)
+		return false;
+	if (!_override.ptr || _override.stale)
+		return false;
+	if (_override.where == WIO_GLOBAL && spared(_override.number))
+		return false; // the skips event's "spare": the book's own override would end the book
+	const byte *code = nullptr;
+	uint32 size = 0;
+	return slotCode(_override.slot, code, size) && _override.ptr < size && code[_override.ptr] == kOpJumpRelative;
+}
+
+int SpeedrunBridge::messageWaitSlot() const {
+	for (int i = 0; i < NUM_SCRIPT_SLOT; i++) {
+		if (_vm->vm.slot[i].status != ssDead && slotWaitsForMessage(i))
+			return i;
+	}
+	return -1;
+}
+
+bool SpeedrunBridge::textSkipEffective(int delta, int &waitSlot) const {
+	// '.' sets _talkDelay = 0 and nothing else (input.cpp; stopTalk() only
+	// for talkies, which Mac MI1 is not). displayDialog() then ends the line,
+	// or moves to its next part, through the same code a timeout uses
+	// (string.cpp). So the press matters only while a line is showing and
+	// would not end in this frame anyway.
+	const ScummEngine &e = *_vm;
+	waitSlot = -1;
+	if (e.VAR_TALKSTOP_KEY == 0xFF || e._scummVars[e.VAR_TALKSTOP_KEY] == 0)
+		return false; // disabled '.' would reach the input script as key 46
+	if (!e._haveMsg || e._talkDelay <= CLIP(delta, 0, kMaxDelta))
+		return false;
+	// Only a real line, the idle rule's text test (speedrun_state.cpp): an
+	// actor talking (print(255) sets VAR_TALK_ACTOR to 0xFF), or a script
+	// waiting for the message. Never the island map's hover label, which
+	// global script 24 reprints every frame and nothing waits on
+	// (global/script-024.txt [0057], [0069]).
+	const int talker = e.VAR_TALK_ACTOR != 0xFF ? e._scummVars[e.VAR_TALK_ACTOR] : 0;
+	waitSlot = messageWaitSlot();
+	return ((talker > 0 && talker < 0x80) || waitSlot >= 0) && !textSpared();
+}
+
+bool SpeedrunBridge::spared(int number) const {
+	for (uint k = 0; k < _skipSpare.size(); k++) {
+		if (_skipSpare[k] == number)
+			return true;
+	}
+	return false;
+}
+
+bool SpeedrunBridge::textSpared() const {
+	// The skips event's "spare" scripts: a line is theirs while one of them
+	// runs unfrozen and no other unfrozen script waits for the message. The
+	// item slide's book (global 148) turns a page each time the message ends
+	// while it waits (script_v5.cpp o5_wait), so '.' on its own page spends a
+	// page early; on a dialogue line, whose end costs the same page either way,
+	// or while a dialogue cutscene has the book frozen, '.' only saves time.
+	if (_skipSpare.empty())
+		return false;
+	const ScummEngine &e = *_vm;
+	bool spareRuns = false;
+	for (int i = 0; i < NUM_SCRIPT_SLOT; i++) {
+		const ScriptSlot &ss = e.vm.slot[i];
+		if (ss.status == ssDead || ss.freezeCount > 0)
+			continue;
+		if (ss.where == WIO_GLOBAL && spared(ss.number))
+			spareRuns = true;
+		else if (slotWaitsForMessage(i))
+			return false;
+	}
+	return spareRuns;
+}
+
+bool SpeedrunBridge::stepForbidsCutsceneSkip() const {
+	// _stepIndex is the active step, or the next one to start, so no_skip
+	// covers the step and the wait (until, idle) before it.
+	return !_plan.empty() && !_planDone && _plan[_stepIndex].noSkip;
+}
+
+void SpeedrunBridge::maybeInjectSkip(int delta) {
+	trackOverride();
+	if (_finished || !_segmentStarted || (!_skipText && !_skipCutscenes))
+		return;
+
+	ScummEngine &e = *_vm;
+	if (e._keyPressed.keycode != Common::KEYCODE_INVALID)
+		return; // a scheduled key (applyRawInputs()) has the frame's one key
+	const int step = errorStep(); // -1 without a plan, and once it is done
+	// One key per frame (the engine reads one): Esc first, since it removes
+	// a whole override region; a line still showing gets '.' next frame.
+	if (_skipCutscenes && !stepForbidsCutsceneSkip() && cutsceneSkipEffective()) {
+		e._keyPressed = Common::KeyState(Common::KEYCODE_ESCAPE, Common::ASCII_ESCAPE, 0);
+		_escThisFrame = true; // the frame's input: the plan player waits (esc_frame)
+		const int32 var19 = e._scummVars[e.VAR_TIMER_NEXT];
+		JsonObject rec = record("skip");
+		rec.add("kind", "cutscene");
+		if (step >= 0)
+			rec.add("step", step);
+		rec.add("room", (int)e._currentRoom)
+		   .add("level", _override.level)
+		   .add("slot", _override.slot)
+		   .add("script", _override.number)
+		   .add("offs", (uint64)_override.ptr)
+		   .add("userput", (int)e._userPut)
+		   .add("var19", (int)var19);
+		writeRecord(rec);
+		if (step >= 0)
+			_stepSkips[kSkipCutscene]++;
+		_speedCheckPending = true; // judged at the next idle decision point
+		_speedCheckTick = _ticks;
+		_speedCheckScript = _override.number;
+		return;
+	}
+
+	int waitSlot = -1;
+	if (_skipText && textSkipEffective(delta, waitSlot)) {
+		e._keyPressed = Common::KeyState(Common::KEYCODE_PERIOD, '.', 0);
+		JsonObject rec = record("skip");
+		rec.add("kind", "text");
+		if (step >= 0)
+			rec.add("step", step);
+		rec.add("room", (int)e._currentRoom)
+		   .add("talker", e.VAR_TALK_ACTOR != 0xFF ? (int)e._scummVars[e.VAR_TALK_ACTOR] : 0);
+		if (waitSlot >= 0)
+			rec.add("wait_slot", waitSlot).add("wait_script", (int)e.vm.slot[waitSlot].number);
+		// Upper bound on the jiffies saved: what was left after this frame.
+		rec.add("talk_delay", (int)e._talkDelay - CLIP(delta, 0, kMaxDelta));
+		writeRecord(rec);
+		if (step >= 0)
+			_stepSkips[kSkipText]++;
+	}
+}
+
+bool SpeedrunBridge::timerNextChanged(const char *when) {
+	// The logo speed glitch family (rules/glitchless.md, banned item 2): an
+	// override path that skips a var 19 (VAR_TIMER_NEXT, the frame length in
+	// jiffies) write, or that leads to killing a script between its var 19
+	// set and restore, leaves every later frame shorter or longer
+	// (docs/research/skips-engine.md section 6). MI1 sets 6 at boot
+	// (global/script-001.txt [07B3]) and the logo restores 6
+	// (room-010-logo/local-204.txt [0097]). Mid-game writers only change it
+	// inside scripts that run with input off and restore it before they hand
+	// control back: the circus cannon, room-051-circus-te/local-208.txt
+	// [0005] sets 1 and [005F] restores it (docs/part1/skips.md section 3);
+	// global scripts 44 and 100 save and restore it (off-route). So var 19
+	// must be 6 whenever control is with the player: at the segment start,
+	// at every step_end, at the goal, and at the first idle decision point
+	// after a cutscene skip (which names the skip).
+	// SPEEDRUN_TIMER_NEXT sets the required value (6 by default); "any"
+	// (-1) allows the logo glitch and its family under the Any% rules.
+	const int32 kTimerNext = _timerNextExpected;
+	_speedCheckPending = false;
+	const int32 now = _vm->_scummVars[_vm->VAR_TIMER_NEXT];
+	if (kTimerNext < 0 || now == kTimerNext)
+		return false;
+	Common::String message = Common::String::format("var 19 (VAR_TIMER_NEXT) is %d at %s, not %d", now, when, kTimerNext);
+	if (_speedCheckScript >= 0)
+		message += Common::String::format("; last cutscene skip: script %d at tick %llu", _speedCheckScript,
+		                                  (unsigned long long)_speedCheckTick);
+	fail("timer_next", message);
+	return true;
+}
+
+} // End of namespace Scumm
