+	bool _segmentStarted = false;
+	uint64 _tick0 = 0;
+	IdleState _lastIdle;            // from the latest decision point
+	int _idleStreak = 0;            // consecutive decision points of _lastIdle.kind (idle only)
+	IdleState _blocker;             // what blocked progress at the latest decision point
+	uint64 _progressTick = 0;       // latest decision point with nothing blocking (0 = boot)
+	uint64 _stallTick = 0;          // tick of the latest stall record in this streak
+	bool _stallReported = false;
+
+	// Plan player
+	Common::Array<SpeedrunStep> _plan;
+	bool _hasPlan = false;
+	uint _stepIndex = 0;            // the active step, or the next one to start
+	bool _stepActive = false;
+	bool _planDone = false;
+	uint64 _planDoneTick = 0;
+	uint64 _stepWaitSince = 0;      // when the pending step became next
+	uint64 _stepStartTick = 0;      // the latest step_start (restarts too): the step timeout counts from here
+	uint64 _stepFirstStartTick = 0; // the step's first step_start: step_end ticks count from here
+	bool _stepRestarted = false;    // an interrupt made the active step start over
+	uint _clickIndex = 0;           // next click of the active step
+	uint _chooseIndex = 0;          // next choose entry of the active step
+	bool _menuAnswered = false;     // an answered menu has not gone away yet
+	Common::Array<int32> _snapVars; // state at step start, for step_end changes
+	Common::Array<byte> _snapBits;
+	Common::Array<int> _snapInventory;
+	int _snapRoom = 0;
+	uint _stepSkips[2] = {0, 0};    // skip records of the active/pending step: text, cutscene
+	bool _restartStep = false;      // an interrupt ended the active step: start it again
+
+	// Interrupts
+	int _interrupt = -1;            // the running interrupt, or -1
+	uint _interruptChoose = 0;      // its next choose entry
+
+	// This frame's input (C5 clicks_cleared, defer; speedrun_bridge.cpp)
+	bool _inputWindow = false;      // from onFrameBegin() to onDecisionPoint(): processInput() .. checkExecVerbs()
+	bool _escThisFrame = false;     // maybeInjectSkip() pressed Esc this frame
+	int _clearsThisFrame = 0;       // clearClickedStatus() calls in the window
+	int _clearScript = -1;          // the script running at the first of them, or -1
+	bool _deferWritten = false;     // a defer record for this frame is written
