+ *
+ */
+
+// Control socket (SPEEDRUN_CONTROL, contract C9): an external search drives
+// the run frame by frame and branches it with fork(). A forked child is an
+// exact copy of the game, RNG included: a savestate that cannot drift. The
+// engine runs on the main thread only (--disable-sdl-audio, the bridge pumps
+// the mixer; SDL's timer thread carries no game logic: real-time-paced and
+// fast runs end byte-identical, docs/anypercent/findings.md), so a child
+// that has only the forking thread plays on exactly as the parent would.
+//
+// Protocol: one JSON object per line, both ways, over a Unix stream socket
+// the controller listens on. Each process (the root and every child) holds
+// its own connection.
+//   engine -> controller
+//     {"hello": pid, "parent": ppid|0, "frame", "tick"}   on connect
+//     {"stop": reason, "frame", "tick", ...status}        when a run command stops
+//     {"forked": child_pid}                              reply to fork
+//     {"state": {...}}                                   reply to state (C7)
+//     {"end": reason, "frame", "tick", "room", ...}      the run ended (goal, error, ...)
+//   controller -> engine (only while stopped)
+//     {"cmd": "inputs", "events": [C8 events]}   schedule raw input (frames after now)
+//     {"cmd": "run", "frame": N}                 run to the decision point of frame N
+//     {"cmd": "run", "until": [C3], "max_frame": N}   ... or until the conditions hold
+//     {"cmd": "run", "control": true, "max_frame": N} ... or until a click would count
+//     {"cmd": "fork"}                            fork; the child connects on its own
+//     {"cmd": "state"}                           C7 state dump
+//     {"cmd": "holds", "until": [C3...]}         {"holds": bool} now, no frame run
+//     run also takes "idle": true (stop when the bridge's idle rule holds), "menu": true
+//     (stop when a dialogue menu takes a click) and
+//     "until_any": [[C3...], ...] (stop when any group holds; reason "until_any:<i>")
+//     {"cmd": "set_rng", "state": N}             search only: set the RNG state (trace "rng_set")
+//     {"cmd": "quit"}                            exit at once
+
+#define FORBIDDEN_SYMBOL_ALLOW_ALL
+
+#include <errno.h>
+#include <signal.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include <fcntl.h>
+
+#include "common/formats/json.h"
+
+#include "scumm/actor.h"
+#include "scumm/scumm.h"
+#include "scumm/speedrun/speedrun_bridge.h"
+
+namespace Scumm {
+
+bool SpeedrunBridge::controlConnect() {
+	_controlFd = socket(AF_UNIX, SOCK_STREAM, 0);
+	if (_controlFd < 0)
+		return false;
+	sockaddr_un addr;
+	memset(&addr, 0, sizeof(addr));
+	addr.sun_family = AF_UNIX;
+	if (_controlPath.size() >= sizeof(addr.sun_path))
+		return false;
+	strncpy(addr.sun_path, _controlPath.c_str(), sizeof(addr.sun_path) - 1);
+	if (connect(_controlFd, (const sockaddr *)&addr, sizeof(addr)) < 0) {
+		close(_controlFd);
+		_controlFd = -1;
+		return false;
+	}
+	_controlBuf.clear();
+	JsonObject hello;
+	hello.add("hello", (int)getpid()).add("parent", _branchChild ? (int)getppid() : 0)
+	     .add("frame", _frames).add("tick", _ticks);
+	controlSend(hello.str());
+	return true;
+}
+
+void SpeedrunBridge::controlSend(const Common::String &line) {
+	if (_controlFd < 0)
+		return;
+	Common::String out = line + "\n";
+	const char *p = out.c_str();
+	size_t left = out.size();
+	while (left > 0) {
+		const ssize_t n = send(_controlFd, p, left, MSG_NOSIGNAL);
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			_exit(3); // the controller is gone: nothing left to report to
+		}
+		p += n;
+		left -= (size_t)n;
+	}
+}
+
+bool SpeedrunBridge::controlReadLine(Common::String &out) {
+	for (;;) {
+		for (uint i = 0; i < _controlBuf.size(); i++) {
+			if (_controlBuf[i] == '\n') {
+				out = Common::String(_controlBuf.c_str(), i);
+				_controlBuf = Common::String(_controlBuf.c_str() + i + 1);
+				return true;
+			}
+		}
+		char buf[4096];
+		const ssize_t n = recv(_controlFd, buf, sizeof(buf), 0);
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n <= 0)
+			return false;
+		_controlBuf += Common::String(buf, (uint32)n);
+	}
+}
+
+Common::String SpeedrunBridge::controlStatus(const char *reason) const {
+	const ScummEngine &e = *_vm;
+	JsonObject s;
+	s.add("stop", reason).add("frame", _frames).add("tick", _ticks).add("qf", _quarterFrames).add("qf0", _qf0)
+	 .add("room", (int)e._currentRoom)
+	 .add("up", (int)e._userPut).add("cur", (int)e._cursor.state).add("cs", (int)e.vm.cutSceneStackPointer)
+	 .add("v19", (int)e._scummVars[e.VAR_TIMER_NEXT]).add("seg", _segmentStarted)
+	 .add("tick0", _tick0).add("rng", (uint64)e._rnd.getSeed()); // the RNG state (xorshift32, common/random.cpp)
+	if (_lastIdle.kind != kNotIdle)
+		s.add("idle", _lastIdle.kind == kIdleSentence ? "sentence" : "dialog");
+	else
+		s.add("blk", _lastIdle.blocker ? _lastIdle.blocker : "?");
+	const int ego = e._scummVars[e.VAR_EGO];
+	if (ego > 0 && ego < e._numActors && e._actors[ego]->isInCurrentRoom()) {
+		const Actor *a = e._actors[ego];
+		s.addRaw("ego", JsonArray().add(a->getRealPos().x).add(a->getRealPos().y).str())
+		 .add("mv", (int)a->_moving).add("box", (int)a->_walkbox);
+	}
+	s.add("cam", (int)e.camera._cur.x).add("xstart", (int)e._virtscr[kMainVirtScreen].xstart)
+	 .add("room_w", (int)e._roomWidth);
+	return s.str();
+}
+
+bool SpeedrunBridge::clickGateOpen() const {
+	// The engine's own gate for a scene or verb click (checkExecVerbs(),
+	// verbs.cpp): user input on and no cutscene running. Room 0 (between
+	// rooms) has nothing to click.
+	const ScummEngine &e = *_vm;
+	return e._userPut > 0 && e.vm.cutSceneStackPointer == 0 && e._currentRoom != 0;
+}
+
+void SpeedrunBridge::controlAtDecisionPoint() {
+	if (_controlFd < 0 || _finished)
+		return;
+	const char *reason = nullptr;
+	if (_stopFrame && _frames >= _stopFrame)
+		reason = "frame";
+	else if (_stopOnControl && clickGateOpen())
+		reason = "control";
+	else if (!_stopUntil.empty() && allHold(_stopUntil))
+		reason = "until";
+	else if (_stopOnIdle && _lastIdle.kind != kNotIdle)
+		reason = "idle";
+	else if (_stopOnMenu && clickGateOpen() && anyVisibleVerb(120, 128)) // dialogue lines (speedrun_state.cpp)
+		reason = "menu";
+	if (!reason) {
+		for (uint i = 0; i < _stopUntilAny.size(); i++) {
+			if (allHold(_stopUntilAny[i])) {
+				static const char *kAny[] = {"until_any:0", "until_any:1", "until_any:2", "until_any:3",
+				                             "until_any:4", "until_any:5", "until_any:6", "until_any:7"};
+				reason = kAny[MIN<uint>(i, 7)];
+				break;
+			}
+		}
+	}
+	if (!reason && _stopMaxFrame && _frames >= _stopMaxFrame)
+		reason = "max_frame";
+	if (!reason && !_stopFrame && !_stopOnControl && !_stopOnIdle && !_stopOnMenu && _stopUntil.empty() &&
+	    _stopUntilAny.empty() &&
+	    !_stopMaxFrame)
+		reason = "idle_controller"; // no run command yet (just connected or forked)
+	if (!reason)
+		return;
+	controlLoop(reason);
+}
+
+void SpeedrunBridge::controlLoop(const char *reason) {
+	_stopFrame = 0;
+	_stopMaxFrame = 0;
+	_stopOnControl = false;
+	_stopOnIdle = false;
+	_stopOnMenu = false;
+	_stopUntil.clear();
+	_stopUntilAny.clear();
+	controlSend(controlStatus(reason));
+
+	Common::String line;
+	for (;;) {
+		if (!controlReadLine(line))
+			_exit(0); // controller closed the connection
+		Common::JSONValue *root = Common::JSON::parse(line);
+		const Common::JSONObject *obj = (root && root->isObject()) ? &root->asObject() : nullptr;
+		const Common::String cmd = (obj && obj->contains("cmd") && obj->getVal("cmd")->isString())
+		                           ? obj->getVal("cmd")->asString() : Common::String();
+		Common::String error;
+		bool resume = false;
+
+		if (cmd == "run") {
+			if (obj->contains("frame") && obj->getVal("frame")->isIntegerNumber())
+				_stopFrame = (uint64)obj->getVal("frame")->asIntegerNumber();
+			if (obj->contains("max_frame") && obj->getVal("max_frame")->isIntegerNumber())
+				_stopMaxFrame = (uint64)obj->getVal("max_frame")->asIntegerNumber();
+			if (obj->contains("control"))
+				_stopOnControl = obj->getVal("control")->isBool() && obj->getVal("control")->asBool();
+			if (obj->contains("until") && !parseSpeedrunConditionArray(obj->getVal("until"), _stopUntil, error))
+				error = "until: " + error;
+			if (obj->contains("idle"))
+				_stopOnIdle = obj->getVal("idle")->isBool() && obj->getVal("idle")->asBool();
+			if (obj->contains("menu"))
+				_stopOnMenu = obj->getVal("menu")->isBool() && obj->getVal("menu")->asBool();
+			if (error.empty() && obj->contains("until_any")) {
+				const Common::JSONValue *groups = obj->getVal("until_any");
+				if (!groups->isArray()) {
+					error = "until_any: expected an array of condition arrays";
+				} else {
+					for (const Common::JSONValue *g : groups->asArray()) {
+						SpeedrunConditions conds;
+						if (!parseSpeedrunConditionArray(g, conds, error)) {
+							error = "until_any: " + error;
+							break;
+						}
+						_stopUntilAny.push_back(conds);
+					}
+				}
+			}
+			if (error.empty() && !_stopFrame && !_stopMaxFrame && !_stopOnControl && !_stopOnIdle && !_stopOnMenu &&
+			    _stopUntil.empty() && _stopUntilAny.empty())
+				error = "run needs frame, max_frame, control, idle, until or until_any";
+			if (error.empty() && _stopFrame && _stopFrame <= _frames)
+				error = Common::String::format("frame %llu is not after the current frame %llu",
+				                               (unsigned long long)_stopFrame, (unsigned long long)_frames);
+			resume = error.empty();
+		} else if (cmd == "inputs") {
+			const Common::JSONValue *events = obj->contains("events") ? obj->getVal("events") : nullptr;
+			if (!events || !events->isArray()) {
+				error = "inputs needs an events array";
+			} else {
+				Common::String text;
+				for (const Common::JSONValue *ev : events->asArray())
+					text += ev->stringify() + "\n";
+				Common::Array<SpeedrunInput> parsed;
+				if (!parseSpeedrunInputs(text, parsed, error)) {
+					error = "events: " + error;
+				} else {
+					const uint64 last = _inputs.empty() ? 0 : _inputs.back().frame;
+					for (const SpeedrunInput &in : parsed) {
+						if (in.frame <= _frames || in.frame < last) {
+							error = Common::String::format("event frame %llu must be after frame %llu and not before %llu",
+							                               (unsigned long long)in.frame, (unsigned long long)_frames,
+							                               (unsigned long long)last);
+							break;
+						}
+					}
+					if (error.empty()) {
+						for (const SpeedrunInput &in : parsed)
+							_inputs.push_back(in);
+						controlSend("{\"ok\":\"inputs\"}");
+					}
+				}
+			}
+		} else if (cmd == "fork") {
+			// The open data file's read position would be shared by both
+			// processes; close it so each one reopens its own on demand.
+			_vm->closeRoom();
+			const pid_t pid = fork();
+			if (pid < 0) {
+				error = Common::String::format("fork failed: %s", strerror(errno));
+			} else if (pid == 0) {
+				// The child: its own connection, and no files shared with the
+				// parent (the trace's file offset is shared after fork()).
+				_branchChild = true;
+				close(_controlFd);
+				_controlFd = -1;
+				_trace.close();
+				if (_frameLog)
+					_frameFile.close();
+				_frameLog = false;
+				if (!controlConnect())
+					_exit(4);
+				controlSend(controlStatus("forked"));
+				delete root;
+				continue;
+			} else {
+				controlSend(Common::String::format("{\"forked\":%d}", (int)pid));
+			}
+		} else if (cmd == "at") {
+			// What a click at screen (x, y) would hit now: the virtual screen
+			// zone, the object findObject() returns for the main screen (as the
+			// input script asks it), and the verb slot under it.
+			const Common::JSONValue *vx = obj->contains("x") ? obj->getVal("x") : nullptr;
+			const Common::JSONValue *vy = obj->contains("y") ? obj->getVal("y") : nullptr;
+			if (!vx || !vy || !vx->isIntegerNumber() || !vy->isIntegerNumber()) {
+				error = "at needs integer x and y";
+			} else {
+				const int x = (int)vx->asIntegerNumber(), y = (int)vy->asIntegerNumber();
+				VirtScreen *vs = _vm->findVirtScreen(y);
+				JsonObject at;
+				at.add("x", x).add("y", y).add("zone", vs ? (int)vs->number : -1);
+				if (vs && vs->number == kMainVirtScreen) {
+					const int virtX = x + vs->xstart, virtY = y - vs->topline;
+					at.add("vx", virtX).add("vy", virtY).add("obj", _vm->findObject(virtX, virtY))
+					  .add("actor", _vm->getActorFromPos(virtX, virtY));
+				}
+				at.add("verb_slot", _vm->findVerbAtPos(x, y));
+				controlSend("{\"at\":" + at.str() + "}");
+			}
+		} else if (cmd == "set_rng") {
+			// Search only: put the RNG in a state, so a branch stands in for a
+			// run from boot with another seed. The trace record marks the run.
+			const Common::JSONValue *v = obj->contains("state") ? obj->getVal("state") : nullptr;
+			if (!v || !v->isIntegerNumber() || v->asIntegerNumber() <= 0 || v->asIntegerNumber() > 0xFFFFFFFFLL) {
+				error = "set_rng needs a state in 1..2^32-1";
+			} else {
+				_vm->_rnd.setSeed((uint32)v->asIntegerNumber());
+				writeRecord(record("rng_set").add("state", (uint64)_vm->_rnd.getSeed()));
+				controlSend("{\"ok\":\"set_rng\"}");
+			}
+		} else if (cmd == "holds") {
+			// Whether conditions hold now, without running a frame.
+			SpeedrunConditions conds;
+			if (!obj->contains("until") || !parseSpeedrunConditionArray(obj->getVal("until"), conds, error))
+				error = "holds: " + error;
+			else
+				controlSend(Common::String::format("{\"holds\":%s}", allHold(conds) ? "true" : "false"));
+		} else if (cmd == "state") {
+			controlSend("{\"state\":" + stateJson() + "}");
+		} else if (cmd == "quit") {
+			_exit(0);
+		} else {
+			error = "unknown command: " + line;
+		}
+		delete root;
+		if (!error.empty()) {
+			JsonObject err;
+			err.add("error", error);
+			controlSend(err.str());
+			continue;
+		}
+		if (resume)
+			return;
+	}
+}
+
+void SpeedrunBridge::controlEnd(const JsonObject &endRecord) {
+	if (_controlFd < 0)
+		return;
+	controlSend("{\"end\":" + endRecord.str() + "}");
+	if (_branchChild)
+		_exit(0); // a branch never runs the engine's shutdown (SDL state belongs to the root)
+}
+
+void SpeedrunBridge::controlInit() {
+	signal(SIGCHLD, SIG_IGN); // branches are reaped automatically
+	if (!controlConnect())
+		raiseError("bad_env", Common::String::format("cannot connect to SPEEDRUN_CONTROL '%s'", _controlPath.c_str()));
+}
+
+int SpeedrunBridge::captureOpen(const Common::String &path) {
+	return ::open(path.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0644);
+}
+
+void SpeedrunBridge::captureWrite(int fd, const void *buf, uint32 size) {
+	const char *p = (const char *)buf;
+	while (fd >= 0 && size > 0) {
+		const ssize_t n = ::write(fd, p, size);
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n <= 0)
+			return; // the reader went away: the run itself must not depend on the capture
+		p += n;
+		size -= (uint32)n;
+	}
+}
+
+void SpeedrunBridge::captureClose(int fd) {
+	if (fd >= 0)
+		::close(fd);
+}
+
+} // End of namespace Scumm
