+	bool endTrace(const char *reason, const char *errorCode, const char *errorMessage);
+	static bool errorHandler(const char *msg);
+
+	// Trace (contract C5): one JSON object per line, flushed after each
+	/** A record with "type", "tick" and "frame"; callers add the rest. */
+	JsonObject record(const char *type) const;
+	void writeRecord(const JsonObject &rec);
+	/** FNV-1a 32 over _scummVars[0.._numVariables) as little-endian int32s. */
+	Common::String varsFingerprint() const;
+
+	ScummEngine *_vm;
+
+	// Configuration (contract C1)
+	Common::String _outDir;
+	bool _skipWaits = false;        // SPEEDRUN_FAST
+	bool _fastBoot = false;         // SPEEDRUN_FAST_BOOT
+	bool _pumpAudio = false;
+	bool _hasMaxTicks = false;
+	uint64 _maxTicks = 0;
+	bool _dumpObjects = false;
+	Common::String _planPath;
+	SpeedrunConditions _start;      // SPEEDRUN_START; empty = first sentence-idle frame
+	SpeedrunConditions _goal;       // SPEEDRUN_GOAL; empty = no goal
+	struct InventoryLayout {        // SPEEDRUN_INVENTORY
+		bool valid = false;
+		int32 verbFirst = 0, count = 0, varFirst = 0;
+	} _inventory;
+	uint64 _stepTimeout = 36000;    // ticks; 10 minutes of game time
+	bool _skipText = false;         // SPEEDRUN_SKIP_TEXT
+	bool _skipCutscenes = false;    // SPEEDRUN_SKIP_CUTSCENES
+	Common::Array<int32> _skipSpare; // the last skips event's "spare" (textSpared())
+	bool _stepStates = false;       // SPEEDRUN_STEP_STATES
+	Common::Array<SpeedrunInterrupt> _interrupts; // SPEEDRUN_INTERRUPTS
+	Common::Array<SpeedrunInput> _inputs; // SPEEDRUN_INPUTS
+	uint _inputIndex = 0;           // next event to deliver
