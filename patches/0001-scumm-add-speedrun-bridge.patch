+	 * checkExecVerbs() (clicks_cleared). Then it sets that blocker and
+	 * writes a defer record (once per frame), and the action waits.
+	 */
+	bool inputUsedUp();
+
+	// Control socket (speedrun_control.cpp, contract C9)
+	void controlInit();
+	bool controlConnect();
+	void controlSend(const Common::String &line);
+	bool controlReadLine(Common::String &out);
+	Common::String controlStatus(const char *reason) const;
+	/** The engine's click gate: user input on, no cutscene, a real room. */
+	bool clickGateOpen() const;
+	/** End of onDecisionPoint(): stop and serve commands if a run command's stop holds. */
+	void controlAtDecisionPoint();
+	void controlLoop(const char *reason);
+	/** The run ended: report it; a branch then exits without engine shutdown. */
+	void controlEnd(const JsonObject &endRecord);
+
+	// Interrupts (speedrun_interrupts.cpp)
+	/**
+	 * A menu is visible that the plan does not answer (would be
+	 * unexpected_choice): start the first interrupt whose `when` holds and
+	 * answer the menu. False if none matches (nothing recorded).
+	 */
+	bool tryStartInterrupt();
