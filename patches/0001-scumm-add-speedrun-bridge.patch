+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ *
+ */
+
+// Interrupts (docs/plan.md C1 SPEEDRUN_INTERRUPTS, C5 interrupt records): a
+// fixed, cited answer to a dialogue the game opens at random, such as a
+// wandering pirate on the island map forcing an encounter on the road
+// (room-085-melee/local-202.txt [018A]-[01A2], global/script-114.txt).
+//
+// An interrupt is considered only where the plan player would otherwise fail
+// with unexpected_choice: a menu is visible and the active step has no choose
+// entry left, the pending step does not answer menus, or the plan is done.
+// The first interrupt whose `when` holds answers this menu and the following
+// ones, one choose entry per menu. It ends on the first sentence-idle
+// decision point after its last answer where `when` no longer holds (the
+// road's input script is back on before ego is moved back to the map, so
+// "sentence-idle" alone could still be in room 49).
+//
+// Then the plan carries on:
+// - If the step was active, it starts over from its beginning: room check,
+//   until, then its sentence or clicks again, with a step_start that says
+//   "restart". This is sound for the steps an interrupt can cut short: the
+//   room change into the interrupt kills the room's object scripts (room.cpp
+//   startScene -> killScriptsAndResources), so a map walk whose verb script
+//   had not loaded the next room yet never happened, and ego is back where
+//   it stood (global/script-114.txt [006E]-[0079]). If ego ends up elsewhere,
+//   the restart fails with room_mismatch, which is the honest outcome.
+// - If the step was pending (the previous step had completed its sentence),
+//   it simply starts as usual once the interrupt has ended.
+// - After the last step, the run goes back to waiting for the goal.
+
+#include "scumm/scumm.h"
+#include "scumm/speedrun/speedrun_bridge.h"
+
+namespace Scumm {
+
+bool SpeedrunBridge::tryStartInterrupt() {
+	for (uint i = 0; i < _interrupts.size(); i++) {
+		if (!allHold(_interrupts[i].when))
+			continue;
+		// Its answer is this decision point's action: with the frame's input
+		// used up, the interrupt starts next frame (nothing recorded yet).
+		if (inputUsedUp())
+			return true;
+		_interrupt = (int)i;
+		_interruptChoose = 0;
+		if (_stepActive) {
+			_stepActive = false;
+			_restartStep = true;
+		}
+		// The interrupt and the step's (re)start share one step timeout.
+		_stepWaitSince = _ticks;
+
+		JsonObject rec = record("interrupt");
+		rec.add("name", _interrupts[i].name);
+		if (errorStep() >= 0)
+			rec.add("step", errorStep());
+		rec.add("room", (int)_vm->_currentRoom).add("restart", _restartStep);
+		writeRecord(rec);
+		markProgress();
+
+		runInterrupt(); // answers the visible menu: this decision point's action
+		return true;
+	}
+	return false;
+}
+
+bool SpeedrunBridge::runInterrupt() {
+	const SpeedrunInterrupt &it = _interrupts[_interrupt];
+	const IdleKind kind = _lastIdle.kind;
+
+	if (_segmentStarted && _ticks - MAX(_stepWaitSince, _tick0) >= _stepTimeout) {
+		const char *blocker = kind == kNotIdle ? _lastIdle.blocker : nullptr;
+		fail("step_timeout", Common::String::format(
+			"interrupt %s did not end within %llu ticks: choices %u/%u, %s%s", it.name.c_str(),
+			(unsigned long long)_stepTimeout, _interruptChoose, it.choose.size(),
+			blocker ? "blocked by " : "not idle-blocked at the deadline", blocker ? blocker : ""));
+		return true;
+	}
+	if (kind == kNotIdle)
+		return true; // the idle blocker, with its script slot, is already set
+
+	if (kind == kIdleDialog) {
+		if (_menuAnswered) {
+			setBlocker("menu_answered");
+			return true;
+		}
+		if (_interruptChoose >= it.choose.size()) {
+			fail("unexpected_choice", Common::String::format("interrupt %s has no choose entry left for this menu: %s",
+			                                                 it.name.c_str(), visibleChoices().c_str()));
+			return true;
+		}
+		if (clickChoice(it.choose[_interruptChoose], it.name.c_str()))
+			_interruptChoose++;
+		return true;
+	}
+
+	// Sentence-idle.
+	if (_interruptChoose < it.choose.size()) {
+		setBlocker("awaiting_menu");
+		return true;
+	}
+	if (allHold(it.when)) {
+		setBlocker("interrupt");
+		return true;
+	}
+
+	JsonObject rec = record("interrupt_end");
+	rec.add("name", it.name);
+	if (errorStep() >= 0)
+		rec.add("step", errorStep());
+	rec.add("room", (int)_vm->_currentRoom).add("restart", _restartStep);
+	writeRecord(rec);
+	_interrupt = -1;
+	_stepWaitSince = _ticks;
+	markProgress();
+	return false;
+}
+
+} // End of namespace Scumm
