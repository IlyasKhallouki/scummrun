+	void checkConditionRanges(const SpeedrunConditions &conds, const char *what, const char *code);
+
+	// Dumps (speedrun_state.cpp)
+	/**
+	 * Verb slot text, raw bytes with escapes stripped. @p rendered expands
+	 * variable, verb and name references as drawVerb() shows them; otherwise
