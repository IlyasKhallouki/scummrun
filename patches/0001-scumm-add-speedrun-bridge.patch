+
+/**
+ * Speedrun bridge: lets an external harness run the game headless, on a
+ * deterministic tick clock, and observe it through a JSONL trace.
+ *
+ * Inert unless the SPEEDRUN_OUT environment variable is set: create() then
+ * returns nullptr and every hook in ScummEngine is a null-pointer check.
+ *
+ * Hooks (engines/scumm/scumm.cpp):
+ *  - init(), first statement:                 create()
+ *  - go(), before setTotalPlayTime():         onBoot()
+ *  - scummLoop(), first statement:            onFrameBegin(delta)
+ *  - scummLoop(), before checkAndRunSentenceScript(): onDecisionPoint()
+ *  - waitForTimer():                          skipWaits()
+ *  - clearClickedStatus() (input.cpp), first statement: onClearClicked()
+ *  - ~ScummEngine(), first statement:         delete
+ *
+ * Environment (contract C1; all read once, in create()):
+ *  - SPEEDRUN_OUT=<dir>          output dir: trace.jsonl, objects.json, state-*.json
+ *  - SPEEDRUN_FAST=1             no real-time waiting between frames
+ *  - SPEEDRUN_FAST_BOOT=1        no real-time waiting until the segment start; from the
+ *                                frame segment_start is recorded in, SPEEDRUN_FAST decides
+ *  - SPEEDRUN_MAX_TICKS=<n>      watchdog: end "max_ticks" once ticks >= n
+ *  - SPEEDRUN_DUMP_OBJECTS=1     objects.json at the first idle frame, then end "dump_done"
+ *  - SPEEDRUN_START=<json>       segment start conditions, checked on sentence-idle frames
+ *  - SPEEDRUN_GOAL=<json>        goal conditions, checked once the segment has started;
+ *                                unset or [] means no goal
+ *  - SPEEDRUN_PLAN, SPEEDRUN_INVENTORY, SPEEDRUN_STEP_TIMEOUT, SPEEDRUN_INTERRUPTS:
+ *                                stored for the plan player
+ *  - SPEEDRUN_SKIP_TEXT=1        after the segment start, press '.' on the first frame
+ *                                a real line can be cut short (speedrun_skips.cpp)
+ *  - SPEEDRUN_SKIP_CUTSCENES=1   after the segment start, press Esc on the first frame
+ *                                an override is live, except during no_skip steps
+ *  - SPEEDRUN_STEP_STATES=1      diagnostic: state-step-NNN.json at every step_end
+ *  - SPEEDRUN_INPUTS=<path>      raw input schedule (C8, speedrun_inputs.cpp): keys, clicks
+ *                                and mouse moves on exact frames, from boot on
+ *  - SPEEDRUN_TIMER_NEXT=<n|any> the var 19 (VAR_TIMER_NEXT) value required whenever
+ *                                control is with the player (default 6, the glitchless
+ *                                rules); "any" turns the check off (Any% rules)
+ *  - SPEEDRUN_FRAME_LOG=1        frames.jsonl: room, userput, cutscene level, idle or
+ *                                blocker, ego position and walk state at every decision point
+ *  - SPEEDRUN_CONTROL=<socket>   serve the C9 control protocol (speedrun_control.cpp):
+ *                                run to a frame or condition, schedule input, fork branches
+ *  - SPEEDRUN_START_FRAME=<n>    start the segment at the decision point of frame n
+ *                                instead of SPEEDRUN_START (Any% timing starts at the
+ *                                logo skip, which is an input, not a game state)
+ * The RNG seed is ScummVM's own --random-seed (ConfMan "random_seed").
+ *
+ * Record stamping (contract C2): records about the completed previous frame
+ * (saveload, goal, stall) are written at the top of onFrameBegin() with the
+ * counters before this frame's delta; records decided at the decision point
+ * (segment_start) and the watchdog use the counters after it.
+ */
+class SpeedrunBridge {
+public:
+	/** nullptr unless SPEEDRUN_OUT is set. Opens the trace, installs the error handler. */
+	static SpeedrunBridge *create(ScummEngine *vm);
+	/** Writes an end record with reason "quit" unless the run already ended. */
+	~SpeedrunBridge();
+
+	/** go(), before the boot script runs: writes the boot record. */
+	void onBoot();
+	/**
+	 * First statement of scummLoop(): the previous frame has completed and
+	 * processInput() has not run yet. @p delta is the unclamped tick delta
+	 * (jiffies of 1/60 s).
+	 */
+	void onFrameBegin(int delta);
+	/** scummLoop(), right before checkAndRunSentenceScript(). */
+	void onDecisionPoint();
+	/**
+	 * waitForTimer(): true skips the real-time wait. SPEEDRUN_FAST, or
+	 * SPEEDRUN_FAST_BOOT before the segment start. go() waits before each
+	 * scummLoop(), so the frame segment_start is recorded in is the first one
+	 * shown for its real-time length. Only wall-clock pacing changes, never ticks.
+	 */
+	bool skipWaits() const { return _skipWaits || (_fastBoot && !_segmentStarted); }
+	/**
+	 * First statement of waitForTimer(): every wait the engine makes, the
+	 * main loop's 4 * delta and the room-change effects' (dissolve, iris,
+	 * fades), counted in quarter-frames. RTA is qf / timer_hz seconds.
+	 */
+	void onWait(int quarterFrames);
+	/**
+	 * SoundCD::playCDTrackInternal(): a CD audio track started (@p playing:
+	 * its file opened). A track that did not open plays as silence and ends
+	 * at once, which changes every wait on it: the run's Python side treats
+	 * a "cd_track" record with "playing": false as an invalid run.
+	 */
+	void onCDTrack(int track, int numLoops, int startFrame, int duration, bool playing);
+	/**
+	 * First statement of clearClickedStatus(). Counts the calls that wipe a
+	 * click a player made this frame (speedrun_bridge.cpp).
+	 */
+	void onClearClicked();
+
+private:
+	enum IdleKind { kNotIdle, kIdleSentence, kIdleDialog };
