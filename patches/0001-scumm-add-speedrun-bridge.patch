+
+// Raw input schedule (SPEEDRUN_INPUTS, contract C8): mouse moves, clicks and
+// key presses delivered on exact frames, the way a TAS input movie drives a
+// game. Each event is written into the same fields parseEvents() fills from a
+// real SDL event (input.cpp), right before processInput() reads them, so the
+// game's own input scripts see an ordinary click or key press.
+
+#include "common/formats/json.h"
+#include "common/keyboard.h"
+
+#include "scumm/scumm.h"
+#include "scumm/speedrun/speedrun_bridge.h"
+
+namespace Scumm {
+
+// input.cpp's MouseButtonStatus, which is local to that file.
+enum { kMsDown = 1, kMsClicked = 2 };
+
+static bool parseKeyName(const Common::String &name, Common::KeyState &out) {
+	// The keys a MI1 run uses: Esc (cutscene skip, and the logo skip), '.'
+	// (text skip), space (pause), Enter, and single printable characters
+	// (verb shortcuts, dialogue digits).
+	if (name == "esc") {
+		out = Common::KeyState(Common::KEYCODE_ESCAPE, Common::ASCII_ESCAPE, 0);
+	} else if (name == "space") {
+		out = Common::KeyState(Common::KEYCODE_SPACE, ' ', 0);
+	} else if (name == "enter") {
+		out = Common::KeyState(Common::KEYCODE_RETURN, Common::ASCII_RETURN, 0);
+	} else if (name.size() == 1 && name[0] >= 0x20 && name[0] < 0x7F) {
+		const char c = name[0];
+		const Common::KeyCode code = (c >= 'A' && c <= 'Z') ? (Common::KeyCode)(c - 'A' + 'a') : (Common::KeyCode)c;
+		out = Common::KeyState(code, (uint16)c, 0);
+	} else {
+		return false;
+	}
+	return true;
+}
+
+static bool readPoint(const Common::JSONValue *v, int32 &x, int32 &y) {
+	if (!v || !v->isArray() || v->asArray().size() != 2)
+		return false;
+	const Common::JSONValue *vx = v->asArray()[0], *vy = v->asArray()[1];
+	if (!vx->isIntegerNumber() || !vy->isIntegerNumber())
+		return false;
+	x = (int32)vx->asIntegerNumber();
+	y = (int32)vy->asIntegerNumber();
+	return x >= 0 && y >= 0 && x < 0x10000 && y < 0x10000;
+}
+
+bool parseSpeedrunInputs(const Common::String &text, Common::Array<SpeedrunInput> &out, Common::String &error) {
+	// One JSON object per line: {"frame": N, <one of>} with
+	//   "click": [x, y]   left button pressed on frame N (screen coordinates)
+	//   "rclick": [x, y]  right button
+	//   "move": [x, y]    the mouse moves; it stays there until the next event
+	//   "key": name       "esc", "space", "enter" or one printable character
+	//   "skips": {"text": 0|1, "cutscenes": 0|1}
+	//                     switch the bridge's automatic '.' and Esc
+	//                     (SPEEDRUN_SKIP_TEXT/_CUTSCENES) from frame N on
+	// Frames are the bridge's frame counter (trace "frame"); they must not decrease.
+	out.clear();
+	uint lineNo = 0;
+	uint64 lastFrame = 0;
+	for (uint pos = 0; pos < text.size();) {
+		const char *nl = strchr(text.c_str() + pos, '\n');
+		const uint end = nl ? (uint)(nl - text.c_str()) : text.size();
+		Common::String line(text.c_str() + pos, end - pos);
+		pos = end + 1;
+		lineNo++;
+		line.trim();
+		if (line.empty())
+			continue;
+		Common::JSONValue *root = Common::JSON::parse(line);
+		if (!root || !root->isObject()) {
+			delete root;
+			error = Common::String::format("line %u: not a JSON object", lineNo);
+			return false;
+		}
+		const Common::JSONObject &obj = root->asObject();
+		SpeedrunInput in;
+		bool ok = obj.size() == 2 && obj.contains("frame") && obj.getVal("frame")->isIntegerNumber() &&
+		          obj.getVal("frame")->asIntegerNumber() > 0;
+		if (ok) {
+			in.frame = (uint64)obj.getVal("frame")->asIntegerNumber();
+			if (obj.contains("click")) {
+				in.kind = SpeedrunInput::kClick;
+				ok = readPoint(obj.getVal("click"), in.x, in.y);
+			} else if (obj.contains("rclick")) {
+				in.kind = SpeedrunInput::kRightClick;
+				ok = readPoint(obj.getVal("rclick"), in.x, in.y);
+			} else if (obj.contains("move")) {
+				in.kind = SpeedrunInput::kMove;
+				ok = readPoint(obj.getVal("move"), in.x, in.y);
+			} else if (obj.contains("skips") && obj.getVal("skips")->isObject()) {
+				const Common::JSONObject &sk = obj.getVal("skips")->asObject();
+				in.kind = SpeedrunInput::kSkips;
+				ok = (sk.size() == 2 || (sk.size() == 3 && sk.contains("spare"))) && sk.contains("text") &&
+				     sk.contains("cutscenes") && sk.getVal("text")->isIntegerNumber() &&
+				     sk.getVal("cutscenes")->isIntegerNumber();
+				if (ok) {
+					in.skipText = sk.getVal("text")->asIntegerNumber() != 0;
+					in.skipCutscenes = sk.getVal("cutscenes")->asIntegerNumber() != 0;
+				}
+				if (ok && sk.contains("spare")) {
+					ok = sk.getVal("spare")->isArray();
+					if (ok) {
+						for (const Common::JSONValue *v : sk.getVal("spare")->asArray()) {
+							if (!v->isIntegerNumber()) {
+								ok = false;
+								break;
+							}
+							in.spare.push_back((int32)v->asIntegerNumber());
+						}
+					}
+				}
+			} else if (obj.contains("key") && obj.getVal("key")->isString()) {
+				in.kind = SpeedrunInput::kKey;
+				in.keyName = obj.getVal("key")->asString();
+				ok = parseKeyName(in.keyName, in.key);
+			} else {
+				ok = false;
+			}
+		}
+		delete root;
+		if (!ok) {
+			error = Common::String::format("line %u: expected {\"frame\": N > 0, and one of click/rclick/move [x, y], key or skips}", lineNo);
+			return false;
+		}
+		if (in.frame < lastFrame) {
+			error = Common::String::format("line %u: frame %llu comes before frame %llu", lineNo,
+			                               (unsigned long long)in.frame, (unsigned long long)lastFrame);
+			return false;
+		}
+		lastFrame = in.frame;
+		out.push_back(in);
+	}
+	return true;
+}
+
+void SpeedrunBridge::applyRawInputs() {
+	// After neutraliseInput() and before maybeInjectSkip(): the mouse is where
+	// the schedule last put it, as a real mouse stays put between events, and
+	// this frame's events land in the fields processInput() reads next. A
+	// scheduled key takes the frame's one key; the automatic skip waits.
+	if (_inputs.empty())
+		return;
+	ScummEngine &e = *_vm;
+	e._mouse.x = _rawMouseX;
+	e._mouse.y = _rawMouseY;
+	while (_inputIndex < _inputs.size() && _inputs[_inputIndex].frame <= _frames) {
+		const SpeedrunInput &in = _inputs[_inputIndex++];
+		if (in.frame < _frames) {
+			fail("bad_inputs", Common::String::format("input %u is for frame %llu, already past", _inputIndex - 1,
+			                                         (unsigned long long)in.frame));
+			return;
+		}
+		JsonObject rec = record("input");
+		switch (in.kind) {
+		case SpeedrunInput::kSkips:
+			_skipText = in.skipText;
+			_skipCutscenes = in.skipCutscenes;
+			_skipSpare = in.spare;
+			rec.add("skip_text", (int)in.skipText).add("skip_cutscenes", (int)in.skipCutscenes)
+			   .add("skip_spare", (int)in.spare.size());
+			break;
+		case SpeedrunInput::kKey:
+			e._keyPressed = in.key;
+			if (in.key.keycode == Common::KEYCODE_ESCAPE)
+				_escThisFrame = true;
+			rec.add("key", in.keyName.c_str());
+			break;
+		case SpeedrunInput::kClick:
+		case SpeedrunInput::kRightClick:
+		case SpeedrunInput::kMove:
+			_rawMouseX = in.x;
+			_rawMouseY = in.y;
+			e._mouse.x = in.x;
+			e._mouse.y = in.y;
+			if (in.kind == SpeedrunInput::kClick)
+				e._leftBtnPressed |= kMsClicked | kMsDown;
+			else if (in.kind == SpeedrunInput::kRightClick)
+				e._rightBtnPressed |= kMsClicked | kMsDown;
+			rec.addRaw(in.kind == SpeedrunInput::kClick ? "click" : in.kind == SpeedrunInput::kRightClick ? "rclick" : "move",
+			           JsonArray().add((int)in.x).add((int)in.y).str());
+			break;
+		}
+		rec.add("room", (int)e._currentRoom);
+		writeRecord(rec);
+	}
+}
+
+} // End of namespace Scumm
