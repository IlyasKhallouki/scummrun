+	int32 _timerNextExpected = 6;   // SPEEDRUN_TIMER_NEXT; -1 = any
+	uint64 _startFrame = 0;         // SPEEDRUN_START_FRAME; 0 = use SPEEDRUN_START
+	int _lastRoom = 0;              // for "room" records
+	Common::String _envError;       // first invalid variable, reported once the trace is open
+
+	// Run clock (contract C2): ticks = sum of unclamped deltas since boot
+	uint64 _ticks = 0;
+	uint64 _frames = 0;
+	uint64 _quarterFrames = 0;      // every waitForTimer() wait since boot (RTA clock)
+	uint64 _qf0 = 0;                // _quarterFrames at the segment start
+
