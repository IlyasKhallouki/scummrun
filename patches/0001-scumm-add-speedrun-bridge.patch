+
+// Parses SPEEDRUN_PLAN (docs/plan.md contract C4): JSONL, one step per line,
+// with exactly the keys of src/speedrun/compiler.py C4_KEYS. Ranges that need
+// the game's counts are checked later, in SpeedrunBridge::loadPlan(). Also
+// parses SPEEDRUN_INTERRUPTS (C1), whose ranges onBoot() checks.
+
+#include "common/formats/json.h"
+
+#include "scumm/speedrun/speedrun_bridge.h"
+
+namespace Scumm {
+
+namespace {
+
+bool readInt(const Common::JSONValue *v, int32 &out) {
+	if (!v || !v->isIntegerNumber())
+		return false;
+	const long long n = v->asIntegerNumber();
+	if (n < -2147483647LL - 1 || n > 2147483647LL)
+		return false;
+	out = (int32)n;
+	return true;
+}
+
+bool parseClick(const Common::JSONValue *value, SpeedrunClick &click, Common::String &error) {
+	if (!value || !value->isObject()) {
+		error = "a click entry must be an object";
+		return false;
+	}
+	const Common::JSONObject &obj = value->asObject();
+	const bool verbForm = obj.size() == 1 && obj.contains("verb");
+	const bool invForm = (obj.size() == 1 && obj.contains("inventory")) ||
+	                     (obj.size() == 2 && obj.contains("inventory") && obj.contains("offset"));
+	if (!verbForm && !invForm) {
+		error = "a click entry must be {\"verb\": id}, {\"inventory\": obj} or {\"inventory\": obj, \"offset\": n}";
+		return false;
+	}
+	click.inventory = invForm;
+	click.offset = 0;
+	if (!readInt(obj.getVal(verbForm ? "verb" : "inventory"), click.value) ||
+	    (obj.contains("offset") && !readInt(obj.getVal("offset"), click.offset))) {
+		error = "click entry values must be integers";
+		return false;
+	}
+	return true;
+}
+
+// A list of dialogue choice substrings: non-empty ASCII strings (docs/plan.md C5).
+bool readChoices(const Common::JSONValue *value, const char *key, Common::Array<Common::String> &out, Common::String &error) {
+	if (!value->isArray()) {
+		error = Common::String::format("'%s' must be an array of strings", key);
+		return false;
+	}
+	for (uint i = 0; i < value->asArray().size(); i++) {
+		const Common::JSONValue *c = value->asArray()[i];
+		bool ascii = c->isString() && !c->asString().empty();
+		for (uint k = 0; ascii && k < c->asString().size(); k++)
+			ascii = (byte)c->asString()[k] < 0x80;
+		if (!ascii) {
+			error = Common::String::format("%s %u must be a non-empty ASCII string (docs/plan.md C5)", key, i);
+			return false;
+		}
+		out.push_back(c->asString());
+	}
+	return true;
+}
+
+bool parseStep(const Common::JSONValue *value, SpeedrunStep &step, Common::String &error) {
+	if (!value || !value->isObject()) {
+		error = "a step must be a JSON object";
+		return false;
+	}
+	const Common::JSONObject &obj = value->asObject();
+	static const char *const kKeys[] = {"action", "verb", "obj", "obj2", "room", "click", "choose", "override_choose",
+	                                    "until", "no_skip"};
+	for (Common::JSONObject::const_iterator it = obj.begin(); it != obj.end(); ++it) {
+		bool known = false;
+		for (const char *key : kKeys)
+			known = known || it->_key == key;
+		if (!known) {
+			error = Common::String::format("unknown key '%s'", it->_key.c_str());
+			return false;
+		}
+	}
+
+	if (!obj.contains("action") || !obj.getVal("action")->isString()) {
+		error = "'action' must be a string";
+		return false;
+	}
+	step.action = obj.getVal("action")->asString();
+
+	static const struct {
+		const char *key;
+		bool SpeedrunStep::*has;
+		int32 SpeedrunStep::*field;
+	} kInts[] = {
+		{"verb", &SpeedrunStep::hasVerb, &SpeedrunStep::verb},
+		{"room", &SpeedrunStep::hasRoom, &SpeedrunStep::room},
+		{"obj", nullptr, &SpeedrunStep::obj},
+		{"obj2", nullptr, &SpeedrunStep::obj2},
+	};
+	for (const auto &f : kInts) {
+		if (!obj.contains(f.key))
+			continue;
+		if (!readInt(obj.getVal(f.key), step.*f.field)) {
+			error = Common::String::format("'%s' must be an integer", f.key);
+			return false;
+		}
+		if (f.has)
+			step.*f.has = true;
+	}
+
+	if (obj.contains("click")) {
+		if (obj.contains("verb") || obj.contains("obj") || obj.contains("obj2")) {
+			error = "a click step has no verb, obj or obj2";
+			return false;
+		}
+		const Common::JSONValue *clicks = obj.getVal("click");
+		if (!clicks->isArray() || clicks->asArray().empty()) {
+			error = "'click' must be a non-empty array";
+			return false;
+		}
+		for (uint i = 0; i < clicks->asArray().size(); i++) {
+			SpeedrunClick click;
+			if (!parseClick(clicks->asArray()[i], click, error)) {
+				error = Common::String::format("click %u: %s", i, error.c_str());
+				return false;
+			}
+			step.clicks.push_back(click);
+		}
+	}
+	if (step.hasVerb && !obj.contains("obj")) {
+		error = "a step with a verb needs an obj";
+		return false;
+	}
+	if (!step.hasVerb && (obj.contains("obj") || obj.contains("obj2"))) {
+		error = "obj/obj2 given without a verb";
+		return false;
+	}
+
+	if (obj.contains("choose") && !readChoices(obj.getVal("choose"), "choose", step.choose, error))
+		return false;
+	if (obj.contains("override_choose")) {
+		if (!readChoices(obj.getVal("override_choose"), "override_choose", step.overrideChoose, error))
+			return false;
+		if (step.overrideChoose.empty()) {
+			error = "'override_choose' must not be empty (omit it instead)";
+			return false;
+		}
+	}
+	if (obj.contains("no_skip")) {
+		const Common::JSONValue *noSkip = obj.getVal("no_skip");
+		if (!noSkip->isBool()) {
+			error = "'no_skip' must be a boolean";
+			return false;
+		}
+		step.noSkip = noSkip->asBool();
+	}
+
+	if (obj.contains("until") && !parseSpeedrunConditionArray(obj.getVal("until"), step.until, error)) {
+		error = "until: " + error;
+		return false;
+	}
+
+	if (!step.hasVerb && step.clicks.empty() && step.choose.empty()) {
+		error = "a step without a verb or click must answer a dialogue (non-empty choose)";
+		return false;
+	}
+	return true;
+}
+
+} // End of anonymous namespace
+
+bool parseSpeedrunPlan(const Common::String &text, Common::Array<SpeedrunStep> &out, Common::String &error) {
+	out.clear();
+	uint lineNo = 0;
+	for (uint pos = 0; pos <= text.size();) {
+		uint end = pos;
+		while (end < text.size() && text[end] != '\n')
+			end++;
+		lineNo++;
+		Common::String line(text.c_str() + pos, end - pos);
+		pos = end + 1;
+		line.trim();
+		if (line.empty())
+			continue;
+
+		Common::JSONValue *root = Common::JSON::parse(line);
+		SpeedrunStep step;
+		Common::String stepError;
+		const bool ok = root ? parseStep(root, step, stepError) : (stepError = "not valid JSON", false);
+		delete root;
+		if (!ok) {
+			error = Common::String::format("line %u: %s", lineNo, stepError.c_str());
+			out.clear();
+			return false;
+		}
+		out.push_back(step);
+	}
+	if (out.empty()) {
+		error = "the plan has no steps";
+		return false;
+	}
+	return true;
+}
+
+bool parseSpeedrunInterrupts(const Common::String &text, Common::Array<SpeedrunInterrupt> &out, Common::String &error) {
+	// [{"name": "map-pirate", "when": [<C3>...], "choose": ["on my way"]}, ...]:
+	// segment.toml `interrupts` without `cite` (src/speedrun/segments.py).
+	out.clear();
+	Common::JSONValue *root = Common::JSON::parse(text);
+	if (!root || !root->isArray()) {
+		delete root;
+		error = "expected a JSON array of {\"name\", \"when\", \"choose\"} objects";
+		return false;
+	}
+	const Common::JSONArray &items = root->asArray();
+	bool ok = true;
+	for (uint i = 0; ok && i < items.size(); i++) {
+		const Common::JSONValue *v = items[i];
+		const bool shape = v->isObject() && v->asObject().size() == 3 && v->asObject().contains("name") &&
+		                   v->asObject().contains("when") && v->asObject().contains("choose");
+		if (!shape) {
+			error = Common::String::format("interrupt %u must have exactly the keys name, when and choose", i);
+			ok = false;
+			break;
+		}
+		const Common::JSONObject &obj = v->asObject();
+		SpeedrunInterrupt it;
+		if (!obj.getVal("name")->isString() || obj.getVal("name")->asString().empty()) {
+			error = Common::String::format("interrupt %u: 'name' must be a non-empty string", i);
+			ok = false;
+			break;
+		}
+		it.name = obj.getVal("name")->asString();
+		for (uint k = 0; k < out.size(); k++) {
+			if (out[k].name == it.name) {
+				error = Common::String::format("interrupt %u: name '%s' is used twice", i, it.name.c_str());
+				ok = false;
+			}
+		}
+		if (ok && !parseSpeedrunConditionArray(obj.getVal("when"), it.when, error)) {
+			error = Common::String::format("interrupt %u (%s): when: %s", i, it.name.c_str(), error.c_str());
+			ok = false;
+		}
+		if (ok && it.when.empty()) {
+			error = Common::String::format("interrupt %u (%s): 'when' must not be empty", i, it.name.c_str());
+			ok = false;
+		}
+		if (ok && !readChoices(obj.getVal("choose"), "choose", it.choose, error)) {
+			error = Common::String::format("interrupt %u (%s): %s", i, it.name.c_str(), error.c_str());
+			ok = false;
+		}
+		if (ok && it.choose.empty()) {
+			error = Common::String::format("interrupt %u (%s): 'choose' must not be empty", i, it.name.c_str());
+			ok = false;
+		}
+		if (ok)
+			out.push_back(it);
+	}
+	delete root;
+	if (!ok)
+		out.clear();
+	return ok;
+}
+
+} // End of namespace Scumm
