+	/** Ego's inventory in display order (findInventory() is 1-based). */
+	Common::Array<int> egoInventory() const;
+	Common::String stateJson() const;
+	Common::String objectsJson();
+	/** Write $SPEEDRUN_OUT/@p name whole (atomically); engine_error if that fails. */
+	bool writeFile(const char *name, const Common::String &contents);
+
+	// Run control
+	/** False if the run failed (timer_next) at the segment start. */
+	bool startSegment();
+	void reachGoal();
+	void maybeReportStall();
+	/** What kept the run from progressing at this decision point (nullptr: nothing). */
+	void setBlocker(const char *reason, int slot = -1, int script = -1);
+	/** Something happened (idle without a blocker, or a step action): restart the stall clock. */
+	void markProgress();
+
+	// Plan player (speedrun_plan.cpp)
+	void loadPlan();
+	void runPlan();
+	bool tryStartStep();
+	/**
+	 * What keeps the active (pending) step from acting (starting) at this
+	 * decision point, named as stall records name it; nullptr if nothing.
+	 */
+	const char *activeStepBlocker() const;
+	const char *pendingStepBlocker() const;
+	void startStep();
+	/** False if the run failed (timer_next) at this step_end. */
+	bool completeStep();
+	void performClick();
+	void answerChoice();
+	/** The step's choose entries in effect: `choose`, plus `override_choose` when its cutscenes play. */
+	uint chooseCount(const SpeedrunStep &st) const;
+	const Common::String &chooseAt(const SpeedrunStep &st, uint i) const;
+	/** Answer the visible menu with @p needle; records a choice (with @p interrupt if set). */
+	bool clickChoice(const Common::String &needle, const char *interrupt);
+	/**
+	 * Called right before an input action (push, click, answer, interrupt).
+	 * True if this frame's input is used up, as it is for a player: Esc was
