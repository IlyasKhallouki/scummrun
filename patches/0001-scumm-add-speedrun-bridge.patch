+#pragma mark - Idle
+
+SpeedrunBridge::IdleState SpeedrunBridge::blocked(const char *reason, int slot, int script) {
+	IdleState s;
+	s.blocker = reason;
+	s.slot = slot;
+	s.script = script;
+	return s;
+}
+
+bool SpeedrunBridge::verbVisible(int slot) const {
+	// The engine's own hit and key tests (verbs.cpp findVerbAtPos/checkExecVerbs).
+	const VerbSlot &v = _vm->_verbs[slot];
+	return v.verbid != 0 && v.saveid == 0 && v.curmode == 1;
+}
+
+bool SpeedrunBridge::anyVisibleVerb(int firstId, int lastId) const {
+	for (int slot = 1; slot < _vm->_numVerbs; slot++) {
+		const int id = _vm->_verbs[slot].verbid;
+		if (id >= firstId && id <= lastId && verbVisible(slot))
+			return true;
+	}
+	return false;
+}
+
+bool SpeedrunBridge::slotCode(int i, const byte *&code, uint32 &size) const {
+	// The code base a slot's offs is relative to (script.cpp
+	// getScriptBaseAddress()), read through the raw resource pointers:
+	// getResourceAddress() would update LRU counters and so change what
+	// expireResources() evicts later.
+	const ScummEngine &e = *_vm;
+	const ScriptSlot &ss = e.vm.slot[i];
+	ResType type = rtInvalid;
+	int idx = -1;
+	switch (ss.where) {
+	case WIO_GLOBAL:
+		type = rtScript;
+		idx = ss.number;
+		break;
+	case WIO_LOCAL:
+	case WIO_ROOM:
+		type = rtRoom; // local, object, entry and exit code all live in the room (script.cpp getScriptBaseAddress)
+		idx = e._roomResource;
+		break;
+	case WIO_INVENTORY:
+		type = rtInventory;
+		for (int k = 0; k < e._numInventory; k++) {
+			if (e._inventory[k] == ss.number)
+				idx = k;
+		}
+		break;
+	case WIO_FLOBJECT: {
+		const int obj = e.getObjectIndex(ss.number);
+		if (obj >= 0) {
+			type = rtFlObject;
+			idx = e._objs[obj].fl_object_index;
+		}
+		break;
+	}
+	default:
+		break;
+	}
+	if (type == rtInvalid || idx < 0 || idx >= (int)e._res->_types[type].size())
+		return false;
+	const ResourceManager::Resource &res = e._res->_types[type][idx];
+	if (!res._address)
+		return false;
+	code = res._address;
+	size = res._size;
+	return true;
+}
+
+bool SpeedrunBridge::slotWaitsForMessage(int i) const {
+	// A script blocked in WaitForMessage() re-executes o5_wait every frame:
+	// o5_wait rewinds _scriptPointer to its own opcode before breakHere()
+	// (script_v5.cpp), so the slot's offs points at "AE 02".
+	const ScriptSlot &ss = _vm->vm.slot[i];
+	const byte *code = nullptr;
+	uint32 size = 0;
+	if (!slotCode(i, code, size) || ss.offs + 1 >= size)
+		return false;
+	return code[ss.offs] == kOpWait && (code[ss.offs + 1] & 0x1F) == kWaitForMessage;
+}
+
+SpeedrunBridge::IdleState SpeedrunBridge::evaluateIdle() const {
+	// "The player could click now" (docs/research/engine-bridge.md §5),
+	// evaluated where checkExecVerbs() has just run.
+	const ScummEngine &e = *_vm;
+
+	if (e._saveLoadFlag)
+		return blocked("saveload");
+	if (e._messageBannerActive)
+		return blocked("banner");
+	if (e._userPut <= 0) // the engine's click gate (verbs.cpp checkExecVerbs)
+		return blocked("userput");
+	if (e.vm.cutSceneStackPointer > 0)
+		return blocked("cutscene");
+
+	const int sentenceScript = e._scummVars[e.VAR_SENTENCE_SCRIPT];
+	const int verbScript = e._scummVars[e.VAR_VERB_SCRIPT];
+
+	// A visible dialogue menu is answerable whenever the engine's click gate
+	// is open, so no text, sentence or object script check applies to it:
+	// menus can stay up under ongoing speech. The circus brothers keep
+	// bickering (local 205) while menu 1 waits for Var[194]
+	// (room-051-circus-te/local-207.txt [01F4]-[03A3]).
+	if (anyVisibleVerb(kDialogVerbFirst, kDialogVerbLast)) {
+		for (int i = 0; i < NUM_SCRIPT_SLOT; i++) {
+			if (e.vm.slot[i].status != ssDead && e.vm.slot[i].number == verbScript)
+				return blocked("input_script", i, verbScript);
+		}
+		IdleState s;
+		s.kind = kIdleDialog;
+		return s;
+	}
+
+	if (e._sentenceNum > 0)
+		return blocked("sentence_queue");
+	for (int i = 0; i < NUM_SCRIPT_SLOT; i++) {
+		const ScriptSlot &ss = e.vm.slot[i];
+		if (ss.status == ssDead)
+			continue;
+		// Same test as checkAndRunSentenceScript() (script.cpp): a frozen
+		// sentence script does not block a new sentence.
+		if (ss.number == sentenceScript && ss.freezeCount == 0)
+			return blocked("sentence_script", i, ss.number);
+		if (ss.number == verbScript)
+			return blocked("input_script", i, ss.number);
+		// Verb scripts of objects can outlive the sentence script.
+		if ((ss.where == WIO_ROOM || ss.where == WIO_INVENTORY || ss.where == WIO_FLOBJECT) &&
+		    ss.number != kScriptNumENCD && ss.number != kScriptNumEXCD)
+			return blocked("object_script", i, ss.number);
+	}
+
+	// Text. Every print goes through actorTalk(), which sets _haveMsg, and
+	// displayDialog() then sets _talkDelay = 60 + VAR_CHARINC per character
+	// (actor.cpp, string.cpp). A blanket "_haveMsg == 0 && _talkDelay <= 0"
+	// would never hold on the island map: global script 24 re-prints a hover
+	// label with print(255, ...) every frame (data/scripts/global/script-024.txt
+	// [0057], [0069]). So text blocks only when something waits for it:
+	// - actor speech: the talking actor (VAR_TALK_ACTOR) is a real actor, which
+	//   print(255) never sets (actorTalk() sets 0xFF);
+	// - a script parked in WaitForMessage(), which also covers non-actor speech
+	//   such as the bar dog (room-028-bar/local-222.txt [001B]-[00B9]) and
+	//   Elaine's close-up lines (global/script-119.txt).
+	// Hover labels and fire-and-forget captions do not block; the engine's own
+	// click gate ignores text as well.
+	const int talker = e._scummVars[e.VAR_TALK_ACTOR];
+	if (talker > 0 && talker < 0x80) {
+		if (e._haveMsg)
+			return blocked("message");
+		if (e._talkDelay > 0)
+			return blocked("talk_delay");
+	}
+	for (int i = 0; i < NUM_SCRIPT_SLOT; i++) {
+		if (e.vm.slot[i].status != ssDead && slotWaitsForMessage(i))
+			return blocked("message", i, e.vm.slot[i].number);
+	}
+
+	// Room transition: _doEffect means the fade-in is still pending this
+	// frame; !_screenEffectFlag means the screen is blanked (gfx.cpp).
+	if (e._doEffect || !e._screenEffectFlag)
+		return blocked("fade");
+
+	const int ego = e._scummVars[e.VAR_EGO];
+	if (ego > 0 && ego < e._numActors) {
+		const Actor *a = e._actors[ego];
+		if (a->isInCurrentRoom() && a->_moving) // o5_wait SO_WAIT_FOR_ACTOR's test
+			return blocked("ego_moving");
+	}
+
+	IdleState s;
+	if (anyVisibleVerb(kActionVerbFirst, kActionVerbLast)) {
+		s.kind = kIdleSentence;
+	} else if (verbScript >= e._numGlobalScripts) {
+		// The room handles clicks with its own local input script and shows
+		// no verb bar: the island map hides the verbs (startScript(17,[1]))
+		// and installs local 201 (room-085-melee/entry.txt [0006], [0055]).
+		s.kind = kIdleSentence;
+	} else {
+		return blocked("no_verbs");
+	}
+	return s;
+}
+
+#pragma mark - Text
+
+bool SpeedrunBridge::verbText(int slot, bool rendered, Common::String &out) const {
+	// What drawVerb() renders (verbs.cpp) is the rtVerb resource expanded by
+	// convertMessageToString(). rtVerb, rtString, rtObjectName and
+	// rtInventory are dynamic resources that are never expired, so reading
+	// them does not perturb a run. An image verb's rtVerb resource holds the
+	// object image instead (setVerbObject(), verbs.cpp), so it has no text.
+	const ResourceManager::Resource &res = _vm->_res->_types[rtVerb][slot];
+	if (!res._address || _vm->_verbs[slot].type == kImageVerbType)
+		return false;
+	if (!rendered) {
+		// The sentence line (verb 100) is built from references, e.g.
+		// Text(getVerb(Var[107]) + ...) in global/script-012.txt [00A3]; its
+		// rendered text ("Walk to ...") would collide with verb 11's name.
+		out = stripEscapes(res._address, res._size);
+		return true;
+	}
+	byte buf[1024];
+	const int len = _vm->convertMessageToString(res._address, buf, sizeof(buf));
+	out = stripEscapes(buf, (uint32)MAX(len, 0));
+	return true;
+}
+
+Common::Array<int> SpeedrunBridge::egoInventory() const {
+	Common::Array<int> items;
+	const int ego = _vm->_scummVars[_vm->VAR_EGO];
+	if (ego > 0) {
+		const int count = _vm->getInventoryCount(ego);
+		for (int i = 1; i <= count; i++)
+			items.push_back(_vm->findInventory(ego, i));
+	}
+	return items;
+}
+
+Common::String SpeedrunBridge::verbJson(int slot, bool rendered) const {
+	const VerbSlot &v = _vm->_verbs[slot];
+	JsonObject j;
+	j.add("slot", slot).add("id", (int)v.verbid);
+	Common::String text; // stays "" for image verbs and empty slots (C6: name is a string)
+	verbText(slot, rendered, text);
+	j.add("name", text)
+	 .add("mode", (int)v.curmode)
+	 .add("saveid", (int)v.saveid)
+	 .add("type", (int)v.type)
+	 .add("key", (int)v.key)
+	 .add("x", (int)v.curRect.left)
+	 .add("y", (int)v.curRect.top);
+	return j.str();
+}
+
+#pragma mark - State dump (C7)
+
+Common::String SpeedrunBridge::stateJson() const {
+	ScummEngine &e = *_vm;
+	const int ego = e._scummVars[e.VAR_EGO];
+	const Actor *egoActor = (ego > 0 && ego < e._numActors) ? e._actors[ego] : nullptr;
+
+	JsonObject s;
+	s.add("tick", _ticks).add("frame", _frames).add("room", (int)e._currentRoom).add("ego", ego);
+	if (egoActor)
+		s.addRaw("ego_pos", pointJson(egoActor->getRealPos().x, egoActor->getRealPos().y));
+	else
+		s.addNull("ego_pos");
+	if (ConfMan.hasKey("random_seed"))
+		s.add("seed", ConfMan.getInt("random_seed"));
+	else
+		s.addNull("seed");
+	s.add("boot_param", e._bootParam);
+
+	JsonArray vars;
+	for (int i = 0; i < e._numVariables; i++)
+		vars.add(e._scummVars[i]);
+	s.addRaw("vars", vars.str());
+
+	JsonArray bits;
+	for (int n = 0; n < e._numBitVariables; n++) {
+		if (e._bitVars[n >> 3] & (1 << (n & 7)))
+			bits.add(n);
+	}
+	s.addRaw("bits_set", bits.str());
+
+	JsonArray inventory;
+	const Common::Array<int> items = egoInventory();
+	for (uint i = 0; i < items.size(); i++)
+		inventory.add(items[i]);
+	s.addRaw("inventory", inventory.str());
+
+	JsonObject owners, states, classes;
+	for (int obj = 1; obj < e._numGlobalObjects; obj++) {
+		const Common::String key = Common::String::format("%d", obj);
+		owners.add(key.c_str(), (int)e._objectOwnerTable[obj]);
+		states.add(key.c_str(), (int)e._objectStateTable[obj]);
+		if (e._classData[obj])
+			classes.addRaw(key.c_str(), classesJson(e._classData[obj]));
+	}
+	s.addRaw("owners", owners.str()).addRaw("states", states.str()).addRaw("classes", classes.str());
+
+	// Objects of the current room (_objs, index 0 unused: object.cpp getObjectIndex).
+	JsonArray roomObjects;
+	for (int i = 1; i < e._numLocalObjects; i++) {
+		const ObjectData &od = e._objs[i];
+		if (!od.obj_nr)
+			continue;
+		JsonObject o;
+		o.add("id", (int)od.obj_nr)
+		 .add("name", withoutAt(e.getObjOrActorName(od.obj_nr)))
+		 .add("state", (int)od.state)
+		 .add("parent", (int)od.parent)
+		 .add("x", (int)od.x_pos)
+		 .add("y", (int)od.y_pos)
+		 .add("w", (int)od.width)
+		 .add("h", (int)od.height)
+		 .addRaw("walk", pointJson(od.walk_x, od.walk_y));
+		roomObjects.add(o);
+	}
+	s.addRaw("room_objects", roomObjects.str());
+
+	JsonArray verbs;
+	for (int slot = 1; slot < e._numVerbs; slot++) {
+		if (verbVisible(slot))
+			verbs.addRaw(verbJson(slot, true));
+	}
+	s.addRaw("verbs", verbs.str());
+
+	// Live script slots: number, where (WIO_*), status (ssRunning/ssPaused), the
+	// PC offset, frozen count and cutscene override count.
+	JsonArray slots;
+	for (int i = 0; i < NUM_SCRIPT_SLOT; i++) {
+		const ScriptSlot &ss = e.vm.slot[i];
+		if (ss.status == ssDead)
+			continue;
+		JsonObject o;
+		o.add("slot", i).add("number", (int)ss.number).add("where", (int)ss.where).add("status", (int)ss.status)
+		 .add("offs", (uint64)ss.offs).add("frozen", (int)ss.freezeCount).add("delay", (int)ss.delay)
+		 .add("cutscene_override", (int)ss.cutsceneOverride);
+		slots.addRaw(o.str());
+	}
+	s.addRaw("slots", slots.str());
+
+	// Actors in the current room: what a click on a person (Give fish to troll) aims at.
+	JsonArray actors;
+	for (int i = 1; i < e._numActors; i++) {
+		const Actor *a = e._actors[i];
+		if (!a || !a->isInCurrentRoom() || !a->_visible)
+			continue;
+		JsonObject o;
+		o.add("id", i).add("x", (int)a->getRealPos().x).add("y", (int)a->getRealPos().y)
+		 .add("elevation", (int)a->getElevation()).add("moving", (int)a->_moving);
+		actors.addRaw(o.str());
+	}
+	s.addRaw("actors", actors.str());
+	return s.str();
+}
+
+#pragma mark - Object dump (C6)
+
+Common::String SpeedrunBridge::objectsJson() {
+	// Every valid room's objects, read from the room data like
+	// resetRoomObjects()/resetRoomObject() do for v5 (object.cpp). Loading
+	// rooms evicts cached resources, so this runs only in the dump-only mode,
+	// which quits right after (docs/research/engine-bridge.md §8).
+	ScummEngine &e = *_vm;
+
+	JsonObject game;
+	game.add("gameid", e._game.gameid).add("variant", e._game.variant).add("version", (int)e._game.version);
+
+	JsonArray verbs;
+	for (int slot = 1; slot < e._numVerbs; slot++) {
+		if (e._verbs[slot].verbid)
+			verbs.addRaw(verbJson(slot, false)); // names, independent of the dump frame
+	}
+
+	JsonArray rooms;
+	for (int r = 1; r < e._numRooms; r++) {
+		const ResourceManager::Resource &res = e._res->_types[rtRoom][r];
+		// Rooms outside the disk's LOFF table would make openRoom() fall back
+		// to askForDisk() and its modal dialog.
+		if (res._roomno == 0 || res._roomoffs == RES_INVALID_OFFSET)
+			continue;
+		// Offset 0: the room is on a disk whose LOFF is not loaded. Multi-disk
+		// releases (DOS floppy: DISKnn.LEC) find it by opening that disk's
+		// file (openRoom(), resource.cpp), so only a missing file is skipped.
+		if (res._roomoffs == 0 && (!(e._game.features & GF_SMALL_HEADER) || !Common::File::exists(e.generateFilename(r))))
+			continue;
+		const byte *room = e.getResourceAddress(rtRoom, r);
+		if (!room)
+			continue;
+
+		// The pointer is only valid until the next room loads: finish this
+		// room before moving on.
+		const RoomHeader *rmhd = (const RoomHeader *)e.findResourceData(MKTAG('R','M','H','D'), room);
+		const int numObjects = rmhd ? READ_LE_UINT16(&rmhd->old.numObjects) : 0;
+		JsonArray objects;
+		const bool small = (e._game.features & GF_SMALL_HEADER) != 0;
+		ResourceIterator obcds(room, small);
+		for (int i = 0; i < numObjects; i++) {
+			const byte *obcd = obcds.findNext(MKTAG('O','B','C','D'));
+			if (!obcd)
+				break;
+			if (small) {
+				// v4 OBCD, as ScummEngine_v4::resetRoomObject() and
+				// getVerbEntrypoint() read it (object.cpp, script.cpp): no
+				// sub-blocks, fixed fields, the name at the offset in byte
+				// 18, the verb table from byte 19.
+				const int id = READ_LE_UINT16(obcd + 6);
+				const bool known = id > 0 && id < e._numGlobalObjects;
+				JsonArray handled;
+				for (const byte *p = obcd + 19; *p; p += 3)
+					handled.add(*p);
+				JsonObject o;
+				o.add("id", id).add("name", withoutAt(obcd + obcd[18]));
+				if (known) {
+					o.add("owner", (int)e._objectOwnerTable[id])
+					 .add("state", (int)e._objectStateTable[id])
+					 .addRaw("classes", classesJson(e._classData[id]));
+				} else {
+					o.addNull("owner").addNull("state").addRaw("classes", "[]");
+				}
+				o.addRaw("walk", pointJson((int16)READ_LE_UINT16(obcd + 13), (int16)READ_LE_UINT16(obcd + 15)))
+				 .add("x", obcd[9] * 8)
+				 .add("y", (obcd[10] & 0x7F) * 8)
+				 .add("w", obcd[11] * 8)
+				 .add("h", obcd[17] & 0xF8)
+				 .add("parent", (int)obcd[12])
+				 .add("parentstate", (obcd[10] & 0x80) ? 1 : 0)
+				 .add("actordir", obcd[17] & 7)
+				 .addRaw("verbs", handled.str());
+				objects.add(o);
+				continue;
+			}
+			const CodeHeader *cdhd = (const CodeHeader *)e.findResourceData(MKTAG('C','D','H','D'), obcd);
+			if (!cdhd)
+				continue;
+			const int id = READ_LE_UINT16(&cdhd->v5.obj_id);
+			const byte *obna = e.findResourceData(MKTAG('O','B','N','A'), obcd);
+			const bool known = id > 0 && id < e._numGlobalObjects;
+
+			JsonArray handled; // VERB block: {byte verb, uint16 offset}..., 0
+			const byte *verb = e.findResource(MKTAG('V','E','R','B'), obcd);
+			if (verb) {
+				const byte *end = verb + READ_BE_UINT32(verb + 4);
+				for (const byte *p = verb + 8; p < end && *p; p += 3)
+					handled.add(*p);
+			}
+
+			JsonObject o;
+			o.add("id", id).add("name", withoutAt(obna));
+			if (known) {
+				o.add("owner", (int)e._objectOwnerTable[id])
+				 .add("state", (int)e._objectStateTable[id])
+				 .addRaw("classes", classesJson(e._classData[id]));
+			} else {
+				o.addNull("owner").addNull("state").addRaw("classes", "[]");
+			}
+			const byte flags = cdhd->v5.flags;
+			o.addRaw("walk", pointJson((int16)READ_LE_UINT16(&cdhd->v5.walk_x), (int16)READ_LE_UINT16(&cdhd->v5.walk_y)))
+			 .add("x", cdhd->v5.x * 8)
+			 .add("y", cdhd->v5.y * 8)
+			 .add("w", cdhd->v5.w * 8)
+			 .add("h", cdhd->v5.h * 8)
+			 .add("parent", (int)cdhd->v5.parent)
+			 .add("parentstate", (flags == 0x80) ? 1 : (int)(flags & 0xF))
+			 .add("actordir", (int)cdhd->v5.actordir)
+			 .addRaw("verbs", handled.str());
+			objects.add(o);
+		}
+
+		JsonObject entry;
+		// ScummVM does not keep v5 room names (RNAM is only logged, resource.cpp).
+		entry.add("room", r).addNull("name").addRaw("objects", objects.str());
+		rooms.add(entry);
+	}
+
+	JsonObject dump;
+	dump.addRaw("game", game.str())
+	    .add("ego", (int)e._scummVars[e.VAR_EGO])
+	    .addRaw("verbs", verbs.str())
+	    .addRaw("rooms", rooms.str());
+	return dump.str();
+}
+
