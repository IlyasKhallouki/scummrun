+	struct OverrideSeen {           // the live override at the current cutscene level
+		int level = -1;
+		uint32 ptr = 0;
+		int slot = -1, number = -1, where = -1, room = -1;
+		bool stale = false;         // its script died or the slot changed hands since
+	} _override;
+	bool _speedCheckPending = false; // a cutscene skip whose var 19 effect is not judged yet
+	uint64 _speedCheckTick = 0;      // the latest cutscene skip, named by timer_next errors
+	int _speedCheckScript = -1;
+
+	// Tick-locked audio (null mixer, --disable-sdl-audio)
+	static const uint kAudioChunkFrames = 512;
+	uint _audioRate = 0;            // mixer output rate, frames per second
+	uint _audioFrameBytes = 4;      // 16-bit stereo
+	double _audioOwed = 0;          // fractional audio frames owed (jiffies are 4 / timer Hz long)
+	uint64 _audioPending = 0;       // whole frames owed to the mixer (< one chunk after pumping)
+	uint64 _audioPumped = 0;        // frames mixed so far
+	int16 _audioBuf[kAudioChunkFrames * 2];
+
+	// SPEEDRUN_VIDEO: a capture of the run at game time, for a video of it. "<prefix>.rgb" gets
+	// the 320x200 screen as RGB24 once per jiffy of the run clock (onWait's quarter-frames / 4),
+	// "<prefix>.pcm" the mixed audio as the pump produces it. Observation only.
+	Common::String _videoPrefix;
+	int _videoFd = -1;              // plain POSIX writes (a FIFO works; DumpFile writes a .tmp and renames)
+	int _audioFd = -1;
+	byte *_videoRgb = nullptr;
+	uint64 _videoQfPending = 0;     // quarter-frames waited but not yet written as video frames
+	void captureFrame(int delta);
+	static int captureOpen(const Common::String &path);   // speedrun_control.cpp (POSIX allowed there)
+	static void captureWrite(int fd, const void *buf, uint32 size);
+	static void captureClose(int fd);
+
+	JsonlWriter _trace;            // $SPEEDRUN_OUT/trace.jsonl, written in place
+	bool _frameLog = false;         // SPEEDRUN_FRAME_LOG
+	Common::String _controlPath;    // SPEEDRUN_CONTROL: Unix socket the controller listens on
+	int _controlFd = -1;
+	Common::String _controlBuf;     // received bytes not yet consumed as lines
+	bool _branchChild = false;      // a fork() made this process: no files, exit on end
+	uint64 _stopFrame = 0, _stopMaxFrame = 0; // the current run command's stops (0 = none)
+	bool _stopOnControl = false;
+	bool _stopOnIdle = false;                    // run "idle": the bridge's idle rule (sentence or dialog)
+	bool _stopOnMenu = false;                    // run "menu": a dialogue menu takes a click
+	SpeedrunConditions _stopUntil;
+	Common::Array<SpeedrunConditions> _stopUntilAny; // run "until_any": any group holds
+	JsonlWriter _frameFile;         // $SPEEDRUN_OUT/frames.jsonl: one line per decision point
+	const char *_errorCode = "engine_error"; // code for the next error() record
+	bool _finished = false;
+};
+
+} // End of namespace Scumm
+
+#endif
