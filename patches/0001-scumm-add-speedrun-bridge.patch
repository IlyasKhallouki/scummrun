+	bool runInterrupt();
+	/** Visible dialogue choices, by verb id, as "id: text" for messages. */
+	Common::String visibleChoices() const;
+	void takeSnapshot();
+	Common::String changesJson() const;
+
+	/** End the run: end record, close the trace, quitGame(). Idempotent. */
+	void finish(const char *reason);
