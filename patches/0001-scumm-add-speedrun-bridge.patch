+
+namespace Scumm {
+
+// Written into every boot record. The test harness also greps the binary for
+// "speedrun-bridge" to tell a patched build from a stock one. Bump the version
+// whenever a change can move run timing: measurements of different bridges
+// are never pooled (speedrun.costing). v2: no plan action in a frame whose
+// input an Esc or a click clear used up (C5 defer).
+static const char kBridgeMarker[] = "speedrun-bridge v3";
+
+static const char kTraceName[] = "trace.jsonl";
+
+// The live bridge, for the error handler (a plain function pointer).
+static SpeedrunBridge *g_speedrunBridge = nullptr;
+
+// Empty counts as unset.
+static const char *envValue(const char *name) {
+	const char *value = getenv(name);
+	return (value && *value) ? value : nullptr;
+}
+
+static bool parseUint64(const char *s, uint64 &out) {
+	if (!s || !*s)
+		return false;
+	const uint64 maxValue = ~(uint64)0;
+	uint64 value = 0;
+	for (; *s; ++s) {
+		if (*s < '0' || *s > '9')
+			return false;
+		const uint64 digit = (uint64)(*s - '0');
+		if (value > (maxValue - digit) / 10)
+			return false;
+		value = value * 10 + digit;
+	}
+	out = value;
+	return true;
+}
+
+#pragma mark - Lifetime
+
+SpeedrunBridge::SpeedrunBridge(ScummEngine *vm) : _vm(vm) {
+	memset(_audioBuf, 0, sizeof(_audioBuf));
+}
+
+SpeedrunBridge *SpeedrunBridge::create(ScummEngine *vm) {
+	const char *outDir = envValue("SPEEDRUN_OUT");
+	if (!outDir)
+		return nullptr;
+
+	SpeedrunBridge *bridge = new SpeedrunBridge(vm);
+	bridge->_outDir = outDir;
+	// Audio files (CD tracks) are decoded from memory, so a fork()ed branch
+	// never shares an open file's read offset with its parent.
+	Audio::SeekableAudioStream::_loadStreamFilesInMemory = true;
+	bridge->readEnv();
+
+	// Replace the engine's default error handler first: it attaches the GUI
+	// debugger, which blocks forever under SDL's dummy video driver.
+	g_speedrunBridge = bridge;
+	Common::setErrorHandler(errorHandler);
+
+	const Common::Path tracePath = Common::Path(bridge->_outDir, Common::Path::kNativeSeparator).appendComponent(kTraceName);
+	if (!bridge->_trace.open(tracePath))
+		error("speedrun: cannot open trace file '%s'", tracePath.toString(Common::Path::kNativeSeparator).c_str());
+
+	if (bridge->_frameLog && !bridge->_frameFile.open(Common::Path(bridge->_outDir, Common::Path::kNativeSeparator).appendComponent("frames.jsonl")))
+		error("speedrun: cannot open frames.jsonl in '%s'", bridge->_outDir.c_str());
+
+	bridge->validateEnv();
+
+	// --disable-sdl-audio is stored in the transient ConfMan domain. Without
+	// it the backend's audio thread pulls the mixer, and we must not.
+	if (ConfMan.getBool("disable_sdl_audio")) {
+		Audio::Mixer *mixer = vm->_mixer;
+		bridge->_audioRate = mixer ? mixer->getOutputRate() : 0;
+		bridge->_audioFrameBytes = (mixer && mixer->getOutputStereo()) ? 4 : 2;
+		bridge->_pumpAudio = bridge->_audioRate > 0;
+	}
+
+	if (!bridge->_videoPrefix.empty()) {
+		const int info = captureOpen(bridge->_videoPrefix + ".txt");
+		if (info >= 0) {
+			const Common::String line = Common::String::format("video 320x200 rgb24 jiffies_per_second %f audio_rate %u frame_bytes %u\n",
+			    vm->getTimerFrequency() / 4.0, bridge->_audioRate, bridge->_audioFrameBytes);
+			captureWrite(info, line.c_str(), line.size());
+			captureClose(info);
+		}
+		bridge->_audioFd = captureOpen(bridge->_videoPrefix + ".pcm");
+		bridge->_videoFd = captureOpen(bridge->_videoPrefix + ".rgb"); // last: opening a FIFO waits for its reader
+		if (bridge->_videoFd < 0 || bridge->_audioFd < 0)
+			error("speedrun: cannot open the SPEEDRUN_VIDEO capture '%s'", bridge->_videoPrefix.c_str());
+	}
+
+	debug(1, "speedrun: %s active, out='%s' fast=%d fast_boot=%d audio_pump=%d rate=%u max_ticks=%s",
+	      kBridgeMarker, bridge->_outDir.c_str(), bridge->_skipWaits, bridge->_fastBoot, bridge->_pumpAudio, bridge->_audioRate,
+	      bridge->_hasMaxTicks ? Common::String::format("%llu", (unsigned long long)bridge->_maxTicks).c_str() : "none");
+	return bridge;
+}
+
+void SpeedrunBridge::readEnv() {
+	// Booleans and integers are validated in validateEnv(), once the trace is
+	// open and an invalid value can be reported there.
+	const char *video = envValue("SPEEDRUN_VIDEO");
+	if (video)
+		_videoPrefix = video;
+	const char *fast = envValue("SPEEDRUN_FAST");
+	if (fast && !Common::parseBool(fast, _skipWaits) && _envError.empty())
+		_envError = Common::String::format("invalid SPEEDRUN_FAST '%s'", fast);
+
+	const char *maxTicks = envValue("SPEEDRUN_MAX_TICKS");
+	if (maxTicks) {
+		_hasMaxTicks = parseUint64(maxTicks, _maxTicks);
+		if (!_hasMaxTicks && _envError.empty())
+			_envError = Common::String::format("invalid SPEEDRUN_MAX_TICKS '%s'", maxTicks);
+	}
+
+	static const struct {
+		const char *name;
+		bool SpeedrunBridge::*flag;
+	} kBoolVars[] = {
+		// Pacing only (skipWaits()): ticks and game logic are the same either way,
+		// so it does not bump kBridgeMarker.
+		{"SPEEDRUN_FAST_BOOT", &SpeedrunBridge::_fastBoot},
+		{"SPEEDRUN_DUMP_OBJECTS", &SpeedrunBridge::_dumpObjects},
+		{"SPEEDRUN_SKIP_TEXT", &SpeedrunBridge::_skipText},
+		{"SPEEDRUN_SKIP_CUTSCENES", &SpeedrunBridge::_skipCutscenes},
+		{"SPEEDRUN_STEP_STATES", &SpeedrunBridge::_stepStates},
+		{"SPEEDRUN_FRAME_LOG", &SpeedrunBridge::_frameLog},
+	};
+	for (const auto &var : kBoolVars) {
+		const char *value = envValue(var.name);
+		if (value && !Common::parseBool(value, this->*var.flag) && _envError.empty())
+			_envError = Common::String::format("invalid %s '%s'", var.name, value);
+	}
+
+	const char *stepTimeout = envValue("SPEEDRUN_STEP_TIMEOUT");
+	if (stepTimeout && !parseUint64(stepTimeout, _stepTimeout) && _envError.empty())
+		_envError = Common::String::format("invalid SPEEDRUN_STEP_TIMEOUT '%s'", stepTimeout);
+
+	// C3 condition lists; ranges are checked in onBoot(), once the game's
+	// variable and object counts are known.
+	static const struct {
+		const char *name;
+		SpeedrunConditions SpeedrunBridge::*list;
+	} kConditionVars[] = {
+		{"SPEEDRUN_START", &SpeedrunBridge::_start},
+		{"SPEEDRUN_GOAL", &SpeedrunBridge::_goal},
+	};
+	for (const auto &var : kConditionVars) {
+		const char *json = envValue(var.name);
+		Common::String error;
+		if (json && !parseSpeedrunConditions(json, this->*var.list, error) && _envError.empty())
+			_envError = Common::String::format("invalid %s: %s", var.name, error.c_str());
+	}
+
+	// Ranges of the `when` conditions are checked in onBoot().
+	const char *interrupts = envValue("SPEEDRUN_INTERRUPTS");
+	if (interrupts) {
+		Common::String error;
+		if (!parseSpeedrunInterrupts(interrupts, _interrupts, error) && _envError.empty())
+			_envError = "invalid SPEEDRUN_INTERRUPTS: " + error;
+	}
+
+	// Read and parsed in onBoot(), once object and variable counts are known.
+	const char *control = envValue("SPEEDRUN_CONTROL");
+	_controlPath = control ? control : "";
+
+	const char *timerNext = envValue("SPEEDRUN_TIMER_NEXT");
+	if (timerNext) {
+		uint64 value = 0;
+		if (!strcmp(timerNext, "any"))
+			_timerNextExpected = -1;
+		else if (parseUint64(timerNext, value) && value < 256)
+			_timerNextExpected = (int32)value;
+		else if (_envError.empty())
+			_envError = Common::String::format("invalid SPEEDRUN_TIMER_NEXT '%s': expected a number or \"any\"", timerNext);
+	}
+
+	const char *startFrame = envValue("SPEEDRUN_START_FRAME");
+	if (startFrame && (!parseUint64(startFrame, _startFrame) || _startFrame == 0) && _envError.empty())
+		_envError = Common::String::format("invalid SPEEDRUN_START_FRAME '%s'", startFrame);
+
+	const char *inputs = envValue("SPEEDRUN_INPUTS");
+	if (inputs) {
+		Common::File f;
+		Common::String error;
+		if (!f.open(Common::FSNode(Common::Path(inputs, Common::Path::kNativeSeparator)))) {
+			if (_envError.empty())
+				_envError = Common::String::format("cannot open SPEEDRUN_INPUTS '%s'", inputs);
+		} else if (!parseSpeedrunInputs(f.readString(0, f.size()), _inputs, error) && _envError.empty()) {
+			_envError = Common::String::format("invalid SPEEDRUN_INPUTS '%s': %s", inputs, error.c_str());
+		}
+	}
+
+	const char *plan = envValue("SPEEDRUN_PLAN");
+	_planPath = plan ? plan : "";
+	_hasPlan = plan != nullptr;
+
+	// {"verb_first": V, "count": N, "var_first": W}: inventory slot verb V+k
+	// shows the object in Var[W+k] (docs/plan.md C1).
+	const char *inventory = envValue("SPEEDRUN_INVENTORY");
+	if (inventory) {
+		Common::JSONValue *root = Common::JSON::parse(inventory);
+		const char *keys[] = {"verb_first", "count", "var_first"};
+		int32 *fields[] = {&_inventory.verbFirst, &_inventory.count, &_inventory.varFirst};
+		bool ok = root && root->isObject() && root->asObject().size() == 3;
+		for (int i = 0; ok && i < 3; i++) {
+			const Common::JSONValue *v = root->asObject().contains(keys[i]) ? root->asObject().getVal(keys[i]) : nullptr;
+			ok = v && v->isIntegerNumber() && v->asIntegerNumber() >= 0 && v->asIntegerNumber() < 0x8000;
+			if (ok)
+				*fields[i] = (int32)v->asIntegerNumber();
+		}
+		delete root;
+		_inventory.valid = ok && _inventory.count > 0;
+		if (!_inventory.valid && _envError.empty())
+			_envError = Common::String::format("invalid SPEEDRUN_INVENTORY '%s': expected {\"verb_first\": int, \"count\": int, \"var_first\": int}", inventory);
+	}
+}
+
+void SpeedrunBridge::validateEnv() {
+	if (!_envError.empty())
+		raiseError("bad_env", _envError);
+}
+
+SpeedrunBridge::~SpeedrunBridge() {
+	// Still running here means the engine quit by itself (e.g. window closed).
+	endTrace("quit", nullptr, nullptr);
+	// The error handler deliberately stays installed (it returns true without
+	// a live bridge): ScummVM has no way to restore the engine's default
+	// handler, and a headless run must never get a message box or debugger.
+	if (g_speedrunBridge == this)
+		g_speedrunBridge = nullptr;
+	captureClose(_videoFd);
+	captureClose(_audioFd);
+	delete[] _videoRgb;
+}
+
+#pragma mark - Hooks
+
+void SpeedrunBridge::onBoot() {
+	if (_finished)
+		return;
+
+	checkConditionRanges(_start, "SPEEDRUN_START", "bad_env");
+	checkConditionRanges(_goal, "SPEEDRUN_GOAL", "bad_env");
+	for (const SpeedrunInterrupt &it : _interrupts)
+		checkConditionRanges(it.when, ("SPEEDRUN_INTERRUPTS " + it.name + " when").c_str(), "bad_env");
+	if (_inventory.valid && _inventory.varFirst + _inventory.count > _vm->_numVariables)
+		raiseError("bad_env", Common::String::format("SPEEDRUN_INVENTORY: vars %d..%d out of range", _inventory.varFirst, _inventory.varFirst + _inventory.count - 1));
+	if (_hasPlan)
+		loadPlan();
+
+	JsonObject rec = record("boot");
+	rec.add("bridge", kBridgeMarker)
+	   .add("game", _vm->_game.gameid)
+	   .add("variant", _vm->_game.variant)
+	   .add("fast", _skipWaits)
+	   .add("fast_boot", _fastBoot)
+	   .add("audio_pump", _pumpAudio)
+	   .add("version", (int)_vm->_game.version)
+	   .add("platform", Common::getPlatformCode(_vm->_game.platform))
+	   // Quarter-frames per second: a jiffy (one tick) lasts 4 / timer_hz s
+	   // (scumm.cpp setTimerAndShakeFrequency(); DOS v4 1193182/5041, v5 and Mac ~240).
+	   .addRaw("timer_hz", Common::String::format("%.9f", _vm->getTimerFrequency()))
+	   .add("timer_next_expected", (int)_timerNextExpected)
+	   .add("raw_inputs", (uint)_inputs.size())
+	   // The MidiDriverFlags bit setupMusic() chose (scumm.cpp): 0 none, 1 PC
+	   // speaker, 2 PCjr, 4 CMS, 8 AdLib, 16 MIDI; sound waits depend on it.
+	   .add("music_type", (int)_vm->_sound->_musicType)
+	   .add("music_driver", ConfMan.hasKey("music_driver") ? ConfMan.get("music_driver") : Common::String("auto"));
+	// --random-seed is stored in the session domain; Common::RandomSource uses
+	// it when the key exists (common/random.cpp).
+	if (ConfMan.hasKey("random_seed"))
+		rec.add("seed", ConfMan.getInt("random_seed"));
+	else
+		rec.addNull("seed");
+	rec.add("boot_param", _vm->_bootParam);
+	writeRecord(rec);
+	if (!_controlPath.empty())
+		controlInit();
+
+	// A save slot from the command line makes go() load a game instead of
+	// running the boot script. Runs never load.
+	if (_vm->_saveLoadFlag != 0) {
+		const Common::String msg = Common::String::format("load requested at boot (flag %d, slot %d)", _vm->_saveLoadFlag, _vm->_saveLoadSlot);
+		_vm->_saveLoadFlag = 0;
+		fail("saveload", msg);
+	}
+}
+
+void SpeedrunBridge::onFrameBegin(int delta) {
+	// This frame's input is unused so far (see onClearClicked()).
+	_inputWindow = false;
+	_escThisFrame = false;
+	_clearsThisFrame = 0;
+	_clearScript = -1;
+	_deferWritten = false;
+	if (_finished)
+		return;
+
+	// 1. Observe the completed previous frame. Records written here carry the
+	//    counters before this frame's delta (C2 stamping rule).
+	observePreviousFrame();
+	if (_finished)
+		return;
+
+	// 2. Advance the run clock to this frame.
+	if (delta > 0)
+		_ticks += (uint64)delta;
+	_frames++;
+
+	// 3. Prepare this frame: pin input, apply the scheduled raw input, press
+	//    '.' or Esc if that has an effect now and no scheduled key took the
+	//    frame (processInput() reads the key later in this frame), then let
+	//    delta jiffies of audio play.
+	neutraliseInput();
+	applyRawInputs();
+	if (_finished)
+		return;
+	maybeInjectSkip(delta);
+	if (_finished)
+		return;
+	_inputWindow = true; // processInput() comes next
+	if (_pumpAudio)
+		pumpAudio(delta);
+
+	// 4. Watchdog, stamped after the add.
+	if (_hasMaxTicks && _ticks >= _maxTicks) {
+		if (_dumpObjects)
+			fail("dump_not_reached", "max_ticks reached before the first idle frame; objects.json not written");
+		else
+			finish("max_ticks");
+	}
+}
+
+void SpeedrunBridge::observePreviousFrame() {
+	// Saving and loading are banned in runs (Alt/Ctrl+digit, autosave). Clear
+	// the request so scummLoop does not perform it on the way out.
+	if (_vm->_saveLoadFlag != 0) {
+		const Common::String msg = Common::String::format("save/load requested (flag %d, slot %d)", _vm->_saveLoadFlag, _vm->_saveLoadSlot);
+		_vm->_saveLoadFlag = 0;
+		fail("saveload", msg);
+		return;
+	}
+
+	// The goal is judged on the state after a whole frame: scripts, the
+	// sentence script, walking and room changes have all run.
+	if (_vm->_currentRoom != _lastRoom) {
+		// Every room change, from boot on: where the run spends its ticks.
+		writeRecord(record("room").add("room", (int)_vm->_currentRoom).add("from", _lastRoom)
+		            .add("var19", _vm->VAR_TIMER_NEXT != 0xFF ? (int)_vm->_scummVars[_vm->VAR_TIMER_NEXT] : -1));
+		_lastRoom = _vm->_currentRoom;
+	}
+
+	if (_segmentStarted && !_goal.empty() && allHold(_goal)) {
+		if (!timerNextChanged("the goal"))
+			reachGoal();
+		return;
+	}
+
+	// After the last step the run waits up to SPEEDRUN_STEP_TIMEOUT for the
+	// goal, counted like a step's wait: from the later of the last step_end
+	// and the segment start, and not before the segment starts.
+	if (_planDone && _segmentStarted && _ticks - MAX(_planDoneTick, _tick0) >= _stepTimeout) {
+		finish("plan_exhausted");
+		return;
+	}
+
+	maybeReportStall();
+}
+
+void SpeedrunBridge::onWait(int quarterFrames) {
+	if (quarterFrames <= 0)
+		return;
+	_quarterFrames += (uint64)quarterFrames;
+	if (_videoFd >= 0) {
+		// The video follows the run clock: one 1/60 s video frame per 4 quarter-frames waited,
+		// showing the screen that is up during the wait.
+		_videoQfPending += (uint64)quarterFrames;
+		const int jiffies = (int)(_videoQfPending / 4);
+		_videoQfPending -= (uint64)jiffies * 4;
+		if (jiffies > 0)
+			captureFrame(jiffies);
+	}
+	// The engine's timer-thread counters (the CD music timer, the speech
+	// timer) advance one step per quarter-frame of game time here, where the
+	// wait happens, instead of on SDL's timer thread in wall time.
+	if (_vm->_sound)
+		_vm->_sound->advanceTimers(quarterFrames);
+}
+
+void SpeedrunBridge::onCDTrack(int track, int numLoops, int startFrame, int duration, bool playing) {
+	if (_finished)
+		return;
+	writeRecord(record("cd_track").add("track", track).add("loops", numLoops).add("start", startFrame)
+	            .add("duration", duration).add("playing", playing).add("room", (int)_vm->_currentRoom));
+}
+
+void SpeedrunBridge::onClearClicked() {
+	// A player's click of this frame lives in _mouseAndKeyboardStat from
+	// processInput() (which also clears _leftBtnPressed's msClicked) until
+	// checkExecVerbs() reads it. clearClickedStatus() in between, e.g. global
+	// 19's doSentence(STOP) at a cutscene's end (script_v5.cpp
+	// o5_doSentence(); global/script-019.txt [0054]), zeroes it: no click of
+	// this frame counts. The plan player acts after checkExecVerbs(), so it
+	// must wait for the next frame too (C5 clicks_cleared, defer).
+	//
+	// Only calls in that stretch count, so only calls from onFrameBegin() to
+	// onDecisionPoint(). Earlier ones (parseEvents() on quit) and later ones
+	// (the fade-in in scummLoop_handleEffects(); the plan player's own input
+	// script runs) come before the click is read or after it was taken. The
+	// window also holds processInput() itself, whose own calls are in
+	// processKeyboard(): the DOS playback prompt (input.cpp) and GUI keys the
+	// bot never presses (it presses only '.' and Esc).
+	if (_finished || !_inputWindow)
+		return;
+	if (_clearsThisFrame++ == 0) {
+		const int cur = _vm->_currentScript;
+		_clearScript = cur != 0xFF ? (int)_vm->vm.slot[cur].number : -1;
+	}
+}
+
+void SpeedrunBridge::onDecisionPoint() {
+	_inputWindow = false; // checkExecVerbs() has run
+	if (_finished)
+		return;
+
+	// Diagnostic for plan runs: this frame's clicks were cleared before
+	// checkExecVerbs() (onClearClicked()).
+	if (_hasPlan && _clearsThisFrame > 0) {
+		JsonObject rec = record("clicks_cleared");
+		if (errorStep() >= 0)
+			rec.add("step", errorStep());
+		rec.add("room", (int)_vm->_currentRoom).add("count", _clearsThisFrame);
+		if (_clearScript >= 0)
+			rec.add("script", _clearScript);
+		writeRecord(rec);
+	}
+
+	// Where checkExecVerbs() has just handled this frame's clicks, so idle
+	// here means "a click now would be taken in this frame".
+	const IdleKind previousKind = _lastIdle.kind;
+	_lastIdle = evaluateIdle();
+	_idleStreak = (_lastIdle.kind == kNotIdle) ? 0 : (_lastIdle.kind == previousKind ? _idleStreak + 1 : 1);
+	if (_frameLog) {
+		const ScummEngine &e = *_vm;
+		JsonObject f;
+		f.add("f", _frames).add("t", _ticks).add("r", (int)e._currentRoom).add("up", (int)e._userPut)
+		 .add("cs", (int)e.vm.cutSceneStackPointer).add("v19", (int)e._scummVars[e.VAR_TIMER_NEXT]);
+		if (_lastIdle.kind != kNotIdle)
+			f.add("idle", _lastIdle.kind == kIdleSentence ? "sentence" : "dialog");
+		else
+			f.add("blk", _lastIdle.blocker ? _lastIdle.blocker : "?").add("scr", _lastIdle.script);
+		const int ego = e._scummVars[e.VAR_EGO];
+		if (ego > 0 && ego < e._numActors && e._actors[ego]->isInCurrentRoom()) {
+			const Actor *a = e._actors[ego];
+			f.addRaw("e", JsonArray().add(a->getRealPos().x).add(a->getRealPos().y).str())
+			 .add("mv", (int)a->_moving).add("box", (int)a->_walkbox);
+		}
+		_frameFile.writeLine(f.str());
+	}
+	if (_lastIdle.kind != kNotIdle && previousKind == kNotIdle) {
+		// The player has control again (sentence or dialogue idle).
+		JsonObject rec = record("control");
+		rec.add("kind", _lastIdle.kind == kIdleSentence ? "sentence" : "dialog").add("room", (int)_vm->_currentRoom);
+		const int ego = _vm->_scummVars[_vm->VAR_EGO];
+		if (ego > 0 && ego < _vm->_numActors && _vm->_actors[ego]->isInCurrentRoom())
+			rec.addRaw("ego_pos", JsonArray().add(_vm->_actors[ego]->getRealPos().x).add(_vm->_actors[ego]->getRealPos().y).str());
+		writeRecord(rec);
+	}
+	// What keeps the run from progressing at this decision point: not being
+	// idle, or (set by the plan player) a pending step that cannot go yet.
+	// Without a plan, any idle frame is progress.
+	_blocker = IdleState();
+	if (_lastIdle.kind == kNotIdle)
+		setBlocker(_lastIdle.blocker, _lastIdle.slot, _lastIdle.script);
+
+	if (_dumpObjects) {
+		// The first idle frame of either kind: verbs exist and objects still
+		// have their game-start owners and states.
+		if (_lastIdle.kind != kNotIdle) {
+			writeFile("objects.json", objectsJson());
+			finish("dump_done");
+		}
+		return;
+	}
+
+	// Control is back with the player after a cutscene skip: every legitimate
+	// var 19 writer has restored it by now (speedrun_skips.cpp).
+	if (_speedCheckPending && _lastIdle.kind != kNotIdle && timerNextChanged("the first idle frame after a cutscene skip"))
+		return;
+
+	if (!_segmentStarted && (_startFrame ? _frames >= _startFrame : (_lastIdle.kind == kIdleSentence && allHold(_start))) &&
+	    !startSegment())
+		return;
+
+	if (_hasPlan && !_finished)
+		runPlan();
+	if (!_blocker.blocker)
+		markProgress();
+	controlAtDecisionPoint();
+}
+
+#pragma mark - Run control
+
+bool SpeedrunBridge::startSegment() {
+	_segmentStarted = true;
+	_tick0 = _ticks;
+	_qf0 = _quarterFrames;
+	writeFile("state-start.json", stateJson());
+	// The speed and key settings skips depend on (docs/research/skips-engine.md
+	// sections 1.1, 5 and 6): var 19 (VAR_TIMER_NEXT) is the frame length in
+	// jiffies; var 37 (VAR_CHARINC) the per-character text delay, 0 at the
+	// maximum talk speed; vars 24 (VAR_CUTSCENEEXIT_KEY) and 57
+	// (VAR_TALKSTOP_KEY) enable Esc and '.'.
+	const int32 *v = _vm->_scummVars;
+	writeRecord(record("segment_start").add("tick0", _tick0).add("room", (int)_vm->_currentRoom)
+	            .add("var19", (int)v[_vm->VAR_TIMER_NEXT]).add("var37", (int)v[_vm->VAR_CHARINC])
+	            .add("var24", (int)v[_vm->VAR_CUTSCENEEXIT_KEY]).add("var57", (int)v[_vm->VAR_TALKSTOP_KEY]));
+	return !timerNextChanged("the segment start");
+}
+
+void SpeedrunBridge::reachGoal() {
+	writeFile("state-end.json", stateJson());
+	writeRecord(record("goal").add("ticks_from_start", _ticks - _tick0).add("qf_from_start", _quarterFrames - _qf0));
+	finish("goal");
+}
+
+void SpeedrunBridge::setBlocker(const char *reason, int slot, int script) {
+	_blocker.blocker = reason;
+	_blocker.slot = slot;
+	_blocker.script = script;
+}
+
+void SpeedrunBridge::markProgress() {
+	_progressTick = _ticks;
+	_stallReported = false;
+}
+
+void SpeedrunBridge::maybeReportStall() {
+	// Diagnostic only: name what kept the run from progressing (not idle, or
+	// idle but the pending step's `until` does not hold, ...) once that has
+	// lasted kStallTicks, then again every kStallTicks.
+	static const uint64 kStallTicks = 3600; // one minute of game time
+	if (!_blocker.blocker)
+		return;
+	const uint64 since = _stallReported ? _stallTick : _progressTick;
+	if (_ticks - since < kStallTicks)
+		return;
+	JsonObject rec = record("stall");
+	rec.add("reason", _blocker.blocker);
+	if (_blocker.slot >= 0)
+		rec.add("slot", _blocker.slot).add("script", _blocker.script);
+	if (errorStep() >= 0)
+		rec.add("step", errorStep());
+	rec.add("room", (int)_vm->_currentRoom).add("not_idle_ticks", _ticks - _progressTick);
+	const int ego = _vm->_scummVars[_vm->VAR_EGO];
+	if (ego > 0 && ego < _vm->_numActors && _vm->_actors[ego]->isInCurrentRoom()) {
+		const Actor *a = _vm->_actors[ego];
+		rec.addRaw("ego_pos", JsonArray().add(a->getRealPos().x).add(a->getRealPos().y).str()).add("ego_box", (int)a->_walkbox);
+	}
+	writeRecord(rec);
+	_stallTick = _ticks;
+	_stallReported = true;
+}
+
+bool SpeedrunBridge::writeFile(const char *name, const Common::String &contents) {
+	if (_branchChild)
+		return true;
+	const Common::Path path = Common::Path(_outDir, Common::Path::kNativeSeparator).appendComponent(name);
+	const bool ok = writeJsonFile(path, contents);
+	if (!ok)
+		raiseError("engine_error", Common::String::format("cannot write %s in '%s'", name, _outDir.c_str()));
+	return ok;
+}
+
+#pragma mark - Infrastructure
+
+void SpeedrunBridge::neutraliseInput() {
+	// Undo everything parseEvents() may have written since the last frame, so
+	// a visible run is tick-identical to a headless one. processInput()
+	// derives _virtualMouse and _mouseAndKeyboardStat from these.
+	_vm->_mouse.x = 0;
+	_vm->_mouse.y = 0;
+	_vm->_leftBtnPressed = 0;
+	_vm->_rightBtnPressed = 0;
+	_vm->_keyPressed.reset();
+	_vm->_fastMode = 0;
+}
+
+void SpeedrunBridge::pumpAudio(int delta) {
+	if (delta <= 0)
+		return;
+
+	// Frames owed for delta jiffies of 4 / timer Hz each: 1/60 s on Mac and
+	// DOS v5, 1/59.17 s on DOS v4 (scumm.cpp setTimerAndShakeFrequency()).
+	// Deterministic: the same deltas always give the same frames.
+	_audioOwed += (double)delta * _audioRate * 4.0 / _vm->getTimerFrequency();
+	const uint64 whole = (uint64)_audioOwed;
+	_audioPending += whole;
+	_audioOwed -= (double)whole;
+
+	// Fixed-size calls: the stream sees the same buffer sizes whatever the
+	// frame pacing; leftover frames wait for the next frame.
+	// The cast is valid: every backend mixer manager, the null one included,
+	// creates an Audio::MixerImpl.
+	Audio::MixerImpl *mixer = static_cast<Audio::MixerImpl *>(_vm->_mixer);
+	const uint chunkBytes = kAudioChunkFrames * _audioFrameBytes;
+	while (_audioPending >= kAudioChunkFrames) {
+		mixer->mixCallback((byte *)_audioBuf, chunkBytes);
+		if (_audioFd >= 0)
+			captureWrite(_audioFd, _audioBuf, chunkBytes);
+		_audioPending -= kAudioChunkFrames;
+		_audioPumped += kAudioChunkFrames;
+	}
+}
+
+void SpeedrunBridge::captureFrame(int delta) {
+	const int w = 320, h = 200;
+	if (!_videoRgb)
+		_videoRgb = new byte[w * h * 3];
+	memset(_videoRgb, 0, w * h * 3);
+	Graphics::Surface *screen = g_system->lockScreen();
+	if (screen) {
+		const bool clut = screen->format.bytesPerPixel == 1;
+		byte pal[256 * 3];
+		if (clut)
+			g_system->getPaletteManager()->grabPalette(pal, 0, 256);
+		const int cw = MIN<int>(w, screen->w), ch = MIN<int>(h, screen->h);
+		for (int y = 0; y < ch; y++) {
+			for (int x = 0; x < cw; x++) {
+				byte *d = _videoRgb + (y * w + x) * 3;
+				if (clut) {
+					const byte c = *(const byte *)screen->getBasePtr(x, y);
+					d[0] = pal[c * 3];
+					d[1] = pal[c * 3 + 1];
+					d[2] = pal[c * 3 + 2];
+				} else {
+					screen->format.colorToRGB(screen->getPixel(x, y), d[0], d[1], d[2]);
+				}
+			}
+		}
+		g_system->unlockScreen();
+	}
+	for (int i = 0; i < delta; i++)
+		captureWrite(_videoFd, _videoRgb, w * h * 3);
+}
+
+void SpeedrunBridge::finish(const char *reason) {
+	if (endTrace(reason, nullptr, nullptr))
+		_vm->quitGame();
+}
+
+void SpeedrunBridge::fail(const char *code, const Common::String &message) {
+	if (endTrace("error", code, message.c_str()))
+		_vm->quitGame();
+}
+
+int SpeedrunBridge::errorStep() const {
+	return (!_plan.empty() && !_planDone) ? (int)_stepIndex : -1;
+}
+
+void SpeedrunBridge::raiseError(const char *code, const Common::String &message) {
+	_errorCode = code;
+	error("speedrun: %s", message.c_str());
+}
+
+bool SpeedrunBridge::endTrace(const char *reason, const char *errorCode, const char *errorMessage) {
+	if (_finished)
+		return false;
+	// Set first: nothing is written after the end record, even if writing
+	// it re-enters through error().
+	_finished = true;
+
+	if (errorCode) {
+		JsonObject err = record("error");
+		if (errorStep() >= 0)
+			err.add("step", errorStep());
+		err.add("code", errorCode).add("message", errorMessage);
+		writeRecord(err);
+	}
+
+	// Fingerprint of the final state; determinism tests compare whole end
+	// records. Vars may not exist yet if error() fires during init().
+	const bool haveVars = _vm->_scummVars != nullptr;
+	JsonObject end = record("end");
+	end.add("reason", reason)
+	   .add("room", (int)_vm->_currentRoom)
+	   .add("audio_frames", _audioPumped);
+	if (haveVars && _vm->VAR_MUSIC_TIMER != 0xFF)
+		end.add("music_timer", (int)_vm->_scummVars[_vm->VAR_MUSIC_TIMER]);
+	else
+		end.addNull("music_timer");
+	if (haveVars)
+		end.add("vars_fnv1a", varsFingerprint());
+	else
+		end.addNull("vars_fnv1a");
+	writeRecord(end);
+	if (!_branchChild)
+		_trace.close();
+	controlEnd(end);
+	if (_frameLog)
+		_frameFile.close();
+
+	debug(1, "speedrun: %s", end.str().c_str());
+	return true;
+}
+
+bool SpeedrunBridge::errorHandler(const char *msg) {
+	// Not synchronised with the main thread. That is fine for runs: with
+	// --disable-sdl-audio the mixer runs on the main thread (pumpAudio), so
+	// error() can only come from the main thread.
+	SpeedrunBridge *bridge = g_speedrunBridge;
+	if (bridge) {
+		// error() appends "!\n"; the newline is noise in a JSON string.
+		Common::String text(msg ? msg : "");
+		while (!text.empty() && (text.lastChar() == '\n' || text.lastChar() == '\r'))
+			text.deleteLastChar();
+		bridge->endTrace("error", bridge->_errorCode, text.c_str());
+	}
+	// Always handled, even after the bridge is gone: the message already went
+	// to the log, and a message box or the debugger would block a headless
+	// run. error() then exits.
+	return true;
+}
+
+#pragma mark - Trace
+
+JsonObject SpeedrunBridge::record(const char *type) const {
+	JsonObject rec;
+	rec.add("type", type).add("tick", _ticks).add("frame", _frames).add("qf", _quarterFrames);
+	return rec;
+}
+
+void SpeedrunBridge::writeRecord(const JsonObject &rec) {
+	if (_branchChild)
+		return; // branches report over the control socket only
+	_trace.writeLine(rec.str()); // flushed: a killed run keeps every record so far
+}
+
+Common::String SpeedrunBridge::varsFingerprint() const {
+	uint32 hash = 2166136261u; // FNV-1a 32 offset basis
+	for (int i = 0; i < _vm->_numVariables; i++) {
+		const uint32 value = (uint32)_vm->_scummVars[i];
+		for (int shift = 0; shift < 32; shift += 8) {
+			hash ^= (value >> shift) & 0xFF;
+			hash *= 16777619u; // FNV prime
+		}
+	}
+	return Common::String::format("%08x", hash);
+}
+
+} // End of namespace Scumm
