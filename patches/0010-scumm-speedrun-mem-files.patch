+void SpeedrunBridge::setMemFile(const Common::String &name, const byte *data, uint32 size) {
+	for (uint i = 0; i < _memFileList.size(); i++) {
+		if (_memFileList[i].name == name) {
+			_memFileList[i].data.resize(size);
+			if (size)
+				memcpy(_memFileList[i].data.data(), data, size);
+			return;
+		}
+	}
+	MemFile f;
+	f.name = name;
+	f.data.resize(size);
+	if (size)
+		memcpy(f.data.data(), data, size);
+	_memFileList.push_back(f);
+}
+
+const Common::Array<byte> *SpeedrunBridge::memFile(const Common::String &name) const {
+	for (uint i = 0; i < _memFileList.size(); i++)
+		if (_memFileList[i].name == name)
+			return &_memFileList[i].data;
+	return nullptr;
+}
