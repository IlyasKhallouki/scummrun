@@ -1624,6 +1624,33 @@
 //
 ////////////////////////////////////////
 
+// E020: with the speedrun bridge's SPEEDRUN_IMUSE_TICKS=1, the sequencer ticks by game time. The drivers' timers
+// (the mixer's, in wall time) are detached at the first call; each driver then gets one on_timer per base tempo of
+// game time, as its timer would give it when the game runs in real time.
+void IMuseInternal::speedrunAdvance(double usec) {
+	TimerCallbackInfo *infos[2] = { &_timer_info_native, &_timer_info_adlib };
+	if (!_speedrunDetached) {
+		for (int i = 0; i < 2; i++) {
+			if (infos[i]->driver)
+				infos[i]->driver->setTimerCallback(nullptr, nullptr);
+		}
+		_speedrunDetached = true;
+	}
+	for (int i = 0; i < 2; i++) {
+		MidiDriver *d = infos[i]->driver;
+		if (!d)
+			continue;
+		const uint32 base = d->getBaseTempo();
+		if (!base)
+			continue;
+		_speedrunUsec[i] += usec;
+		while (_speedrunUsec[i] >= base) {
+			_speedrunUsec[i] -= base;
+			on_timer(d);
+		}
+	}
+}
