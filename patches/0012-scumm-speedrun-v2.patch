+#pragma mark - E028: the input script and verb screen of SCUMM v1-v2 (patch 0012)
+
+namespace {
+
+// ScummEngine_v2's verb screen boxes, _mouseOverBoxesV2 (verbs.cpp:36-39, initV2MouseOver()): 0-3 the inventory
+// boxes, then the two scroll arrows and the sentence line.
+const int kV2Boxes = 4, kV2UpArrow = 4, kV2DownArrow = 5, kV2SentenceLine = 6;
+// The ids uiSlots() gives, past v2's one-byte verb ids (o2_verbOps): the sentence line, the boxes, the arrows.
+const int kUiSentenceId = 256, kUiBoxId = 257, kUiUpId = 261, kUiDownId = 262;
+
+} // End of anonymous namespace
+
+bool SpeedrunBridge::v12() const {
+	// The games whose clicks ScummEngine_v2::checkExecVerbs() dispatches (v0 has its own, verbs.cpp
+	// ScummEngine_v0::checkExecVerbs())
+	return _vm->_game.version >= 1 && _vm->_game.version <= 2;
+}
+
+int SpeedrunBridge::egoInventoryAt(int idx) const {
+	// findInventory(VAR_EGO, idx) (object.cpp), read from the tables themselves: its getOwner() is the input log's
+	// read hook. 0 past the last object; with @p idx 0, the count of objects (getInventoryCount(VAR_EGO)).
+	const ScummEngine &e = *_vm;
+	const int ego = e._scummVars[e.VAR_EGO];
+	int count = 0;
+	for (int i = 0; i < e._numInventory; i++) {
+		const int obj = e._inventory[i];
+		if (obj && e._objectOwnerTable[obj] == ego && ++count == idx)
+			return obj;
+	}
+	return idx ? 0 : count;
+}
+
+bool SpeedrunBridge::v2ArrowTurns(int down) const {
+	// What a click on scroll arrow 0 (up) or 1 (down) does: turn the page, under checkV2Inventory()'s tests
+	// (verbs.cpp:413-423), which are redrawV2Inventory()'s for drawing the arrow (the offset moves by 2)
+	const ScummEngine_v2 &e = *static_cast<const ScummEngine_v2 *>(_vm);
+	if (!down)
+		return e._inventoryOffset >= 2;
+	const int shown = e._game.platform == Common::kPlatformNES ? 2 : 4;
+	return e._inventoryOffset + shown < egoInventoryAt(0);
+}
+
+int SpeedrunBridge::inputScript() const {
+	const ScummEngine &e = *_vm;
+	return e._game.version <= 2 ? 4 : e._scummVars[e.VAR_VERB_SCRIPT];
+}
+
+int SpeedrunBridge::sentenceScript() const {
+	const ScummEngine &e = *_vm;
+	return e._game.version <= 2 ? 2 : e._scummVars[e.VAR_SENTENCE_SCRIPT];
+}
+
+Common::Array<SpeedrunBridge::UiSlot> SpeedrunBridge::uiSlots() const {
+	Common::Array<UiSlot> out;
+	if (!v12())
+		return out;
+	const ScummEngine_v2 &e = *static_cast<const ScummEngine_v2 *>(_vm);
+	const int top = e._virtscr[kVerbVirtScreen].topline;
+	const int base = e._numVerbs;
+	// The sentence line while drawSentence() draws it (string.cpp ScummEngine_v2::drawSentence()), named by the
+	// variables it is drawn from: verb, first object, preposition, second object (ids, no text)
+	if ((e._userState & USERSTATE_IFACE_SENTENCE) ||
+	    (e._game.platform == Common::kPlatformNES && (e._userState & USERSTATE_IFACE_ALL))) {
+		const Common::Rect &r = e._mouseOverBoxesV2[kV2SentenceLine].rect;
+		UiSlot s;
+		s.slot = base;
+		s.id = kUiSentenceId;
+		s.x = r.left;
+		s.y = r.top + top;
+		s.name = Common::String::format("%d %d %d %d", e._scummVars[e.VAR_SENTENCE_VERB], e._scummVars[e.VAR_SENTENCE_OBJECT1],
+		                                e._scummVars[e.VAR_SENTENCE_PREPOSITION], e._scummVars[e.VAR_SENTENCE_OBJECT2]);
+		out.push_back(s);
+	}
+	// The inventory while redrawV2Inventory() draws it: each box whose click gives an object (checkV2Inventory():
+	// findInventory(ego, k + 1 + _inventoryOffset)), named "#" and the object's id, the name an image verb has
+	// (verbText()); then each arrow whose click turns the page
+	if (e._userState & USERSTATE_IFACE_INVENTORY) {
+		for (int k = 0; k < kV2Boxes; k++) {
+			const int obj = egoInventoryAt(k + 1 + e._inventoryOffset);
+			if (obj <= 0)
+				continue;
+			const Common::Rect &r = e._mouseOverBoxesV2[k].rect;
+			UiSlot s;
+			s.slot = base + 1 + k;
+			s.id = kUiBoxId + k;
+			s.x = r.left;
+			s.y = r.top + top;
+			s.name = Common::String::format("#%08x", (uint32)obj);
+			out.push_back(s);
+		}
+		for (int d = 0; d < 2; d++) {
+			if (!v2ArrowTurns(d))
+				continue;
+			const Common::Rect &r = e._mouseOverBoxesV2[d ? kV2DownArrow : kV2UpArrow].rect;
+			UiSlot s;
+			s.slot = base + 1 + kV2Boxes + d;
+			s.id = d ? kUiDownId : kUiUpId;
+			s.x = r.left;
+			s.y = r.top + top;
+			out.push_back(s);
+		}
+	}
+	return out;
+}
+
+int SpeedrunBridge::hitSlot(int x, int y) const {
+	if (!v12())
+		return _vm->findVerbAtPos(x, y);
+	// ScummEngine_v2::checkExecVerbs()'s mouse branch (verbs.cpp:758-784), with the screen point for _mouse
+	const ScummEngine_v2 &e = *static_cast<const ScummEngine_v2 *>(_vm);
+	VirtScreen *zone = _vm->findVirtScreen(y);
+	if (!zone)
+		return 0;
+	const int inventoryArea = e._game.platform == Common::kPlatformNES ? 48 : 32;
+	if (zone->number == kVerbVirtScreen && y <= zone->topline + 8)
+		return 0; // the sentence line: runInputScript(kSentenceClickArea, 0, 0), no verb
+	if (zone->number == kVerbVirtScreen && y >= zone->topline + inventoryArea) {
+		// checkV2Inventory()'s tests (verbs.cpp:403-435) in its order, without its page turn
+		const int vy = y - zone->topline;
+		if (e._mouseOverBoxesV2[kV2UpArrow].rect.contains(x, vy)) {
+			if (v2ArrowTurns(0))
+				return e._numVerbs + 1 + kV2Boxes;
+		} else if (e._mouseOverBoxesV2[kV2DownArrow].rect.contains(x, vy)) {
+			if (v2ArrowTurns(1))
+				return e._numVerbs + 1 + kV2Boxes + 1;
+		}
+		for (int k = 0; k < kV2Boxes; k++) {
+			if (e._mouseOverBoxesV2[k].rect.contains(x, vy))
+				return egoInventoryAt(k + 1 + e._inventoryOffset) > 0 ? e._numVerbs + 1 + k : 0;
+		}
+		return 0;
+	}
+	return _vm->findVerbAtPos(x, y);
+}
+
+int SpeedrunBridge::actorElevation(const Actor *a) const {
+	// Actor_v2::prepareDrawActorCostume() (actor.cpp) draws at (_pos.y - _elevation) * V12_Y_MULTIPLIER on v1-v2
+	return _vm->_game.version <= 2 ? a->getElevation() * V12_Y_MULTIPLIER : a->getElevation();
+}
