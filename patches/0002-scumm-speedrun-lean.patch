+class SpeedrunBytes {
+public:
+	SpeedrunBytes() {}
+	~SpeedrunBytes() { free(_data); }
+	SpeedrunBytes(const SpeedrunBytes &) = delete;
+	SpeedrunBytes &operator=(const SpeedrunBytes &) = delete;
+	void clear() { _size = 0; }
