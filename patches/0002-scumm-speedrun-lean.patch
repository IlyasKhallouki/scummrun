+#pragma mark - Framing
+
+void SpeedrunBridge::wireSendAll(const byte *p, uint32 left) {
+	while (left > 0) {
+		const ssize_t n = send(_controlFd, p, left, MSG_NOSIGNAL);
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			_exit(3); // the controller is gone: nothing left to report to
+		}
+		p += n;
+		left -= (uint32)n;
+	}
+}
+
+void SpeedrunBridge::wireBegin(uint8 type) {
+	_wireOut.clear();
+	_wireOut.u32(0);
+	_wireOut.u8(type);
+}
+
+void SpeedrunBridge::wireFlush() {
+	if (_controlFd < 0)
+		return;
+	_wireOut.setU32(0, _wireOut.size() - 5);
+	wireSendAll(_wireOut.data(), _wireOut.size());
+}
+
+bool SpeedrunBridge::wireRead(uint8 &type, uint32 &len) {
+	// The message starts at _wireIn's first byte; the caller consumes it (5 + len bytes) when done with it.
+	uint32 need = 5;
+	for (;;) {
+		if (_wireIn.size() >= 5) {
+			len = READ_LE_UINT32(_wireIn.data());
+			if (len > kMaxMessage)
+				return false;
+			need = 5 + len;
+			if (_wireIn.size() >= need) {
+				type = _wireIn.data()[4];
+				return true;
+			}
+		}
+		const uint32 at = _wireIn.size();
+		const uint32 chunk = MAX<uint32>(need - at, 65536);
+		byte *dst = _wireIn.grow(chunk);
+		const ssize_t n = recv(_controlFd, dst, chunk, 0);
+		if (n < 0 && errno == EINTR) {
+			_wireIn.truncate(at);
+			continue;
+		}
+		if (n <= 0)
+			return false;
+		_wireIn.truncate(at + (uint32)n);
+	}
+}
+
+void SpeedrunBridge::wireHello() {
+	wireBegin(kRHello);
+	_wireOut.u32((uint32)getpid());
+	_wireOut.u32(_branchChild ? (uint32)getppid() : 0);
+	_wireOut.u64(_frames);
+	_wireOut.u64(_ticks);
+	wireFlush();
+}
+
+void SpeedrunBridge::wireEnd(const char *reason) {
+	if (_controlFd < 0)
+		return;
+	wireBegin(kREnd);
+	wireStatus(_wireOut, reason, true);
+	wireFlush();
+	if (_branchChild)
+		_exit(0); // a branch never runs the engine's shutdown (SDL state belongs to the root)
+}
+
+#pragma mark - Encoders
+
+void SpeedrunBridge::wireStatus(SpeedrunBytes &o, const char *reason, bool ended) const {
+	// fmi-core Status, field for field as controlStatus() writes them. An end carries the end record's frame, tick,
+	// qf and room, and the children a fork_each made before it (so the controller can quit them); the rest is left
+	// at its default (the JSON "end" reply has none of it).
+	const ScummEngine &e = *_vm;
+	o.str(reason);
+	o.b(ended);
+	o.u64(_frames);
+	o.u64(_ticks);
+	o.u64(_quarterFrames);
+	if (ended) {
+		o.u64(0);                        // qf0
+		o.i32((int)e._currentRoom);      // room
+		for (int i = 0; i < 4; i++)
+			o.i32(0);                    // up, cur, cs, v19
+		o.b(false);                      // seg
+		o.u64(0);                        // tick0
+		o.u64(0);                        // rng
+		for (int i = 0; i < 5; i++)
+			o.u8(0);                     // idle, blk, ego, mv, box
+		for (int i = 0; i < 3; i++)
+			o.i32(0);                    // cam, xstart, room_w
+		o.u32(_forkEachForks.size() / 2);
+		for (uint i = 0; i + 1 < _forkEachForks.size(); i += 2) {
+			o.u64((uint64)(int64)(int)_forkEachForks[i]);
+			o.u32((uint32)(int)_forkEachForks[i + 1]);
+		}
+		return;
+	}
+	o.u64(_qf0);
+	o.i32((int)e._currentRoom);
+	o.i32((int)e._userPut);
+	o.i32((int)e._cursor.state);
+	o.i32((int)e.vm.cutSceneStackPointer);
+	o.i32((int)e._scummVars[e.VAR_TIMER_NEXT]);
+	o.b(_segmentStarted);
+	o.u64(_tick0);
+	o.u64((uint64)e._rnd.getSeed());
+	if (_lastIdle.kind != kNotIdle) {
+		o.u8(1);
+		o.str(_lastIdle.kind == kIdleSentence ? "sentence" : "dialog");
+		o.u8(0);
+	} else {
+		o.u8(0);
+		o.u8(1);
+		o.str(_lastIdle.blocker ? _lastIdle.blocker : "?");
+	}
+	const int ego = e._scummVars[e.VAR_EGO];
+	if (ego > 0 && ego < e._numActors && e._actors[ego]->isInCurrentRoom()) {
+		const Actor *a = e._actors[ego];
+		o.u8(1);
+		o.i32(a->getRealPos().x);
+		o.i32(a->getRealPos().y);
+		o.u8(1);
+		o.i32((int)a->_moving);
+		o.u8(1);
+		o.i32((int)a->_walkbox);
+	} else {
+		o.u8(0);
+		o.u8(0);
+		o.u8(0);
+	}
+	o.i32((int)e.camera._cur.x);
+	o.i32((int)e._virtscr[kMainVirtScreen].xstart);
+	o.i32((int)e._roomWidth);
+	o.u32(_forkEachForks.size() / 2);
+	for (uint i = 0; i + 1 < _forkEachForks.size(); i += 2) {
+		o.u64((uint64)(int64)(int)_forkEachForks[i]); // the JSON array's int
+		o.u32((uint32)(int)_forkEachForks[i + 1]);
+	}
+}
+
+void SpeedrunBridge::wireObs(SpeedrunBytes &o, const Common::Array<int> *objects, bool names, bool exact) const {
+	// fmi-core Obs: stateJson() (objects null) or stateLiteJson(*objects), field for field in Obs's order. Names only
+	// with @p names; the exact object with @p exact on a full dump.
+	ScummEngine &e = *_vm;
+	const int ego = e._scummVars[e.VAR_EGO];
+	const Actor *egoActor = (ego > 0 && ego < e._numActors) ? e._actors[ego] : nullptr;
+	o.u64(_ticks);
+	o.u64(_frames);
+	o.i32((int)e._currentRoom);
+	o.u8(1);
+	o.i32(ego);
+	if (egoActor) {
+		o.u8(1);
+		o.i32(egoActor->getRealPos().x);
+		o.i32(egoActor->getRealPos().y);
+	} else {
+		o.u8(0);
+	}
+	if (ConfMan.hasKey("random_seed")) {
+		o.u8(1);
+		o.i64((int64)ConfMan.getInt("random_seed"));
+	} else {
+		o.u8(0);
+	}
+	o.i32(e._bootParam);
+	o.u32(e._numVariables);
+	for (int i = 0; i < e._numVariables; i++)
+		o.i32(e._scummVars[i]);
+	{
+		const uint32 at = o.size();
+		o.u32(0);
+		uint32 n = 0;
+		for (int b = 0; b < e._numBitVariables; b++) {
+			if (e._bitVars[b >> 3] & (1 << (b & 7))) {
+				o.u32(b);
+				n++;
+			}
+		}
+		o.setU32(at, n);
+	}
+	if (objects) {
+		o.u8(0); // no inventory in a lite dump
+	} else {
+		const Common::Array<int> items = egoInventory();
+		o.u8(1);
+		o.u32(items.size());
+		for (uint i = 0; i < items.size(); i++)
+			o.i32(items[i]);
+	}
+	// owners, states, classes: every object, or the asked ones in their order (stateLiteJson's loop)
+	Common::Array<int> all;
+	if (!objects) {
+		for (int obj = 1; obj < e._numGlobalObjects; obj++)
+			all.push_back(obj);
+	}
+	const Common::Array<int> &objs = objects ? *objects : all;
+	uint32 valid = 0;
+	for (uint k = 0; k < objs.size(); k++)
+		valid += (objs[k] >= 1 && objs[k] < e._numGlobalObjects) ? 1 : 0;
+	o.u32(valid);
+	for (uint k = 0; k < objs.size(); k++) {
+		const int obj = objs[k];
+		if (obj >= 1 && obj < e._numGlobalObjects) {
+			o.u32(obj);
+			o.i32((int)e._objectOwnerTable[obj]);
+		}
+	}
+	o.u32(valid);
+	for (uint k = 0; k < objs.size(); k++) {
+		const int obj = objs[k];
+		if (obj >= 1 && obj < e._numGlobalObjects) {
+			o.u32(obj);
+			o.i32((int)e._objectStateTable[obj]);
+		}
+	}
+	{
+		const uint32 at = o.size();
+		o.u32(0);
+		uint32 n = 0;
+		for (uint k = 0; k < objs.size(); k++) {
+			const int obj = objs[k];
+			if (obj < 1 || obj >= e._numGlobalObjects || !e._classData[obj])
+				continue;
+			o.u32(obj);
+			const uint32 bits = e._classData[obj];
+			uint32 c = 0;
+			for (int bit = 0; bit < 32; bit++)
+				c += (bits & (1u << bit)) ? 1 : 0;
+			o.u32(c);
+			for (int bit = 0; bit < 32; bit++) {
+				if (bits & (1u << bit))
+					o.u32(bit + 1);
+			}
+			n++;
+		}
+		o.setU32(at, n);
+	}
+	if (objects) {
+		o.u8(0); // no room objects in a lite dump
+	} else {
+		o.u8(1);
+		const uint32 at = o.size();
+		o.u32(0);
+		uint32 n = 0;
+		for (int i = 1; i < e._numLocalObjects; i++) {
+			const ObjectData &od = e._objs[i];
+			if (!od.obj_nr)
+				continue;
+			o.i32((int)od.obj_nr);
+			o.i32((int)od.state);
+			o.i32((int)od.parent);
+			o.i32((int)od.x_pos);
+			o.i32((int)od.y_pos);
+			o.i32((int)od.width);
+			o.i32((int)od.height);
+			o.i32(od.walk_x);
+			o.i32(od.walk_y);
+			if (names) {
+				o.u8(1);
+				// withoutAt(): the name with '@' padding dropped
+				Common::String t;
+				for (const byte *s = e.getObjOrActorName(od.obj_nr); s && *s; ++s) {
+					if (*s != '@')
+						t += (char)*s;
+				}
+				putText(o, (const byte *)t.c_str());
+			} else {
+				o.u8(0);
+			}
+			n++;
+		}
+		o.setU32(at, n);
+	}
+	{
+		const uint32 at = o.size();
+		o.u32(0);
+		uint32 n = 0;
+		for (int slot = 1; slot < e._numVerbs; slot++) {
+			if (!verbVisible(slot))
+				continue;
+			const VerbSlot &v = e._verbs[slot];
+			o.i32(slot);
+			o.i32((int)v.verbid);
+			o.i32((int)v.curmode);
+			o.i32((int)v.saveid);
+			o.i32((int)v.type);
+			o.i32((int)v.key);
+			o.i32((int)v.curRect.left);
+			o.i32((int)v.curRect.top);
+			if (names) {
+				Common::String text; // "" for image verbs (verbJson)
+				verbText(slot, true, text);
+				o.u8(1);
+				putText(o, (const byte *)text.c_str());
+			} else {
+				o.u8(0);
+			}
+			n++;
+		}
+		o.setU32(at, n);
+	}
+	{
+		const uint32 at = o.size();
+		o.u32(0);
+		uint32 n = 0;
+		for (int i = 0; i < NUM_SCRIPT_SLOT; i++) {
+			const ScriptSlot &ss = e.vm.slot[i];
+			if (ss.status == ssDead)
+				continue;
+			o.i32(i);
+			o.i32((int)ss.number);
+			o.i32((int)ss.where);
+			o.i32((int)ss.status);
+			o.u64((uint64)ss.offs);
+			o.i64(scriptCode(i, ss.offs));
+			o.i32((int)ss.freezeCount);
+			o.i32((int)ss.delay);
+			o.i32((int)ss.cutsceneOverride);
+			if (_dumpLocals) {
+				o.u8(1);
+				o.u32(NUM_SCRIPT_LOCAL);
+				for (int k = 0; k < NUM_SCRIPT_LOCAL; k++)
+					o.i32((int)e.vm.localvar[i][k]);
+				o.u8(1);
+				o.b(ss.freezeResistant);
+				o.u8(1);
+				o.b(ss.recursive);
+			} else {
+				o.u8(0);
+				o.u8(0);
+				o.u8(0);
+			}
+			n++;
+		}
+		o.setU32(at, n);
+	}
+	{
+		const int depth = e.vm.cutSceneStackPointer;
+		o.i32(depth);
+		const uint32 at = o.size();
+		o.u32(0);
+		uint32 n = 0;
+		for (int level = 0; level <= depth && level < kMaxCutsceneNum; level++) {
+			const uint32 ptr = e.vm.cutScenePtr[level];
+			const int slot = e.vm.cutSceneScript[level];
+			o.i32(level);
+			if (_dumpLocals) {
+				o.u8(1);
+				o.i32((int)e.vm.cutSceneData[level]);
+			} else {
+				o.u8(0);
+			}
+			if (!ptr || slot >= NUM_SCRIPT_SLOT) {
+				o.u8(0);
+			} else {
+				const ScriptSlot &ss = e.vm.slot[slot];
+				o.u8(1);
+				o.i32(slot);
+				o.i32((int)ss.number);
+				o.i32((int)ss.where);
+				o.i32((int)ss.status);
+				o.u64((uint64)ptr);
+				o.i64(scriptCode(slot, ptr));
+				o.b(overrideStale(level));
+			}
+			n++;
+		}
+		o.setU32(at, n);
+	}
+	{
+		const uint32 at = o.size();
+		o.u32(0);
+		uint32 n = 0;
+		for (int i = 1; i < e._numActors; i++) {
+			const Actor *a = e._actors[i];
+			if (!a || !a->isInCurrentRoom() || !a->_visible)
+				continue;
+			o.i32(i);
+			o.i32((int)a->getRealPos().x);
+			o.i32((int)a->getRealPos().y);
+			o.i32((int)a->getElevation());
+			o.i32((int)a->_moving);
+			n++;
+		}
+		o.setU32(at, n);
+	}
+	if (exact && !objects) {
+		o.u8(1);
+		wireExact(o);
+	} else {
+		o.u8(0);
+	}
+}
+
+namespace {
+
+// fmi-core ExactVal: Int 0, Bool 1, Text 2, List 3, Map 4, Null 5. Map and the top object are (key, value) pairs.
+void xKey(SpeedrunBytes &o, const char *k) {
+	o.str(k);
+}
+void xInt(SpeedrunBytes &o, int64 v) {
+	o.u8(0);
+	o.i64(v);
+}
+void xBool(SpeedrunBytes &o, bool v) {
+	o.u8(1);
+	o.b(v);
+}
+void xText(SpeedrunBytes &o, const Common::String &s) {
+	o.u8(2);
+	o.str(s.c_str(), s.size());
+}
+void xInts(SpeedrunBytes &o, const int *v, uint32 n) {
+	o.u8(3);
+	o.u32(n);
+	for (uint32 i = 0; i < n; i++)
+		xInt(o, v[i]);
+}
+
+} // End of anonymous namespace
+
+void SpeedrunBridge::wireExact(SpeedrunBytes &o) const {
+	// exactJson(), field for field and in its order, with the JSON text's types (its int casts, %.17g text, the
+	// screens' digest as hex text).
+	const ScummEngine &e = *_vm;
+	const uint32 at = o.size();
+	o.u32(0);
+	uint32 n = 0;
+	xKey(o, "rng"), xInt(o, (int64)(uint64)e._rnd.getSeed()), n++;
+	xKey(o, "qf"), xInt(o, (int64)_quarterFrames), n++;
+	xKey(o, "qf0"), xInt(o, (int64)_qf0), n++;
+	xKey(o, "tick0"), xInt(o, (int64)_tick0), n++;
+	xKey(o, "seg"), xBool(o, _segmentStarted), n++;
+	xKey(o, "input"), xInt(o, (int64)(uint)_inputIndex), n++;
+	{
+		const int v[2] = {(int)_rawMouseX, (int)_rawMouseY};
+		xKey(o, "raw_mouse"), xInts(o, v, 2), n++;
+	}
+	{
+		const int v[2] = {(int)e._mouse.x, (int)e._mouse.y};
+		xKey(o, "mouse"), xInts(o, v, 2), n++;
+	}
+	{
+		const int v[2] = {(int)e._virtualMouse.x, (int)e._virtualMouse.y};
+		xKey(o, "vmouse"), xInts(o, v, 2), n++;
+	}
+	{
+		const int v[3] = {(int)e._leftBtnPressed, (int)e._rightBtnPressed, (int)e._mouseAndKeyboardStat};
+		xKey(o, "buttons"), xInts(o, v, 3), n++;
+	}
+	xKey(o, "audio_pumped"), xInt(o, (int64)_audioPumped), n++;
+	xKey(o, "audio_pending"), xInt(o, (int64)_audioPending), n++;
+	xKey(o, "audio_owed"), xText(o, Common::String::format("%.17g", _audioOwed)), n++;
+	const Sound *snd = e._sound;
+	if (snd) {
+		if (snd->_soundCD) {
+			const SoundCD *cd = snd->_soundCD;
+			const AudioCDManager::Status st = g_system->getAudioCDManager()->getStatus();
+			xKey(o, "cd");
+			o.u8(4);
+			o.u32(6);
+			xKey(o, "timer"), xInt(o, (int64)(uint64)cd->_cdMusicTimer);
+			xKey(o, "timer_mod"), xInt(o, (int64)(uint64)cd->_cdMusicTimerMod);
+			xKey(o, "music_timer"), xInt(o, (int64)cd->getMusicTimer());
+			xKey(o, "sound"), xInt(o, (int64)(int)cd->_currentCDSound);
+			xKey(o, "poll"), xInt(o, (int64)snd->pollCD());
+			const int v[7] = {(int)st.playing, st.track, st.start, st.duration, st.numLoops, st.volume, st.balance};
+			xKey(o, "status"), xInts(o, v, 7);
+			n++;
+		}
+		xKey(o, "speech_timer"), xInt(o, (int64)(uint64)snd->_speechTimerMod), n++;
+		xKey(o, "sounds");
+		{
+			o.u8(3);
+			const uint32 at2 = o.size();
+			o.u32(0);
+			uint32 k = 0;
+			for (int s = 1; s < e._numSounds; s++) {
+				const int status = snd->isSoundRunning(s);
+				if (status) {
+					const int v[2] = {s, status};
+					xInts(o, v, 2);
+					k++;
+				}
+			}
+			o.setU32(at2, k);
+		}
+		n++;
+		xKey(o, "sound_queue");
+		{
+			o.u8(3);
+			const uint32 at2 = o.size();
+			o.u32(0);
+			uint32 k = 0;
+			for (int i = 0; i < snd->_soundQueuePos && i < (int)ARRAYSIZE(snd->_soundQueue); i++) {
+				const int v[2] = {(int)snd->_soundQueue[i].sound, (int)snd->_soundQueue[i].offset};
+				xInts(o, v, 2);
+				k++;
+			}
+			o.setU32(at2, k);
+		}
+		n++;
+		xKey(o, "midi_queue");
+		{
+			o.u8(3);
+			const uint32 at2 = o.size();
+			o.u32(0);
+			uint32 k = 0;
+			for (int i = 0; i < snd->_midiQueuePos && i < (int)ARRAYSIZE(snd->_midiQueue); i++) {
+				xInt(o, (int)snd->_midiQueue[i]);
+				k++;
+			}
+			o.setU32(at2, k);
+		}
+		n++;
+	}
+	{
+		const CameraData &cam = e.camera;
+		const int v[13] = {(int)cam._cur.x, (int)cam._cur.y, (int)cam._dest.x, (int)cam._dest.y, (int)cam._accel.x,
+		                   (int)cam._accel.y, (int)cam._last.x, (int)cam._last.y, (int)cam._leftTrigger,
+		                   (int)cam._rightTrigger, (int)cam._follows, (int)cam._mode, (int)cam._movingToActor};
+		xKey(o, "camera"), xInts(o, v, 13), n++;
+	}
+	{
+		// The screens' digest: exactJson()'s text, taken from it so the two never differ.
+		const Common::String j = exactJson();
+		const char *p = strstr(j.c_str(), "\"screens\":\"");
+		Common::String hex;
+		if (p) {
+			p += strlen("\"screens\":\"");
+			const char *q = strchr(p, '"');
+			if (q)
+				hex = Common::String(p, q - p);
+		}
+		xKey(o, "screens"), xText(o, hex), n++;
+	}
+	o.setU32(at, n);
+}
+
+void SpeedrunBridge::wireBlock(SpeedrunBytes &o) const {
+	// F2, the state block (plan.md "Binary formats"): what facts_of reads, as flat arrays.
+	const ScummEngine &e = *_vm;
+	o.u32(kBlockMagic);
+	o.u32(kBlockVersion);
+	o.u64(_frames);
+	o.u64(_ticks);
+	o.u64((uint64)e._rnd.getSeed());
+	o.i32((int)e._currentRoom);
+	o.i32(e._scummVars[e.VAR_EGO]);
+	const int depth = e.vm.cutSceneStackPointer;
+	o.i32(depth);
+	o.u32(e._numVariables);
+	for (int i = 0; i < e._numVariables; i++)
+		o.i32(e._scummVars[i]);
+	o.u32(e._numBitVariables);
+	o.put(e._bitVars, (e._numBitVariables + 7) / 8);
+	const int nObj = e._numGlobalObjects;
+	o.u32(nObj);
+	o.put(e._objectOwnerTable, nObj);
+	o.put(e._objectStateTable, nObj);
+	for (int i = 0; i < nObj; i++)
+		o.u32(e._classData[i]);
+	const uint32 at = o.size();
+	o.u32(0);
+	uint32 n = 0;
+	for (int i = 0; i < NUM_SCRIPT_SLOT; i++) {
+		const ScriptSlot &ss = e.vm.slot[i];
+		if (ss.status == ssDead)
+			continue;
+		o.i32(i);
+		o.i32((int)ss.number);
+		o.i32((int)ss.where);
+		o.i32((int)ss.status);
+		o.i64(scriptCode(i, ss.offs));
+		o.i32((int)ss.freezeCount);
+		n++;
+	}
+	o.setU32(at, n);
+	// the top level's override: the last level the dump lists (levels 0..depth, below kMaxCutsceneNum)
+	const int level = MAX<int>(0, MIN<int>(depth, (int)kMaxCutsceneNum - 1));
+	const uint32 ptr = e.vm.cutScenePtr[level];
+	const int slot = (int)e.vm.cutSceneScript[level];
+	if (!ptr || slot >= NUM_SCRIPT_SLOT) {
+		o.u8(0);
+	} else {
+		const ScriptSlot &ss = e.vm.slot[slot];
+		o.u8(1);
+		o.i32((int)ss.where);
+		o.i32((int)ss.number);
+		o.i64(scriptCode(slot, ptr));
+		o.b(overrideStale(level));
+	}
+	const uint32 at2 = o.size();
+	o.u32(0);
+	uint32 nv = 0;
+	for (int s = 1; s < e._numVerbs; s++) {
+		if (verbVisible(s)) {
+			o.i32((int)e._verbs[s].verbid);
+			nv++;
+		}
+	}
+	o.setU32(at2, nv);
+}
+
+void SpeedrunBridge::wireBlockOrDelta(SpeedrunBytes &o) {
+	_wireNew.clear();
+	wireBlock(_wireNew);
+	if (_wireLast.size() > 0) {
+		const uint32 at = o.size();
+		o.u8(1);
+		putDelta(o, _wireLast, _wireNew);
+		if (o.size() - at - 1 > _wireNew.size() + 4) {
+			o.truncate(at); // the delta is larger: send the block whole
+			o.u8(0);
+			o.str((const char *)_wireNew.data(), _wireNew.size());
+		}
+	} else {
+		o.u8(0);
+		o.str((const char *)_wireNew.data(), _wireNew.size());
+	}
+	_wireLast.swap(_wireNew);
+}
+
+void SpeedrunBridge::wireRuns(SpeedrunBytes &o) {
+	// fmi-core RunsReply; clears the buffer, as runsJson()
+	o.u32(_runRows.size());
+	for (uint i = 0; i < _runRows.size(); i++) {
+		const int64 *v = _runRows[i].v;
+		o.u64((uint64)v[0]);  // frame
+		o.b(v[1] != 0);       // after
+		o.u64((uint64)v[2]);  // seq
+		for (int k = 3; k < 8; k++)
+			o.i32((int32)v[k]); // depth, slot, where, number, room
+		o.i64(v[8]);          // code0
+		o.i64(v[9]);          // code1
+		for (int k = 10; k < 13; k++)
+			o.i32((int32)v[k]); // status, frozen, delay
+		o.u64((uint64)v[13]); // ops
+	}
+	o.u64(_runsDropped);
+	o.u64(_slotViolations);
+	o.u64(_frames);
+	_runRows.clear();
+	_runsDropped = 0;
+}
+
+void SpeedrunBridge::wireExplainLog(SpeedrunBytes &o) {
+	// fmi-core ExplainReply; clears the log, as explainJson()
+	o.u32(_explainRows.size());
+	for (uint i = 0; i < _explainRows.size(); i++) {
+		const ExplainRow &r = _explainRows[i];
+		const int64 *v = r.v;
+		o.u8(r.kind);
+		switch (r.kind) {
+		case 0: // Begin {seq, frame, after, slot, where, number, room, code0}
+			o.u64((uint64)v[0]);
+			o.u64((uint64)v[1]);
+			o.b(v[2] != 0);
+			for (int k = 3; k < 7; k++)
+				o.i32((int32)v[k]);
+			o.i64(v[7]);
+			break;
+		case 1: // Op {seq, code, opcode}
+			o.u64((uint64)v[0]);
+			o.i64(v[1]);
+			o.u8((uint8)v[2]);
+			break;
+		case 2: // Read {seq, var, value}
+		case 3: // Write
+			o.u64((uint64)v[0]);
+			o.u32((uint32)v[1]);
+			o.i32((int32)v[2]);
+			break;
+		default: // End {seq, code1, status, frozen, delay}
+			o.u64((uint64)v[0]);
+			o.i64(v[1]);
+			o.i32((int32)v[2]);
+			o.i32((int32)v[3]);
+			o.i32((int32)v[4]);
+			break;
+		}
+	}
+	o.u64(_explainDropped);
+	o.u64(_slotViolations);
+	_explainRows.clear();
+	_explainDropped = 0;
+}
+
+#pragma mark - Decoders
+
+bool SpeedrunBridge::wireConditions(SpeedrunReader &in, SpeedrunConditions &out, Common::String &error) const {
+	// fmi-core Vec<Cond>, checked as parseCondition() checks its JSON forms
+	out.clear();
+	const uint32 n = in.count(15);
+	for (uint32 i = 0; i < n && in.ok(); i++) {
+		SpeedrunCondition c;
+		const uint8 kind = in.u8();
+		c.subject = in.i32();
+		const uint8 op = in.u8();
+		c.value = in.i32();
+		const uint32 nv = in.count(4);
+		for (uint32 k = 0; k < nv && in.ok(); k++)
+			c.values.push_back(in.i32());
+		c.negate = in.b();
+		if (!in.ok())
+			break;
+		if (kind > SpeedrunCondition::kScript || op > SpeedrunCondition::kIn) {
+			error = Common::String::format("condition %u: unknown kind or op", i);
+			return false;
+		}
+		c.kind = (SpeedrunCondition::Kind)kind;
+		c.op = (SpeedrunCondition::Op)op;
+		const bool compare = c.kind == SpeedrunCondition::kVar || c.kind == SpeedrunCondition::kBit ||
+		                     c.kind == SpeedrunCondition::kOwner || c.kind == SpeedrunCondition::kState ||
+		                     c.kind == SpeedrunCondition::kActorRoom || c.kind == SpeedrunCondition::kActorMoving;
+		const bool actorPos = c.kind == SpeedrunCondition::kActorX || c.kind == SpeedrunCondition::kActorY;
+		bool ok = true;
+		if (c.op == SpeedrunCondition::kIn)
+			ok = compare && !c.values.empty();
+		else if (!c.values.empty())
+			ok = false;
+		if (ok && c.op != SpeedrunCondition::kEq && !compare && !actorPos)
+			ok = c.op == SpeedrunCondition::kIn;
+		if (ok && c.op == SpeedrunCondition::kEq &&
+		    (c.kind == SpeedrunCondition::kActorRoom || c.kind == SpeedrunCondition::kActorMoving) &&
+		    (c.subject < 1 || c.subject > kMaxActor))
+			ok = false;
+		if (ok && actorPos && (c.subject < 1 || c.subject > kMaxActor || c.op == SpeedrunCondition::kIn))
+			ok = false;
+		if (ok && c.kind == SpeedrunCondition::kClass && (c.op != SpeedrunCondition::kEq || c.value < 1 || c.value > 32))
+			ok = false;
+		if (!ok) {
+			error = Common::String::format("condition %u: not a form the JSON protocol takes", i);
+			return false;
+		}
+		out.push_back(c);
+	}
+	if (!in.ok()) {
+		error = "bad conditions";
+		return false;
+	}
+	return true;
+}
+
+#pragma mark - The loop
+
+void SpeedrunBridge::wireLoop(const char *reason) {
+	_stopFrame = 0;
+	_stopMaxFrame = 0;
+	_stopOnControl = false;
+	_stopOnIdle = false;
+	_stopOnMenu = false;
+	_stopUntil.clear();
+	_stopUntilAny.clear();
+	wireBegin(_wireStep ? kRStepReply : kRStop);
+	wireStatus(_wireOut, reason, false);
+	if (_wireStep) {
+		wireBlockOrDelta(_wireOut);
+		if (_wireStepRuns) {
+			_wireOut.u8(1);
+			wireRuns(_wireOut);
+		} else {
+			_wireOut.u8(0);
+		}
+		if (_wireStepExplain) {
+			_wireOut.u8(1);
+			wireExplainLog(_wireOut);
+		} else {
+			_wireOut.u8(0);
+		}
+		_wireStep = false;
+	}
+	wireFlush();
+
+	for (;;) {
+		uint8 type = 0;
+		uint32 len = 0;
+		if (!wireRead(type, len))
+			_exit(0); // controller closed the connection
+		// the payload is copied: a reply may need _wireIn's space
+		SpeedrunBytes payload;
+		payload.put(_wireIn.data() + 5, len);
+		_wireIn.consume(5 + len);
+		SpeedrunReader in(payload.data(), payload.size());
+		Common::String error;
+		bool resume = false;
+
+		switch (type) {
+		case kWRun: {
+			// fmi-core RunSpec: frame, max_frame, until, until_any, control, idle, menu
+			if (in.u8())
+				_stopFrame = in.u64();
+			if (in.u8())
+				_stopMaxFrame = in.u64();
+			if (!wireConditions(in, _stopUntil, error))
+				error = "until: " + error;
+			const uint32 groups = error.empty() ? in.count(4) : 0;
+			for (uint32 g = 0; g < groups && error.empty(); g++) {
+				SpeedrunConditions conds;
+				if (!wireConditions(in, conds, error))
+					error = "until_any: " + error;
+				else
+					_stopUntilAny.push_back(conds);
+			}
+			_stopOnControl = in.b();
+			_stopOnIdle = in.b();
+			_stopOnMenu = in.b();
+			if (error.empty() && !in.done())
+				error = "run: bad payload";
+			if (error.empty() && !_stopFrame && !_stopMaxFrame && !_stopOnControl && !_stopOnIdle && !_stopOnMenu &&
+			    _stopUntil.empty() && _stopUntilAny.empty())
+				error = "run needs frame, max_frame, control, idle, until or until_any";
+			if (error.empty() && _stopFrame && _stopFrame <= _frames)
+				error = Common::String::format("frame %llu is not after the current frame %llu",
+				                               (unsigned long long)_stopFrame, (unsigned long long)_frames);
+			if (!error.empty()) {
+				_stopFrame = _stopMaxFrame = 0;
+				_stopOnControl = _stopOnIdle = _stopOnMenu = false;
+				_stopUntil.clear();
+				_stopUntilAny.clear();
+			}
+			resume = error.empty();
+			break;
+		}
+		case kWStep: {
+			const uint32 frames = in.u32();
+			_wireStepRuns = in.b();
+			_wireStepExplain = in.b();
+			if (!in.done())
+				error = "step: bad payload";
+			else if (frames < 1)
+				error = "step needs at least one frame";
+			if (error.empty()) {
+				_stopFrame = _frames + frames;
+				_wireStep = true;
+				resume = true;
+			}
+			break;
+		}
+		case kWForkEach: {
+			const uint32 n = in.u32();
+			if (!in.done() || n < 1 || n > 64)
+				error = "fork_each needs a number of frames in 1..64";
+			else
+				_forkEachLeft = n;
+			resume = error.empty();
+			break;
+		}
+		case kWInputs: {
+			// fmi-core Vec<Event>: frame, then Input (Click 0, RClick 1, Move 2, Key 3, Skips 4), checked as
+			// parseSpeedrunInputs() and the "inputs" command check theirs
+			Common::Array<SpeedrunInput> parsed;
+			const uint32 n = in.count(9);
+			uint64 lastFrame = 0;
+			for (uint32 i = 0; i < n && in.ok() && error.empty(); i++) {
+				SpeedrunInput ev;
+				ev.frame = in.u64();
+				const uint8 kind = in.u8();
+				bool ok = ev.frame > 0;
+				switch (kind) {
+				case 0:
+				case 1:
+				case 2:
+					ev.kind = kind == 0 ? SpeedrunInput::kClick : kind == 1 ? SpeedrunInput::kRightClick : SpeedrunInput::kMove;
+					ev.x = in.i32();
+					ev.y = in.i32();
+					ok = ok && ev.x >= 0 && ev.y >= 0 && ev.x < 0x10000 && ev.y < 0x10000;
+					break;
+				case 3:
+					ev.kind = SpeedrunInput::kKey;
+					ev.keyName = in.str();
+					ok = ok && speedrunKeyName(ev.keyName, ev.key);
+					break;
+				case 4: {
+					ev.kind = SpeedrunInput::kSkips;
+					ev.skipText = in.b();
+					ev.skipCutscenes = in.b();
+					if (in.u8()) {
+						const uint32 ns = in.count(4);
+						for (uint32 k = 0; k < ns && in.ok(); k++)
+							ev.spare.push_back(in.i32());
+					}
+					break;
+				}
+				default:
+					ok = false;
+					break;
+				}
+				if (!in.ok())
+					break;
+				if (!ok)
+					error = Common::String::format("events: event %u: expected frame > 0, and a click/rclick/move in "
+					                               "range, a key name or skips", i);
+				else if (ev.frame < lastFrame)
+					error = Common::String::format("events: event %u: frame %llu comes before frame %llu", i,
+					                               (unsigned long long)ev.frame, (unsigned long long)lastFrame);
+				lastFrame = ev.frame;
+				parsed.push_back(ev);
+			}
+			if (error.empty() && !in.done())
+				error = "inputs: bad payload";
+			if (error.empty()) {
+				const uint64 last = _inputs.empty() ? 0 : _inputs.back().frame;
+				for (const SpeedrunInput &ev : parsed) {
+					if (ev.frame <= _frames || ev.frame < last) {
+						error = Common::String::format("event frame %llu must be after frame %llu and not before %llu",
+						                               (unsigned long long)ev.frame, (unsigned long long)_frames,
+						                               (unsigned long long)last);
+						break;
+					}
+				}
+			}
+			if (error.empty()) {
+				for (const SpeedrunInput &ev : parsed)
+					_inputs.push_back(ev);
+				wireBegin(kROk);
+				wireFlush();
+			}
+			break;
+		}
+		case kWFork: {
+			if (!in.done()) {
+				error = "fork: bad payload";
+				break;
+			}
+			// as the JSON "fork": the data file is closed so that each process reopens its own
+			_vm->closeRoom();
+			const pid_t pid = fork();
+			if (pid < 0) {
+				error = Common::String::format("fork failed: %s", strerror(errno));
+			} else if (pid == 0) {
+				_branchChild = true;
+				close(_controlFd);
+				_controlFd = -1;
+				_trace.close();
+				if (_frameLog)
+					_frameFile.close();
+				_frameLog = false;
+				if (!controlConnect())
+					_exit(4);
+				wireBegin(kRStop);
+				wireStatus(_wireOut, "forked", false);
+				wireFlush();
+			} else {
+				wireBegin(kRForked);
+				_wireOut.u32((uint32)pid);
+				wireFlush();
+			}
+			break;
+		}
+		case kWObs:
+		case kWStateJson: {
+			// fmi-core ObsReq: objects (Option<Vec<u32>>), names, exact
+			Common::Array<int> objects;
+			bool lite = false;
+			if (in.u8()) {
+				lite = true;
+				const uint32 n = in.count(4);
+				for (uint32 i = 0; i < n && in.ok(); i++)
+					objects.push_back((int)in.u32());
+			}
+			const bool names = in.b();
+			const bool exact = in.b();
+			if (!in.done()) {
+				error = "obs: bad payload";
+				break;
+			}
+			if (type == kWObs) {
+				wireBegin(kRObs);
+				wireObs(_wireOut, lite ? &objects : nullptr, names, exact);
+			} else {
+				wireBegin(kRJson);
+				const Common::String j = lite ? stateLiteJson(objects) : stateJson(_dumpExact || exact);
+				_wireOut.str(j.c_str(), j.size());
+			}
+			wireFlush();
+			break;
+		}
+		case kWState: {
+			if (!in.done()) {
+				error = "state: bad payload";
+				break;
+			}
+			_wireNew.clear();
+			wireBlock(_wireNew);
+			wireBegin(kRState);
+			_wireOut.put(_wireNew.data(), _wireNew.size());
+			_wireLast.swap(_wireNew);
+			wireFlush();
+			break;
+		}
+		case kWHolds: {
+			SpeedrunConditions conds;
+			if (!wireConditions(in, conds, error) || !in.done()) {
+				error = "holds: " + (error.empty() ? Common::String("bad payload") : error);
+				break;
+			}
+			wireBegin(kRHolds);
+			_wireOut.b(allHold(conds));
+			wireFlush();
+			break;
+		}
+		case kWAt: {
+			const int x = in.i32(), y = in.i32();
+			if (!in.done()) {
+				error = "at needs integer x and y";
+				break;
+			}
+			VirtScreen *vs = _vm->findVirtScreen(y);
+			wireBegin(kRAt);
+			_wireOut.i32(x);
+			_wireOut.i32(y);
+			_wireOut.i32(vs ? (int)vs->number : -1);
+			if (vs && vs->number == kMainVirtScreen) {
+				const int virtX = x + vs->xstart, virtY = y - vs->topline;
+				_wireOut.u8(1);
+				_wireOut.i32(virtX);
+				_wireOut.i32(virtY);
+				_wireOut.i32(_vm->findObject(virtX, virtY));
+				_wireOut.i32(_vm->getActorFromPos(virtX, virtY));
+			} else {
+				_wireOut.u8(0);
+			}
+			_wireOut.i32(_vm->findVerbAtPos(x, y));
+			wireFlush();
+			break;
+		}
+		case kWSetRng: {
+			const uint32 state = in.u32();
+			if (!in.done() || state == 0) {
+				error = "set_rng needs a state in 1..2^32-1";
+				break;
+			}
+			_vm->_rnd.setSeed(state);
+			writeRecord(record("rng_set").add("state", (uint64)_vm->_rnd.getSeed()));
+			wireBegin(kROk);
+			wireFlush();
+			break;
+		}
+		case kWSegment: {
+			const bool on = in.b();
+			if (!in.done()) {
+				error = "segment: bad payload";
+				break;
+			}
+			_segment = on;
+			wireBegin(kROk);
+			wireFlush();
+			break;
+		}
+		case kWRuns: {
+			if (!in.done()) {
+				error = "runs: bad payload";
+				break;
+			}
+			wireBegin(kRRuns);
+			wireRuns(_wireOut);
+			wireFlush();
+			break;
+		}
+		case kWExplain: {
+			// Option<ExplainArm>: None disarms, as {"off": true}
+			if (!in.u8()) {
+				if (!in.done()) {
+					error = "explain: bad payload";
+					break;
+				}
+				_explainArmed = false;
+				_explainUnits.clear();
+			} else {
+				const uint64 from = in.u64(), to = in.u64();
+				Common::Array<int32> units;
+				const uint32 n = in.count(8);
+				for (uint32 i = 0; i < n && in.ok(); i++) {
+					units.push_back(in.i32());
+					units.push_back(in.i32());
+				}
+				if (!in.done() || to < from || from > (uint64)0x7FFFFFFFFFFFFFFFLL) {
+					error = "explain needs integer frames from <= to";
+					break;
+				}
+				_explainFrom = from;
+				_explainTo = to;
+				_explainUnits = units;
+				_explainArmed = true;
+			}
+			wireBegin(kROk);
+			wireFlush();
+			break;
+		}
+		case kWExplainLog: {
+			if (!in.done()) {
+				error = "explain_log: bad payload";
+				break;
+			}
+			wireBegin(kRExplain);
+			wireExplainLog(_wireOut);
+			wireFlush();
+			break;
+		}
+		case kWQuit:
+			_exit(0);
+			break;
+		default:
+			error = Common::String::format("unknown message type 0x%02x", (uint)type);
+			break;
+		}
+		if (!error.empty()) {
+			wireBegin(kRError);
+			_wireOut.str(error.c_str(), error.size());
+			wireFlush();
+			continue;
+		}
+		if (resume)
+			return;
+	}
+}
+
+} // End of namespace Scumm
