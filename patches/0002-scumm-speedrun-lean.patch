+
+// Controller to engine
+enum : uint8 {
+	kWRun = 0x81,
+	kWInputs = 0x82,
+	kWFork = 0x83,
+	kWForkEach = 0x84,
+	kWObs = 0x85,
+	kWState = 0x86,
+	kWHolds = 0x87,
+	kWAt = 0x88,
+	kWSetRng = 0x89,
+	kWSegment = 0x8A,
+	kWRuns = 0x8B,
+	kWExplain = 0x8C,
+	kWExplainLog = 0x8D,
+	kWStateJson = 0x8E,
+	kWQuit = 0x8F,
+	kWStep = 0x90
+};
+
+// Engine to controller
+enum : uint8 {
+	kRHello = 0x01,
+	kRStop = 0x02,
+	kREnd = 0x03,
+	kRForked = 0x04,
+	kRObs = 0x05,
+	kRState = 0x06,
+	kRHolds = 0x07,
+	kRAt = 0x08,
+	kRRuns = 0x09,
+	kRExplain = 0x0A,
+	kROk = 0x0B,
+	kRError = 0x0C,
+	kRJson = 0x0D,
+	kRStepReply = 0x0E
+};
+
+const uint32 kBlockMagic = 0x31534D46; // "FMS1"
+const uint32 kBlockVersion = 1;
+const uint32 kMaxMessage = 1u << 26;    // a payload over 64 MB is refused (the controller is broken)
+const int kMaxActor = 12;               // speedrun_conditions.cpp
+
+// A game text (names) as the JSON dump's string decodes: bytes 0x7F and up are U+007F..U+00FF (jsonString's \u00XX),
+// written as UTF-8.
+void putText(SpeedrunBytes &o, const byte *s) {
+	const uint32 at = o.size();
+	o.u32(0);
+	uint32 n = 0;
+	for (; s && *s; ++s) {
+		const byte c = *s;
+		if (c < 0x80) {
+			o.u8(c);
+			n++;
+		} else {
+			o.u8(0xC0 | (c >> 6));
+			o.u8(0x80 | (c & 0x3F));
+			n += 2;
+		}
+	}
+	o.setU32(at, n);
+}
+
+// The byte runs where @p cur differs from @p old: u32 new length, u32 chunk count, then (u32 offset, u32 length,
+// bytes) per chunk. Bytes past the old length always form a chunk. The receiver takes the old block cut or padded to
+// the new length and writes the chunks over it.
+void putDelta(SpeedrunBytes &o, const SpeedrunBytes &old, const SpeedrunBytes &cur) {
+	const uint32 n = cur.size(), m = MIN(old.size(), n);
+	const byte *a = old.data(), *b = cur.data();
+	o.u32(n);
+	const uint32 countAt = o.size();
+	o.u32(0);
+	uint32 chunks = 0, i = 0;
+	while (i < m) {
+		// equal 8-byte words first
+		while (i + 8 <= m && READ_UINT64(a + i) == READ_UINT64(b + i))
+			i += 8;
+		if (i >= m)
+			break;
+		if (a[i] == b[i]) {
+			i++;
+			continue;
+		}
+		const uint32 start = i;
+		uint32 last = i;
+		for (i++; i < m; i++) {
+			if (a[i] != b[i])
+				last = i;
+			else if (i - last > 16)
+				break;
+		}
+		o.u32(start);
+		o.u32(last + 1 - start);
+		o.put(b + start, last + 1 - start);
+		chunks++;
+		i = last + 1;
+	}
+	if (n > m) {
+		o.u32(m);
+		o.u32(n - m);
+		o.put(b + m, n - m);
+		chunks++;
+	}
+	o.setU32(countAt, chunks);
+}
+
+} // End of anonymous namespace
