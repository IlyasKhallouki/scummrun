+	void put(const void *p, uint32 n) { if (n) memcpy(grow(n), p, n); }
+	void u8(uint8 v) { *grow(1) = v; }
+	void b(bool v) { u8(v ? 1 : 0); }
+	void u32(uint32 v) { WRITE_LE_UINT32(grow(4), v); }
+	void i32(int32 v) { u32((uint32)v); }
+	void u64(uint64 v) { WRITE_LE_UINT64(grow(8), v); }
+	void i64(int64 v) { u64((uint64)v); }
