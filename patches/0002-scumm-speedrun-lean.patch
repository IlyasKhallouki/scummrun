+/** E011 (patch 0002): little-endian readers over one binary message's payload; any read past its end clears ok. */
+class SpeedrunReader {
+public:
+	SpeedrunReader(const byte *p, uint32 n) : _p(p), _end(p + n) {}
+	bool ok() const { return _ok; }
+	bool done() const { return _ok && _p == _end; }
+	uint8 u8() { return need(1) ? *_p++ : 0; }
+	bool b() {
+		const uint8 v = u8();
+		if (v > 1)
+			_ok = false;
+		return v == 1;
+	}
+	uint32 u32() {
+		if (!need(4))
+			return 0;
+		const uint32 v = READ_LE_UINT32(_p);
+		_p += 4;
+		return v;
+	}
+	int32 i32() { return (int32)u32(); }
+	uint64 u64() {
+		if (!need(8))
+			return 0;
+		const uint64 v = READ_LE_UINT64(_p);
+		_p += 8;
+		return v;
+	}
+	int64 i64() { return (int64)u64(); }
+	/** A u32 count no greater than the bytes left divided by @p minItem (a malformed count fails here). */
+	uint32 count(uint32 minItem) {
+		const uint32 n = u32();
+		if (_ok && minItem && (uint64)n * minItem > (uint64)(_end - _p))
+			_ok = false;
+		return _ok ? n : 0;
+	}
+	Common::String str() {
+		const uint32 n = count(1);
+		if (!_ok)
+			return Common::String();
+		Common::String s((const char *)_p, n);
+		_p += n;
+		return s;
+	}
+
+private:
+	bool need(uint32 n) {
+		if (!_ok || (uint32)(_end - _p) < n)
+			_ok = false;
+		return _ok;
+	}
+	const byte *_p, *_end;
+	bool _ok = true;
+};
 
