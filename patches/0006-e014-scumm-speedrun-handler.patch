+Common::String SpeedrunBridge::scriptSite() const {
+	// E014: the running slot (_currentScript) and its code position: _scriptPointer is past the opcode and its one
+	// sub-op byte when o5_systemOps calls restart() or quitGame(), so the opcode is 2 bytes back. The offset counts
+	// from the script's first opcode (scriptCode(), the [XXXX] of the decompiled files).
+	const ScummEngine &e = *_vm;
+	const int i = e._currentScript;
+	if (i == 0xFF || i >= NUM_SCRIPT_SLOT || e.vm.slot[i].status == ssDead || !e._scriptPointer || !e._scriptOrgPointer)
+		return Common::String();
+	const ScriptSlot &ss = e.vm.slot[i];
+	const int64 code = scriptCode(i, (uint32)(e._scriptPointer - e._scriptOrgPointer));
+	const int room = (ss.where == WIO_LOCAL || ss.where == WIO_ROOM || ss.where == WIO_FLOBJECT) ? (int)e._roomResource : -1;
+	return Common::String::format("@%d:%d:%d:%04X", (int)ss.where, (int)ss.number, room, code >= 2 ? (uint)(code - 2) : 0xFFFFu);
+}
