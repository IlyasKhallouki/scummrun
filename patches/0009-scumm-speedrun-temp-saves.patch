+namespace {
+// E021 (patch 0009): a temporary save written to memory; its bytes go to the speedrun bridge when the save closes it
+class SpeedrunTempSaveStream : public Common::MemoryWriteStreamDynamic {
+public:
+	explicit SpeedrunTempSaveStream(SpeedrunBridge *bridge) : Common::MemoryWriteStreamDynamic(DisposeAfterUse::YES), _bridge(bridge) {}
+	~SpeedrunTempSaveStream() override { _bridge->setTempSave(getData(), (uint32)size()); }
+private:
+	SpeedrunBridge *_bridge;
+};
+} // End of anonymous namespace
+
 Common::SeekableReadStream *ScummEngine::openSaveFileForReading(int slot, bool compat, Common::String &fileName) {
 	fileName = makeSavegameName(slot, compat);
+	if (compat && _speedrun && _speedrun->tempSaves())
+		return _speedrun->tempSaveStream();
 	return _saveFileMan->openForLoading(fileName);
 }
 
 Common::SeekableWriteStream *ScummEngine::openSaveFileForWriting(int slot, bool compat, Common::String &fileName) {
 	fileName = makeSavegameName(slot, compat);
+	if (compat && _speedrun && _speedrun->tempSaves())
+		return new SpeedrunTempSaveStream(_speedrun);
 	return _saveFileMan->openForSaving(fileName);
 }
 
