+void SpeedrunBridge::setTempSave(const byte *data, uint32 size) {
+	_tempSave.resize(size);
+	if (size)
+		memcpy(_tempSave.data(), data, size);
+	_hasTempSave = true;
+}
+
+Common::SeekableReadStream *SpeedrunBridge::tempSaveStream() const {
+	if (!_hasTempSave)
+		return nullptr;
+	byte *copy = (byte *)malloc(MAX<uint32>(_tempSave.size(), 1));
+	if (_tempSave.size())
+		memcpy(copy, _tempSave.data(), _tempSave.size());
+	return new Common::MemoryReadStream(copy, _tempSave.size(), DisposeAfterUse::YES);
+}
