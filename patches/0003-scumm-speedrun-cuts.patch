+// E011 (patch 0003), the count-only mixer: copyConvert(), simpleConvert() and interpolateConvert() as they read their
+// stream and move their members, without the samples they would add into the output buffer. Each returns what its
+// conversion returns and leaves every member as it would (CUTS.md, section 1).
+template<bool inStereo, bool outStereo, bool reverseStereo>
+int RateConverter_Impl<inStereo, outStereo, reverseStereo>::copyCount(AudioStream &input, st_size_t numSamples) {
+	PRINT_OUTPUT_RATE;
+
+	const int step = inStereo ? 2 : 1;
+	st_size_t done = 0;
+
+	while (done < numSamples) {
+		// Check if we have to refill the buffer
+		if (_bufferSize == 0) {
+			_bufferPos = _buffer;
+			_bufferSize = input.readBuffer(_buffer, ARRAYSIZE(_buffer));
+
+			if (_bufferSize <= 0)
+				return done;
+		}
+
+		// copyConvert's loop takes one input frame per output frame and tests _bufferSize == 0 again only at the
+		// next output: k outputs before that test can succeed (all that are left when _bufferSize never reaches 0).
+		st_size_t k = numSamples - done;
+		if (_bufferSize > 0 && _bufferSize % step == 0 && (st_size_t)(_bufferSize / step) < k)
+			k = _bufferSize / step;
+		_bufferPos += k * step;
+		_bufferSize -= (int)(k * step);
+		done += k;
+	}
+
+	return done;
+}
+
+template<bool inStereo, bool outStereo, bool reverseStereo>
+int RateConverter_Impl<inStereo, outStereo, reverseStereo>::simpleCount(AudioStream &input, st_size_t numSamples) {
+	PRINT_OUTPUT_RATE;
+
+	// How much to increment _outPos by
+	frac_t outPos_inc = _inRate / _outRate;
+
+	const int step = inStereo ? 2 : 1;
+	st_size_t done = 0;
+
+	while (done < numSamples) {
+		// simpleConvert's output takes n = max(_outPos, 0) + 1 turns of its do-while, each one input frame, the
+		// last of them the frame it reads, and leaves _outPos at min(_outPos, 0) - 1 + outPos_inc. A turn refills
+		// only when it starts at _bufferSize == 0: an output whose n frames are all in the cache takes them at once.
+		if (_bufferSize > 0 && _bufferSize % step == 0) {
+			const frac_t n = (_outPos >= 0 ? _outPos : 0) + 1;
+			if (_bufferSize >= n * step) {
+				_bufferSize -= n * step;
+				_bufferPos += n * step;
+				_outPos = (_outPos >= 0 ? 0 : _outPos) - 1 + outPos_inc;
+				done++;
+				// From here every output takes outPos_inc frames (_outPos is outPos_inc - 1 >= 0): k at once.
+				if (_outPos == outPos_inc - 1 && outPos_inc > 0) {
+					st_size_t k = (st_size_t)(_bufferSize / (outPos_inc * step));
+					if (k > numSamples - done)
+						k = numSamples - done;
+					_bufferSize -= (int)(k * outPos_inc * step);
+					_bufferPos += k * outPos_inc * step;
+					done += k;
+				}
+				continue;
+			}
+		}
+
+		// Read enough input samples so that _outPos >= 0
+		do {
+			// Check if we have to refill the buffer
+			if (_bufferSize == 0) {
+				_bufferPos = _buffer;
+				_bufferSize = input.readBuffer(_buffer, ARRAYSIZE(_buffer));
+
+				if (_bufferSize <= 0)
+					return done;
+			}
+
+			_bufferSize -= (inStereo ? 2 : 1);
+			_outPos--;
+
+			if (_outPos >= 0) {
+				_bufferPos += (inStereo ? 2 : 1);
+			}
+		} while (_outPos >= 0);
+
+		// the input frame simpleConvert reads
+		_bufferPos += (inStereo ? 2 : 1);
+
+		// Increment output position
+		_outPos += outPos_inc;
+
+		done++;
+	}
+	return done;
+}
